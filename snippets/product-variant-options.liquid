{%- comment -%}
  Renders product variant options with icons from product metafields

  Required product metafields:
  custom.first_icon
  custom.second_icon
  custom.third_icon
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- for value in option.values -%}
  {%- liquid
    assign swatch_focal_point = null

    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point
    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    else
      assign swatch_value = null
    endif

    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif

    assign variant_icon_url = ''
    assign show_icon = false
    assign metafield_key = ''

    comment
      Icon mapping for one variant type with 3 options
      Option 1 = first_icon
      Option 2 = second_icon
      Option 3 = third_icon
    endcomment

    if option.position == 1
      case forloop.index0
        when 0
          assign metafield_key = 'first_icon'
        when 1
          assign metafield_key = 'second_icon'
        when 2
          assign metafield_key = 'third_icon'
      endcase
    endif

    if metafield_key != blank and product.metafields.custom[metafield_key] != blank
      assign variant_icon_url = product.metafields.custom[metafield_key] | image_url: width: 120
      assign show_icon = true
    endif
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 }}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}"
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {%- if picker_type == 'swatch' -%}

    {%- capture help_text -%}
      <span class="visually-hidden">{{ value | escape }}</span>
      {{ label_unavailable }}

      {%- if show_icon and variant_icon_url != blank -%}
        <span class="option-icon variant-icon">
          <img
            src="{{ variant_icon_url }}"
            alt="{{ value | escape }} icon"
            width="24"
            height="24"
            loading="lazy"
          >
        </span>
      {%- endif -%}
    {%- endcapture -%}

    {%
      render 'swatch-input',
      id: input_id,
      name: input_name,
      value: value | escape,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: value.selected,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: input_dataset
    %}

  {%- elsif picker_type == 'button' -%}

    <div class="variant-option-with-icons">
      <input
        type="radio"
        id="{{ input_id | strip }}"
        name="{{ input_name | escape | strip }}"
        value="{{ value | escape }}"
        form="{{ product_form_id }}"
        {% if value.selected %}checked{% endif %}
        {% if option_disabled %}class="disabled"{% endif %}
        {{ input_dataset }}
      >

      <label
        class="custom-varient variant-label-with-icons image-only-label {% unless show_icon %}no-icon{% endunless %}"
        for="{{ input_id | strip }}"
      >
        <div class="variant-wrapper">
          

          {%- if show_icon and variant_icon_url != blank -%}
            <span class="image-box">
              <img
                src="{{ variant_icon_url }}"
                alt="{{ value | escape }} icon"
                width="60"
                height="60"
                loading="lazy"
              >
            </span>
          {%- endif -%}

          <span class="variant-name">{{ value }}</span>
        </div>

        {{ label_unavailable }}
      </label>
    </div>

  {%- elsif picker_type == 'dropdown' or picker_type == 'swatch_dropdown' -%}

    <option
      id="{{ input_id | strip }}"
      value="{{ value | escape }}"
      {% if value.selected %}selected="selected"{% endif %}
      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value }}"
        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point }}"
        {% endif %}
      {% endif %}
      {{ input_dataset }}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>

  {%- endif -%}

{%- endfor -%}

<style>
  {% comment %} .variant-option-with-icons {
    display: inline-flex;
    margin: 0 20px 20px 0;
  } {% endcomment %}

  .variant-option-with-icons input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .product-form__input--pill label.image-only-label {
    padding: 0 !important;
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    margin: 0 !important;
    cursor: pointer;
  }

  .variant-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .top-circle {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    background: #d9d9d9;
    transition: background 0.2s ease;
  }

  .image-box {
    width: 120px;
    height: 120px;
    border-radius: 5px;
    background: #f5f5f5;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .image-box img {
    width: 100px;
    height: 100px;
    object-fit: contain;
    display: block;
  }

  .variant-name {
    font-size: 13px;
    line-height: 1.2;
    text-align: center;
    width:65%;
  }

  input[type="radio"]:checked + label .image-box {
    border-color: #2f2a5a;
    background: #eef0ff;
  }

  input[type="radio"].disabled + label {
    opacity: 0.45;
    cursor: not-allowed;
  }

  @media screen and (max-width: 768px) {
    .product-form__input--pill {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .variant-option-with-icons {
      width: calc(33.333% - 8px);
      margin: 0 !important;
      justify-content: center;
    }

    .product-form__input--pill label.image-only-label {
      width: 100% !important;
      display: flex !important;
      justify-content: center;
      align-items: center;
    }

    .image-box {
      width: 70px;
      height: 70px;
    }

    .image-box img {
      width: 48px;
      height: 48px;
    }

    .variant-name {
      font-size: 11px;
    }
  }
</style>