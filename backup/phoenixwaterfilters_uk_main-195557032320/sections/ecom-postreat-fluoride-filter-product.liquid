 "en": {
 "textcontent_kwtdlvtxxy_html": "Our first-of-its-kind specialized fluoride filtration uses our proprietary FluoRid media to remove more than 95% of fluoride from your water, while retaining the nutrients your body needs.",
 "textcontent_onvvwdx31a_html": "*Fluoride removal cartridge for drinking water, compatible with all Gravity Systems. Must be used in conjunction with a primary Phoenix Gravity Smart <a href=\"\/products\/smart-carbon-cartridges\"><font color=\"#f1d14e\">Carbon Cartridges<\/font><\/a>, it\u2019s not a stand-alone.*",
 "textcontent_b6mb0j4dl8u_html": "Looking for the complete Phoenix Gravity System? <a href=\"\/products\/the-phoenix-gravity-water-filter\">Find it here.<\/a><a href=\"\/products\/the-phoenix-gravity-water-filter\"><\/a>",
