{% assign custom_id = section.settings.custom_anchor_id | default: section.id %}

<section
  id="{{ custom_id | handle }}"
  class="filtration-section"
  style="
    --desktop-cols: {{ section.settings.desktop_columns }};
    --mobile-cols: {{ section.settings.mobile_columns }};
    --card-gap: {{ section.settings.card_gap }}px;
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_lr }}px {{ section.settings.padding_bottom }}px;
  "
>

  <div class="page-width gr-d">


  {% if section.settings.heading1 != blank %}
      <h1 class="filtration-heading">
        {{ section.settings.heading1 }}
      </h1>
    {% endif %}


    {% if section.settings.heading != blank %}
      <h2 class="filtration-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div
      class="filtration-grid"
      style="gap: {{ section.settings.card_gap }}px;"
    >
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product %}
          <div
            class="filtration-card"
            style="
              background: {{ section.settings.card_bg }};
              padding: {{ section.settings.card_padding }}px;
            "
          >

              {% if block.settings.badge_text != blank %}
            <div class="product-badge">
              {{ block.settings.badge_text }}
            </div>
              {% endif %}

           <a href="{{ product.url }}">
  <div class="product-image-wrap">
    <img
      class="main-img"
      src="{{ product.featured_image | img_url: '500x' }}"
      alt="{{ product.title }}"
    >

    {% if product.images[1] %}
      <img
        class="hover-img"
        src="{{ product.images[1] | img_url: '500x' }}"
        alt="{{ product.title }}"
      >
    {% endif %}
  </div>
</a>

<h3 class="product-title">
              <a href="{{ product.url }}">{{ product.title }}</a>
</h3>
{% comment %} Old Code  <h3 class="product-title">{{ product.title }}</h3> {% endcomment %}

        <!-- Start of Judge.me code -->
      <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.badge }}
      </div>
      <!-- End of Judge.me code -->

           {% assign variant = product.selected_or_first_available_variant %}

<div class="product-price" id="product-price-{{ product.id }}">

  {% if variant.selling_plan_allocations.size > 0 %}
    
    {% assign sub_price = variant.selling_plan_allocations.first.price %}
    <span class="subscription-price">
      From {{ sub_price | money }}
    </span>

  {% else %}

    {% if product.title == "The Phoenix Gravity Water Filter"
      or product.title == "KokoCarb Cartridges"
      or product.title == "POSTreat Fluoride Removal Filter Cartridge"
      or product.title == "Teak Wood Stand"
      or product.title == "Stainless Steel Stand"
      or product.title == "Stainless Steel Stand (Black)"
      or product.title == "POSTreat FluoRid Media Refill" %}

      <span class="regular-price">
        From {{ product.price | money }}
      </span>

    {% else %}

      <span class="regular-price">
        {{ product.price | money }}
      </span>

    {% endif %}

  {% endif %}

</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const appstlePrice = document.querySelector(".appstle_subscription_final_price");
  const priceContainer = document.querySelector("#product-price-{{ product.id }}");

  if (appstlePrice && priceContainer) {
    const subText = appstlePrice.innerText.trim();

    if (!priceContainer.innerText.includes(subText)) {
      priceContainer.innerHTML = `<span class="subscription-price">From ${subText}</span>`;
    }
  }
});
</script>

         <a href="{{ product.url }}" class="atc-btn"
   style="
     background: {{ section.settings.button_bg }};
     color: {{ section.settings.button_text }};
     display: inline-block;
     text-align: center;
     padding: 10px 20px;
     text-decoration: none;
   ">
  {{ section.settings.button_label }}
</a>

          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .product-reviews img {
    width: 70px !important;
}
.product-reviews {
    display: flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
}
.filtration-card {
  position: relative;
  justify-content: end;
  text-align: center;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.atc-btn {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;

  white-space: nowrap;

  margin-top: auto; /* 🔥 THIS IS THE KEY */
}

.product-image-wrap {
  position: relative;
  overflow: hidden;
}

.product-image-wrap img {
  width: 100%;
  transition: opacity 0.35s ease;
}

.product-image-wrap .hover-img {
  position: absolute;
  top: 0;
  left: 0;
  opacity: 0;
}

.filtration-card:hover .hover-img {
  opacity: 1;
}

.filtration-card:hover .main-img {
  opacity: 0;
}

#{{ custom_id | handle }} .filtration-heading {
    font-size: {{  section.settings.b1}}px;
    font-weight: 700;
    margin-bottom: 40px;
    text-decoration: underline;
    text-decoration-color: #f7931f;
    text-underline-offset: 12px;
}

.filtration-grid {
  display: grid;
  gap: var(--card-gap);
  grid-template-columns: repeat(var(--desktop-cols), 1fr);
}

@media (max-width: 768px) {
  .filtration-grid {
    grid-template-columns: repeat(var(--mobile-cols), 1fr);
  }
  #{{ custom_id | handle }} .filtration-heading {
    font-size: {{  section.settings.b2}}px;
            text-align: center;
}
}

.filtration-card img {
  width: 100%;
  height: auto;
}
.product-badge {
    position: absolute;
    top: 15px;
    left: 77%;
    background: #f7931e;
    color: #fff;
    padding: 6px 12px;
    border-radius: 50px;
    font-size: 12px;
    z-index: 1;
}

.product-title {
  font-size: 20px;
  margin-top: 20px;
}

.product-reviews {
  font-size: 14px;
  margin: 8px 0;
  opacity: 0.8;
}

.product-price {
  font-size: 18px;
  font-weight: 600;
  margin: 15px 0;
}

.atc-btn {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
}
</style>

{% schema %}
{
  "name": "Custom Products Grid",
  "settings": [
  {
  "type": "range",
  "id": "b1",
  "label": "Heading font size (Desktop)",
  "min": 15,
  "max": 50,
  "step": 1,
  "default": 32
},

  {
  "type": "range",
  "id": "b2",
  "label": "Heading font size (Mobile)",
  "min": 10,
  "max": 50,
  "step": 1,
  "default": 24
},



    {
  "type": "range",
  "id": "desktop_columns",
  "label": "Desktop – Products per row",
  "min": 2,
  "max": 5,
  "step": 1,
  "default": 3
},
{
  "type": "range",
  "id": "mobile_columns",
  "label": "Mobile – Products per row",
  "min": 1,
  "max": 3,
  "step": 1,
  "default": 1
},
    {
      "type": "text",
      "id": "heading1",
      "label": "Section Heading h1",
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Filtration Systems"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background",
      "default": "#f4f6f8"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background",
      "default": "#f5d547"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Text",
      "default": "ADD TO CART"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card Gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "default": 30
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card Padding",
      "min": 10,
      "max": 50,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_lr",
      "label": "Padding Left/Right",
      "min": 10,
      "max": 80,
      "step": 5,
      "default": 20
    },
    {
  "type": "text",
  "id": "custom_anchor_id",
  "label": "Unique Section ID (Anchor)",
  "info": "Example: filtration-products (no #, no spaces)"
}

  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Top Badge Text",
          "default": "1–2 people"
        },
        {
          "type": "text",
          "id": "review_text",
          "label": "Review Text",
          "default": "(4.7/5) · 846 Reviews"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Products Grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
