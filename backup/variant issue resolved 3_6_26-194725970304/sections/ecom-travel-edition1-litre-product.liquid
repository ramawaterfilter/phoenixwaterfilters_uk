<script>
document.addEventListener("DOMContentLoaded", function () {

 /* Klaviyo popup */
 const btn = document.getElementById("phoenix-open-klaviyo");
 btn.addEventListener("click", function (e) {
 e.preventDefault();
 window._klOnsite = window._klOnsite || [];
 window._klOnsite.push(['openForm', 'SL2vUR']);
 });

 /* Countdown – Jan 12 */
 const endTime = new Date(2026, 0, 12, 23, 59, 59).getTime();

 function updateCountdown() {
 const now = Date.now();
 const diff = endTime - now;

 if (diff <= 0) return;

 document.getElementById("phoenix-days").textContent =
 String(Math.floor(diff / (1000 * 60 * 60 * 24))).padStart(2, "0");
 document.getElementById("phoenix-hours").textContent =
 String(Math.floor((diff / (1000 * 60 * 60)) % 24)).padStart(2, "0");
 document.getElementById("phoenix-minutes").textContent =
 String(Math.floor((diff / (1000 * 60)) % 60)).padStart(2, "0");
 document.getElementById("phoenix-seconds").textContent =
 String(Math.floor((diff / 1000) % 60)).padStart(2, "0");
 }

 updateCountdown();
 setInterval(updateCountdown, 1000);
});
</script>
