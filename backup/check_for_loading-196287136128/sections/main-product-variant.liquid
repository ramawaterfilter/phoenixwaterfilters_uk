<script>
  (() => {
    const defineVariantMetafieldAccordion = () => {
      if (!customElements.get('variant-metafield-accordion')) {
        customElements.define(
          'variant-metafield-accordion',
          class VariantMetafieldAccordion extends HTMLElement {
            connectedCallback() {
              this.unsubscribe = subscribe(PUB_SUB_EVENTS.variantChange, ({ data }) => {
                const source = data?.html?.getElementById(this.id);
                const sourceContent = source?.querySelector('[data-variant-metafield-content]');
                const currentContent = this.querySelector('[data-variant-metafield-content]');

                if (!source || !sourceContent || !currentContent) {
                  this.hidden = true;
                  return;
                }

                currentContent.innerHTML = sourceContent.innerHTML;
                this.hidden = source.hidden;
              });
            }

            disconnectedCallback() {
              this.unsubscribe?.();
            }
          }
        );
      }
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', defineVariantMetafieldAccordion, { once: true });
    } else {
      defineVariantMetafieldAccordion();
    }
  })();
</script>

  <script type="application/json" id="ProductDescriptionData-{{ section.id }}">
    {
      "product": {{ product.description | json }},
      "variants": {
        {%- for variant in product.variants -%}
          {%- capture v_description -%}
            {%- if variant.metafields.custom.variant_level_description != blank -%}
              {{ variant.metafields.custom.variant_level_description | metafield_tag }}
            {%- endif -%}
          {%- endcapture -%}
          "{{ variant.id }}": {{ v_description | strip | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    }
  </script>

  <script>
    (function () {
      function initDescriptionReadMore() {
        const description = document.getElementById('ProductDescription-{{ section.id }}');
        const toggleButton = document.getElementById('ProductDescriptionToggle-{{ section.id }}');
        const dataScript = document.getElementById('ProductDescriptionData-{{ section.id }}');

        if (!description || !toggleButton || !dataScript) return;

        let descriptionData = {
          product: description.innerHTML,
          variants: {}
        };

        try {
          descriptionData = JSON.parse(dataScript.textContent);
        } catch (error) {}

        const sectionRoot =
          document.getElementById('shopify-section-{{ section.id }}') ||
          description.closest('.shopify-section') ||
          document;

        const markers = ['12months', '12 months'];

        let originalHtml = '';
        let activeVariantId = '';
        let loadedHtml = '';

        function hasRealContent(element) {
          const text = (element.textContent || '').replace(/[.\s…,:;!?-]/g, '');
          const hasText = text.length > 0;
          const hasMedia = element.querySelector('img, video, iframe, table, ul, ol');

          return hasText || !!hasMedia;
        }

        function findMarker(root) {
          const walker = document.createTreeWalker(
            root,
            NodeFilter.SHOW_TEXT,
            {
              acceptNode: function (node) {
                const value = (node.nodeValue || '').toLowerCase();

                const found = markers.some(function (marker) {
                  return value.indexOf(marker.toLowerCase()) !== -1;
                });

                return found ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_SKIP;
              }
            }
          );

          const node = walker.nextNode();

          if (!node) return null;

          const value = node.nodeValue || '';
          const lowerValue = value.toLowerCase();

          let bestMatch = null;

          markers.forEach(function (marker) {
            const index = lowerValue.indexOf(marker.toLowerCase());

            if (index !== -1 && (!bestMatch || index < bestMatch.index)) {
              bestMatch = {
                node: node,
                index: index,
                marker: marker
              };
            }
          });

          return bestMatch;
        }

        function applyReadMoreSplit() {
          if (originalHtml) {
            description.innerHTML = originalHtml;
          } else {
            originalHtml = description.innerHTML;
          }

          toggleButton.hidden = true;
          toggleButton.classList.add('is-hidden');
          toggleButton.textContent = 'Read more';

          description.classList.remove('is-description-expanded');

          const match = findMarker(description);

          if (!match) return;

          let splitIndex = match.index + match.marker.length;
          const textValue = match.node.nodeValue || '';

          while (
            splitIndex < textValue.length &&
            /[\s.,:;!?…-]/.test(textValue.charAt(splitIndex))
          ) {
            splitIndex++;
          }

          const afterNode = match.node.splitText(splitIndex);

          const range = document.createRange();
          range.setStartBefore(afterNode);
          range.setEndAfter(description.lastChild);

          const hiddenFragment = range.extractContents();

          const moreWrapper = document.createElement('div');
          moreWrapper.className = 'product__description-more';
          moreWrapper.hidden = true;
          moreWrapper.appendChild(hiddenFragment);

          if (!hasRealContent(moreWrapper)) return;

          description.appendChild(moreWrapper);

          toggleButton.hidden = false;
          toggleButton.classList.remove('is-hidden');
        }

        function getCurrentVariantId() {
          const variantInput = sectionRoot.querySelector(
            'form[action*="/cart/add"] input[name="id"], input.product-variant-id[name="id"]'
          );

          return variantInput ? variantInput.value : null;
        }

        function renderCurrentVariantDescription() {
          const variantId = getCurrentVariantId();

          const variantHtml =
            variantId &&
            descriptionData.variants &&
            descriptionData.variants[variantId]
              ? descriptionData.variants[variantId]
              : descriptionData.product;

          if (
            activeVariantId !== String(variantId || '') ||
            loadedHtml !== variantHtml
          ) {
            description.innerHTML = variantHtml || '';
            originalHtml = description.innerHTML;
            activeVariantId = String(variantId || '');
            loadedHtml = variantHtml || '';
          }

          applyReadMoreSplit();
        }

        toggleButton.addEventListener('click', function () {
          const moreContent = description.querySelector('.product__description-more');

          if (!moreContent) return;

          const isExpanded = description.classList.toggle('is-description-expanded');

          moreContent.hidden = !isExpanded;
          toggleButton.textContent = isExpanded ? 'Read less' : 'Read more';
        });

        renderCurrentVariantDescription();

        document.addEventListener('variant:change', function () {
          setTimeout(renderCurrentVariantDescription, 100);
        });

        sectionRoot.addEventListener('change', function () {
          setTimeout(renderCurrentVariantDescription, 100);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initDescriptionReadMore);
      } else {
        initDescriptionReadMore();
      }
    })();
  </script>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const sectionId = {{ section.id | json }};
      let currentVariantId = null;
      let controller = null;

      function getSectionRoot() {
        return document.getElementById('shopify-section-' + sectionId) || document;
      }

      function getCurrentVariantId() {
        const sectionRoot = getSectionRoot();

        const variantInput =
          sectionRoot.querySelector('form[action*="/cart/add"] input[name="id"]') ||
          sectionRoot.querySelector('form[action*="/cart/add"] select[name="id"]') ||
          document.querySelector('form[action*="/cart/add"] input[name="id"]') ||
          document.querySelector('form[action*="/cart/add"] select[name="id"]');

        if (variantInput && variantInput.value) {
          return variantInput.value;
        }

        return new URLSearchParams(window.location.search).get('variant');
      }

      function updateVariantAccordion() {
        const variantId = getCurrentVariantId();

        if (!variantId || variantId === currentVariantId) return;

        currentVariantId = variantId;

        if (controller) {
          controller.abort();
        }

        controller = new AbortController();

        const url = new URL(window.location.href);
        url.searchParams.set('variant', variantId);
        url.searchParams.set('section_id', sectionId);

        fetch(url.toString(), {
          signal: controller.signal
        })
          .then(function (response) {
            return response.text();
          })
          .then(function (html) {
            const newDocument = new DOMParser().parseFromString(html, 'text/html');

            document.querySelectorAll('[data-variant-accordion-area]').forEach(function (oldArea) {
              const blockId = oldArea.getAttribute('data-variant-accordion-area');
              const newArea = newDocument.querySelector('[data-variant-accordion-area="' + blockId + '"]');

              if (newArea) {
                oldArea.innerHTML = newArea.innerHTML;
              } else {
                oldArea.innerHTML = '';
              }
            });
          })
          .catch(function (error) {
            if (error.name !== 'AbortError') {
              console.warn('Variant accordion update failed:', error);
            }
          });
      }

      function delayedUpdate() {
        setTimeout(updateVariantAccordion, 50);
        setTimeout(updateVariantAccordion, 200);
        setTimeout(updateVariantAccordion, 500);
        setTimeout(updateVariantAccordion, 900);
      }

      delayedUpdate();

      document.addEventListener('change', delayedUpdate, true);
      document.addEventListener('click', delayedUpdate, true);
      document.addEventListener('variant:change', delayedUpdate);
      document.addEventListener('variantChange', delayedUpdate);
      document.addEventListener('shopify:section:load', delayedUpdate);

      const sectionRoot = getSectionRoot();

      const observer = new MutationObserver(delayedUpdate);

      observer.observe(sectionRoot, {
        subtree: true,
        childList: true,
        attributes: true,
        attributeFilter: ['value', 'checked', 'selected']
      });

      const originalPushState = history.pushState;
      const originalReplaceState = history.replaceState;

      history.pushState = function () {
        originalPushState.apply(this, arguments);
        delayedUpdate();
      };

      history.replaceState = function () {
        originalReplaceState.apply(this, arguments);
        delayedUpdate();
      };

      window.addEventListener('popstate', delayedUpdate);
    });
  </script>

