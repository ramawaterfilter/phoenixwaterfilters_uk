<script>
document.addEventListener("DOMContentLoaded", function() {

  const button = document.getElementById("stand-info-btn");
  const popup = document.getElementById("stand-popup-overlay");
  const closeBtn = document.getElementById("stand-popup-close");
  const imageDiv = document.getElementById("stand-popup-image");
  const titleEl = document.getElementById("stand-popup-title");
  const textEl = document.getElementById("stand-popup-text");

  if (!button || !popup || !closeBtn || !imageDiv || !titleEl || !textEl) return;

  const variants = window.productVariants || [];

  // 🔥 Your Stand Popup Data
  const standPopupData = {
    "Stainless Steel Stand": {
      title: "Stainless Steel Stand",
      desc: "Premium stainless steel stand. Strong, durable and modern design.",
      img: "https://cdn.shopify.com/s/files/1/2644/2852/files/Stainless_Stand.jpg?v=1751539237&width=900"
    },
    "No Stand": {
      title: "Filter System (No Stand)",
      desc: "Filter system without stand. Perfect for countertop placement.",
      img: "https://cdn.shopify.com/s/files/1/2644/2852/files/Img_2_eng_USA.jpg?v=1765541721&width=900"
    },
    "Teak Wood Stand": {
      title: "Teak Wood Stand",
      desc: "Beautiful natural teak wood stand. Elegant and stylish look.",
      img: "https://cdn.shopify.com/s/files/1/2644/2852/files/Teak_Wood_Stand-varient.jpg?v=1751539320&width=900"
    }
  };

  function getSelectedVariant() {
    const selector = document.querySelector('[name="id"]');
    if (!selector) return null;

    const selectedId = selector.value;
    return variants.find(v => v.id == selectedId);
  }

  button.addEventListener("click", function() {

    const variant = getSelectedVariant();
    if (!variant) return;

    // 🔥 Detect Stand Option (works regardless of option position)
    const standValue = variant.option1 || variant.option2 || variant.option3;

    const data = standPopupData[standValue];
    if (!data) return;

    titleEl.textContent = data.title;
    textEl.innerHTML = data.desc;
    imageDiv.style.backgroundImage = `url('${data.img}')`;

    popup.style.display = "flex";
  });

  closeBtn.addEventListener("click", function() {
    popup.style.display = "none";
  });

  popup.addEventListener("click", function(e) {
    if (e.target === popup) {
      popup.style.display = "none";
    }
  });

});
</script>
