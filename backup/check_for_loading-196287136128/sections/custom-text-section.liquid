{% assign uid = section.id %}

<section
  id="product-desc-{{ uid }}"
  class="product-desc-{{ uid }} {{ section.settings.cs1 }}"
  style="
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="page-width customp">



 {% if section.settings.heading2 != blank %}
      <h1 class="desc-heading hn-k">
        {{ section.settings.heading2 }}
      </h1>
{% endif %}


    {% if section.settings.heading != blank %}
      <h2 class="desc-heading hn-k">
        {{ section.settings.heading }}
      </h2>
  {% if section.settings.show_heading_line %}
  <div class="heading-line"></div>
{% endif %}

    {% endif %}

    <div class="desc-grid">
           {% if section.settings.left_content != blank %}
      <div class="desc-col">
        {{ section.settings.left_content }}
      </div>
       {% endif %}

           {% if section.settings.right_content != blank %}
      <div class="desc-col">
        {{ section.settings.right_content }}
      </div>
       {% endif %}
    </div>

    {% if section.settings.bottom_heading != blank or section.settings.bottom_button_text != blank %}
      <div class="bottom-cta">
        
        <div class="both-cta-txt">
        {% if section.settings.bottom_icon != blank %}
          <div class="cta-icon">
            <img
              src="{{ section.settings.bottom_icon | image_url: width: 60 }}"
              width="60"
              height="60"
              loading="lazy"
              alt="10-year warranty"
              class="bottom-cta-icon-image"
            >
          </div>
        {% endif %}


          <div class="cta-headings">
        {% if section.settings.bottom_heading != blank %}
          <div class="cta-heading">
            {{ section.settings.bottom_heading }}
          </div>
        {% endif %}

          {% if section.settings.bottom_heading1 != blank %}
          <div class="cta-heading1">
            {{ section.settings.bottom_heading1 }}
          </div>
        {% endif %}
        </div>
        </div>

        {% if section.settings.bottom_button_text != blank %}
          <a href="{{ section.settings.bottom_button_link }}" class="cta-btn kl">
            {{ section.settings.bottom_button_text }}
          </a>
        {% endif %}

      </div>
    {% endif %}

    {% if section.settings.c1%}
          <div class="bottom-image">
          {% if section.settings.m2 != blank %}
          <div class="cta-image">
       <img src="{{ section.settings.m2 | img_url: 'master' }}" alt="icon">
          </div>
          {% endif %}
          </div>
        {% endif %}
{% if section.settings.show_bottom_buttons %}
  <div class="bottom-buttons-row">

    {% for i in (1..5) %}

      {% capture btn_text_key %}btn_text_{{ i }}{% endcapture %}
      {% capture btn_link_key %}btn_link_{{ i }}{% endcapture %}
      {% capture btn_bg_key %}btn_bg_{{ i }}{% endcapture %}
      {% capture btn_text_color_key %}btn_text_color_{{ i }}{% endcapture %}
      {% capture btn_border_key %}btn_border_color_{{ i }}{% endcapture %}

      {% assign btn_text = section.settings[btn_text_key] %}
      {% assign btn_link = section.settings[btn_link_key] %}
      {% assign btn_bg = section.settings[btn_bg_key] %}
      {% assign btn_text_color = section.settings[btn_text_color_key] %}
      {% assign btn_border = section.settings[btn_border_key] %}

      {% if btn_text != blank %}
        <a
          href="{{ btn_link }}"
          class="bottom-btn"
          style="
            background-color: {{ btn_bg }};
            color: {{ btn_text_color }};
            border: 2px solid {{ btn_border }};
          "
        >
          {{ btn_text }}
        </a>
      {% endif %}

    {% endfor %}

  </div>
{% endif %}   
  </div>

{% if section.settings.show_faq_search %}
  <div class="faq-search-wrap">
    <input
      type="text"
      id="faqSearch-{{ uid }}"
      placeholder="{{ section.settings.faq_search_placeholder }}"
      class="faq-search-input"
    >
  </div>
{% endif %}


