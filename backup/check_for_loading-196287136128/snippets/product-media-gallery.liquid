<!-- Custom Video Fullscreen Modal -->
<div id="custom-video-modal" role="dialog" aria-modal="true" aria-label="Video fullscreen">
  <video id="cvm-video" controls playsinline></video>

  <button id="cvm-close" aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
    </svg>
  </button>

  <button class="cvm-arrow" id="cvm-prev" aria-label="Previous">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <button class="cvm-arrow" id="cvm-next" aria-label="Next">
    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div id="cvm-counter"></div>
</div>

<script>
(function() {
  'use strict';

  function initGallery(sectionId) {
    const gallery = document.getElementById('MediaGallery-' + sectionId);
    if (!gallery) return;

    const prevBtn = document.getElementById('galleryPrev-' + sectionId);
    const nextBtn = document.getElementById('galleryNext-' + sectionId);
    const slider = document.getElementById('Slider-Gallery-' + sectionId);
    const grid = document.getElementById('GalleryThumbnails2x2-' + sectionId);

    if (!slider) return;

    let currentIndex = 0;
    let allMedia = [];

    function refreshMediaData() {
      allMedia = [];
      const slides = slider.querySelectorAll('.product__media-item');
      slides.forEach((slide, index) => {
        const img = slide.querySelector('img');
        if (!img) return;
        allMedia.push({
          element: slide,
          mediaId: slide.dataset.mediaId,
          alt: img.alt || '',
          src: img.src,
          index
        });
      });
    }

    function groupByAlt(mediaArray) {
      const groups = {};
      mediaArray.forEach(item => {
        if (!groups[item.alt]) groups[item.alt] = [];
        groups[item.alt].push(item);
      });
      return groups;
    }

    function reorderByAlt(targetAlt) {
      if (!targetAlt) return;
      const groups = groupByAlt(allMedia);
      const targetGroup = groups[targetAlt] || [];
      const others = allMedia.filter(m => m.alt !== targetAlt);
      const newOrder = [...targetGroup, ...others];
      const fragment = document.createDocumentFragment();
      newOrder.forEach(item => fragment.appendChild(item.element));
      slider.innerHTML = '';
      slider.appendChild(fragment);
      allMedia = newOrder;
    }

    function getActiveIndex() {
      for (let i = 0; i < allMedia.length; i++) {
        if (allMedia[i].element.classList.contains('is-active')) return i;
      }
      return 0;
    }

    function setActiveSlide(index) {
      if (index < 0 || index >= allMedia.length) return;
      allMedia.forEach(item => item.element.classList.remove('is-active'));
      allMedia[index].element.classList.add('is-active');
      currentIndex = index;
      slider.scrollTo({ left: allMedia[index].element.offsetLeft, behavior: 'smooth' });
      updateArrows();
      updateCounter();
      updateGrid();
    }

    function goToSlide(index) {
      setActiveSlide(index);
    }

    function updateArrows() {
      if (!prevBtn || !nextBtn) return;
      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex === allMedia.length - 1;
    }

    function updateCounter() {
      const counter = gallery.querySelector('.slider-counter--current');
      if (counter) counter.textContent = currentIndex + 1;
    }

    function updateGrid() {
      if (!grid) return;
      const currentAlt = allMedia[currentIndex]?.alt || '';
      const groups = groupByAlt(allMedia);
      const priority = groups[currentAlt] || [];
      const others = allMedia.filter(i => i.alt !== currentAlt);
      const display = [...priority, ...others].slice(0, 4);
      grid.innerHTML = '';
      display.forEach(item => {
        const btn = document.createElement('button');
        btn.className = 'thumbnail-2x2-item';
        if (item.mediaId === allMedia[currentIndex].mediaId) btn.classList.add('is-active');
        const img = document.createElement('img');
        img.src = item.src;
        img.alt = item.alt;
        img.loading = 'lazy';
        btn.appendChild(img);
        grid.appendChild(btn);
        btn.onclick = () => {
          const idx = allMedia.findIndex(m => m.mediaId === item.mediaId);
          if (idx !== -1) goToSlide(idx);
        };
      });
    }

    function handleVariantChange() {
      setTimeout(() => {
        refreshMediaData();
        const activeIndex = getActiveIndex();
        const alt = allMedia[activeIndex]?.alt || '';
        if (alt) {
          reorderByAlt(alt);
          const newIndex = getActiveIndex();
          currentIndex = newIndex !== -1 ? newIndex : 0;
        }
        updateArrows();
        updateCounter();
        updateGrid();
      }, 400);
    }

    function setupVariantListeners() {
      document.addEventListener('variant:change', () => setTimeout(handleVariantChange, 200));
      document.addEventListener('shopify:variant:change', () => setTimeout(handleVariantChange, 200));
      document.querySelectorAll('select[name="id"]').forEach(el => {
        el.addEventListener('change', () => setTimeout(handleVariantChange, 200));
      });
      document.querySelectorAll('input[type="radio"]').forEach(el => {
        el.addEventListener('change', () => setTimeout(handleVariantChange, 200));
      });
      const observer = new MutationObserver(() => setTimeout(handleVariantChange, 300));
      observer.observe(slider, { childList: true, subtree: true });
    }

    function setupTouchSwipe() {
      let touchStartX = 0;
      let touchStartY = 0;
      let isDragging = false;

      slider.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
        isDragging = false;
      }, { passive: true });

      slider.addEventListener('touchmove', function(e) {
        const deltaX = Math.abs(e.changedTouches[0].clientX - touchStartX);
        const deltaY = Math.abs(e.changedTouches[0].clientY - touchStartY);
        if (deltaX > deltaY && deltaX > 10) {
          isDragging = true;
          e.preventDefault();
        }
      }, { passive: false });

      slider.addEventListener('touchend', function(e) {
        if (!isDragging) return;
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (diff > 50) goToSlide(currentIndex + 1);
        else if (diff < -50) goToSlide(currentIndex - 1);
        isDragging = false;
      }, { passive: true });
    }

    if (prevBtn) prevBtn.onclick = () => goToSlide(currentIndex - 1);
    if (nextBtn) nextBtn.onclick = () => goToSlide(currentIndex + 1);

    function init() {
      refreshMediaData();
      const active = getActiveIndex();
      const alt = allMedia[active]?.alt || '';
      if (alt) reorderByAlt(alt);
      currentIndex = getActiveIndex();
      updateArrows();
      updateCounter();
      updateGrid();
      setupVariantListeners();
      setupTouchSwipe();
    }

    init();
  }

  function initAll() {
    document.querySelectorAll('[id^="MediaGallery-"]').forEach(g => {
      const id = g.id.replace('MediaGallery-', '');
      initGallery(id);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

})();


// ============================================================
// MODAL FULLSCREEN — Arrows + Close Button + Keyboard + Swipe
// ============================================================
(function() {
  'use strict';

  function injectModalControls(modal) {
    if (modal.dataset.customControlsInjected) return;
    modal.dataset.customControlsInjected = 'true';

    const closeBtn = document.createElement('button');
    closeBtn.className = 'modal-custom-close';
    closeBtn.setAttribute('aria-label', 'Close');
    closeBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`;
    closeBtn.onclick = () => closeModal(modal);
    modal.appendChild(closeBtn);

    const prevBtn = document.createElement('button');
    prevBtn.className = 'modal-custom-arrow modal-custom-arrow--prev';
    prevBtn.setAttribute('aria-label', 'Previous');
    prevBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    prevBtn.onclick = () => navigateModal(modal, -1);
    modal.appendChild(prevBtn);

    const nextBtn = document.createElement('button');
    nextBtn.className = 'modal-custom-arrow modal-custom-arrow--next';
    nextBtn.setAttribute('aria-label', 'Next');
    nextBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    nextBtn.onclick = () => navigateModal(modal, 1);
    modal.appendChild(nextBtn);

    setupModalSwipe(modal);
  }

  function closeModal(modal) {
    const closeNative = modal.querySelector('[data-close-modal], .modal__close-button, button[aria-label="Close dialog"]');
    if (closeNative) { closeNative.click(); return; }
    modal.removeAttribute('open');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  function getModalSlides(modal) {
    return Array.from(modal.querySelectorAll(
      '.product-media-modal__content > *, .modal__content .product__media-item, [data-media-id], .slider__slide'
    )).filter(el => el.offsetHeight > 0);
  }

  function getModalActiveIndex(slides) {
    for (let i = 0; i < slides.length; i++) {
      if (slides[i].classList.contains('is-active') ||
          slides[i].getAttribute('aria-hidden') === 'false' ||
          slides[i].hasAttribute('active')) return i;
    }
    return 0;
  }

  function navigateModal(modal, direction) {
    const slides = getModalSlides(modal);
    if (!slides.length) return;

    if (direction === 1) {
      const nativeNext = modal.querySelector('.slider-button--next, [name="next"]');
      if (nativeNext) { nativeNext.click(); return; }
    } else {
      const nativePrev = modal.querySelector('.slider-button--prev, [name="previous"]');
      if (nativePrev) { nativePrev.click(); return; }
    }

    let current = getModalActiveIndex(slides);
    let next = current + direction;
    if (next < 0) next = slides.length - 1;
    if (next >= slides.length) next = 0;
    slides.forEach(s => s.classList.remove('is-active'));
    slides[next].classList.add('is-active');
    slides[next].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  function setupModalSwipe(modal) {
    let startX = 0, startY = 0, dragging = false;
    modal.addEventListener('touchstart', function(e) {
      startX = e.changedTouches[0].clientX;
      startY = e.changedTouches[0].clientY;
      dragging = false;
    }, { passive: true });
    modal.addEventListener('touchmove', function(e) {
      const dx = Math.abs(e.changedTouches[0].clientX - startX);
      const dy = Math.abs(e.changedTouches[0].clientY - startY);
      if (dx > dy && dx > 10) { dragging = true; e.preventDefault(); }
    }, { passive: false });
    modal.addEventListener('touchend', function(e) {
      if (!dragging) return;
      const diff = startX - e.changedTouches[0].clientX;
      if (diff > 50) navigateModal(modal, 1);
      else if (diff < -50) navigateModal(modal, -1);
      dragging = false;
    }, { passive: true });
  }

  document.addEventListener('keydown', function(e) {
    const modal = document.querySelector(
      'product-media-modal[open], .product-media-modal[open], dialog[open].product-media-modal, #ProductModal:not([hidden])'
    );
    if (!modal) return;
    if (e.key === 'ArrowRight') navigateModal(modal, 1);
    else if (e.key === 'ArrowLeft') navigateModal(modal, -1);
    else if (e.key === 'Escape') closeModal(modal);
  });

  const bodyObserver = new MutationObserver(() => {
    const modals = document.querySelectorAll(
      'product-media-modal, .product-media-modal, #ProductModal, [id*="ProductModal"], [id*="MediaModal"]'
    );
    modals.forEach(modal => {
      const isOpen =
        modal.hasAttribute('open') ||
        modal.getAttribute('aria-hidden') === 'false' ||
        (!modal.hidden && modal.offsetHeight > 0 && getComputedStyle(modal).display !== 'none');
      if (isOpen) injectModalControls(modal);
    });
  });

  bodyObserver.observe(document.body, {
    attributes: true,
    subtree: true,
    attributeFilter: ['open', 'aria-hidden', 'hidden', 'style', 'class']
  });

})();


// ============================================================
// CUSTOM VIDEO FULLSCREEN MODAL
// Native browser fullscreen ke bajay apna modal use karta hai
// Jisme cross button + prev/next arrows dikh sakte hain
// ============================================================
(function() {
  'use strict';

  const modal    = document.getElementById('custom-video-modal');
  const cvmVideo = document.getElementById('cvm-video');
  const cvmClose = document.getElementById('cvm-close');
  const cvmPrev  = document.getElementById('cvm-prev');
  const cvmNext  = document.getElementById('cvm-next');
  const cvmCounter = document.getElementById('cvm-counter');

  if (!modal || !cvmVideo) return;

  // All gallery slides (collected fresh each time)
  function getAllSlides() {
    return Array.from(document.querySelectorAll('.product__media-item'));
  }

  function getCurrentIndex() {
    const slides = getAllSlides();
    return slides.findIndex(s => s.classList.contains('is-active'));
  }

  // ── Open modal with a given video source ──
  function openModal(videoSrc, currentIdx, total) {
    cvmVideo.src = videoSrc;
    cvmVideo.load();
    cvmVideo.play().catch(() => {});

    modal.classList.add('open');
    document.body.style.overflow = 'hidden';

    updateModalUI(currentIdx, total);

    // Trap focus
    setTimeout(() => cvmClose.focus(), 100);
  }

  // ── Close modal ──
  function closeModal() {
    cvmVideo.pause();
    cvmVideo.src = '';
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  // ── Update counter + arrow visibility ──
  function updateModalUI(idx, total) {
    if (cvmCounter) {
      cvmCounter.textContent = total > 1 ? (idx + 1) + ' / ' + total : '';
    }
    cvmPrev.classList.toggle('hidden', total <= 1);
    cvmNext.classList.toggle('hidden', total <= 1);
  }

  // ── Navigate slides from modal ──
  function navigateSlide(direction) {
    const slides = getAllSlides();
    const currentIdx = getCurrentIndex();
    const nextIdx = currentIdx + direction;

    if (nextIdx < 0 || nextIdx >= slides.length) return;

    // Check if next slide has a video
    const nextSlide = slides[nextIdx];
    const nextVideo = nextSlide.querySelector('video');
    const nextSrc = nextVideo ? (nextVideo.currentSrc || nextVideo.src || nextVideo.querySelector('source')?.src) : null;

    // Update active slide in gallery
    slides.forEach(s => s.classList.remove('is-active'));
    nextSlide.classList.add('is-active');
    nextSlide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });

    // Update gallery counters
    document.querySelectorAll('.slider-counter--current').forEach(el => {
      el.textContent = nextIdx + 1;
    });

    // Update gallery prev/next arrow states
    document.querySelectorAll('[id^="galleryPrev-"]').forEach(btn => btn.disabled = nextIdx === 0);
    document.querySelectorAll('[id^="galleryNext-"]').forEach(btn => btn.disabled = nextIdx === slides.length - 1);

    if (nextSrc) {
      // Next slide is also a video — stay in modal
      cvmVideo.src = nextSrc;
      cvmVideo.load();
      cvmVideo.play().catch(() => {});
      updateModalUI(nextIdx, slides.length);
    } else {
      // Next slide is an image — close modal
      closeModal();
    }
  }

  // ── Button events ──
  cvmClose.onclick = closeModal;
  cvmPrev.onclick  = () => navigateSlide(-1);
  cvmNext.onclick  = () => navigateSlide(1);

  // ── Keyboard ──
  document.addEventListener('keydown', function(e) {
    if (!modal.classList.contains('open')) return;
    if (e.key === 'Escape')      { closeModal(); }
    else if (e.key === 'ArrowRight') { navigateSlide(1); }
    else if (e.key === 'ArrowLeft')  { navigateSlide(-1); }
  });

  // ── Touch swipe inside modal ──
  let touchStartX = 0, isDragging = false;
  modal.addEventListener('touchstart', e => {
    touchStartX = e.changedTouches[0].clientX;
    isDragging = false;
  }, { passive: true });
  modal.addEventListener('touchmove', e => {
    if (Math.abs(e.changedTouches[0].clientX - touchStartX) > 10) isDragging = true;
  }, { passive: true });
  modal.addEventListener('touchend', e => {
    if (!isDragging) return;
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (diff > 50) navigateSlide(1);
    else if (diff < -50) navigateSlide(-1);
    isDragging = false;
  }, { passive: true });

  // ── Intercept fullscreen button clicks on videos ──
  // We intercept the native fullscreen expand icon (⛶) click
  // by listening to fullscreenchange and immediately exiting + opening our modal
  function interceptVideoFullscreen(videoEl) {
    if (videoEl.dataset.cvmIntercepted) return;
    videoEl.dataset.cvmIntercepted = 'true';

    // Method 1: Listen for fullscreenchange — exit immediately and open our modal
    const handleFullscreen = function() {
      const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
      if (fsEl && (fsEl === videoEl || fsEl.contains(videoEl))) {
        // Exit native fullscreen immediately
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();

        // Open our custom modal
        const src = videoEl.currentSrc || videoEl.src || videoEl.querySelector('source')?.src || '';
        if (src) {
          const slides = getAllSlides();
          const slide = videoEl.closest('.product__media-item');
          const idx = slide ? slides.indexOf(slide) : getCurrentIndex();
          openModal(src, idx >= 0 ? idx : 0, slides.length);
        }
      }
    };

    document.addEventListener('fullscreenchange', handleFullscreen);
    document.addEventListener('webkitfullscreenchange', handleFullscreen);

    // Method 2: Also intercept double-click (some browsers go fullscreen on dblclick)
    videoEl.addEventListener('dblclick', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const src = videoEl.currentSrc || videoEl.src || videoEl.querySelector('source')?.src || '';
      if (src) {
        const slides = getAllSlides();
        const slide = videoEl.closest('.product__media-item');
        const idx = slide ? slides.indexOf(slide) : getCurrentIndex();
        openModal(src, idx >= 0 ? idx : 0, slides.length);
      }
    });
  }

  // ── Add a custom "expand" button next to each video ──
  function addExpandButton(videoEl) {
    const container = videoEl.closest('.product__media-item, .deferred-media, [class*="media"]');
    if (!container) return;
    if (container.querySelector('.cvm-expand-btn')) return; // already added

    const expandBtn = document.createElement('button');
    expandBtn.className = 'cvm-expand-btn';
    expandBtn.setAttribute('aria-label', 'Open fullscreen');
    expandBtn.setAttribute('type', 'button');
    expandBtn.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>`;

    expandBtn.onclick = function(e) {
      e.stopPropagation();
      const src = videoEl.currentSrc || videoEl.src || videoEl.querySelector('source')?.src || '';
      if (src) {
        const slides = getAllSlides();
        const slide = videoEl.closest('.product__media-item');
        const idx = slide ? slides.indexOf(slide) : getCurrentIndex();
        openModal(src, idx >= 0 ? idx : 0, slides.length);
      }
    };

    // Position container relatively if not already
    const pos = getComputedStyle(container).position;
    if (pos === 'static') container.style.position = 'relative';

    container.appendChild(expandBtn);
  }

  // ── Scan for videos and set up interception ──
  function setupVideos() {
    document.querySelectorAll('.product__media-list video, .product__media-item video').forEach(video => {
      interceptVideoFullscreen(video);
      addExpandButton(video);
    });
  }

  // ── Init + watch for dynamically loaded videos ──
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupVideos);
  } else {
    setupVideos();
  }

  // Watch for deferred media loading
  const videoObserver = new MutationObserver(() => {
    setupVideos();
  });
  videoObserver.observe(document.body, { childList: true, subtree: true });

})();
</script>
