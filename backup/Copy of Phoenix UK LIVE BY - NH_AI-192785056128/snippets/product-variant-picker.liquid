{% comment %}
  Renders product variant-picker

  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.
  - product_form_id: {String} Id of the product form to which the variant picker is associated.
  Usage:
  {% render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id %}
{% endcomment %}
{%- unless product.has_only_default_variant -%}
  <variant-selects
    id="variant-selects-{{ section.id }}"
    data-section="{{ section.id }}"
    {{ block.shopify_attributes }}
  >
    <!-- Size Guide Modal -->
<div class="size-guide-modal" id="sizeGuideModal">
    <div class="size-guide-box">
        <button type="button" class="size-guide-close">&times;</button>
            <img id="sizeGuideDynamicImage" src="" alt="Size Guide">
              </div>
              </div>
              
                 {% comment %} <button type="button" class="size-guide-btn" id="openSizeGuide">
                     SIZE GUIDE
                     </button>   {% endcomment %}
    {%- for option in product.options_with_values -%}
      
      {%- liquid
        assign swatch_count = option.values | map: 'swatch' | compact | size
        assign picker_type = block.settings.picker_type

        if swatch_count > 0 and block.settings.swatch_shape != 'none'
          if block.settings.picker_type == 'dropdown'
            assign picker_type = 'swatch_dropdown'
          else
            assign picker_type = 'swatch'
          endif
        endif
      -%}
      
      {%- if picker_type == 'swatch' -%}
        <fieldset class="js product-form__input product-form__input--swatch">
          <legend class="form__label">
            {{ option.name }}:
            <span data-selected-value>
              {{- option.selected_value -}}
            </span>
          </legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
        
      {%- elsif picker_type == 'button' -%}
        <fieldset class="js product-form__input product-form__input--pill">
          <legend class="form__label">{{ option.name }} <span class="selected-value" data-selected-value>
      {{- option.selected_value -}}
    </span></legend>
          {% render 'product-variant-options',
            product: product,
            option: option,
            block: block,
            picker_type: picker_type
          %}
        </fieldset>
        
      {%- else -%}
        
        <div class="product-form__input product-form__input--dropdown">
          <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">
            {{ option.name }}
          </label>
          
          <div class="select">
            {%- if picker_type == 'swatch_dropdown' -%}
              <span
                data-selected-value
                class="dropdown-swatch"
              >
                {% render 'swatch', swatch: option.selected_value.swatch, shape: block.settings.swatch_shape %}
              </span>
              
            {%- endif -%}
            <select
              id="Option-{{ section.id }}-{{ forloop.index0 }}"
              class="select__select"
              name="options[{{ option.name | escape }}]"
              form="{{ product_form_id }}"
            >
              {% render 'product-variant-options',
                product: product,
                option: option,
                block: block,
                picker_type: picker_type
              %}
            </select>
            
            <span class="svg-wrapper">
              {{- 'icon-caret.svg' | inline_asset_content -}}
            </span>
          </div>
          
        </div>
        
      {%- endif -%}
    {%- endfor -%}

    <script type="application/json" data-selected-variant>
      {{ product.selected_or_first_available_variant | json }}
    </script>
  </variant-selects>
{%- endunless -%}





<script>
document.addEventListener("click", function(e) {

  if (e.target.matches(".size-guide-btn")) {

    const modal = document.getElementById("sizeGuideModal");
    const image = document.getElementById("sizeGuideDynamicImage");

    const sizeGuideImages = {
      "no stand": "https://cdn.shopify.com/s/files/1/0735/1821/9557/files/No_stand.png?v=1772693236",
      "teak wood stand": "https://cdn.shopify.com/s/files/1/0735/1821/9557/files/WOOD.png?v=1772693236",
      "stainless steel stand": "https://cdn.shopify.com/s/files/1/0735/1821/9557/files/STEEL.png?v=1772693236"
    };

    function getSelectedStandOption() {
      const fieldsets = document.querySelectorAll('.product-form__input');

      for (let fieldset of fieldsets) {
        const legend = fieldset.querySelector('legend');

        if (legend && legend.textContent.trim().toLowerCase().includes('stand')) {
          const checked = fieldset.querySelector('input[type="radio"]:checked');
          return checked ? checked.value.trim().toLowerCase() : null;
        }
      }

      return null;
    }

    const selectedStand = getSelectedStandOption();

    if (selectedStand && sizeGuideImages[selectedStand]) {
      image.src = sizeGuideImages[selectedStand];
    } else {
      image.src = "";
      console.log("Stand option not matched");
    }

    modal.style.display = "flex";
  }

});


/* CLOSE MODAL */
document.addEventListener("click", function(e) {
  if (e.target.matches(".size-guide-close")) {
    document.getElementById("sizeGuideModal").style.display = "none";
    document.getElementById("sizeGuideDynamicImage").src = "";
  }
});
</script>

<style>/* Overlay *//* ============================= */
/* SIZE GUIDE MODAL - FINAL CSS */
/* ============================= */

/* Overlay */



.selected-value {
  font-weight: 400 !important;
  font-size: 16px !important;
} 
.size-guide-modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.65);
  display: none;                 /* hidden by default */
  align-items: center;           /* vertical center */
  justify-content: center;       /* horizontal center */
  z-index: 9999;
  padding: 20px;                 /* spacing on small screens */
}
button#openSizeGuide {
    align-content: end !important;
    justify-content: end !important;
    position: absolute !important;
    right: 105px !important;
    border: none !important;
}

/* Hover effect */
button#openSizeGuide:hover {
    color: blue !important;
}
/* Popup Box */
.size-guide-box {
  background: #ffffff;
  border-radius: 16px;
  padding: 25px;
  width: 100%;
  max-width: 550px;
  position: relative;
  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);
cursor: pointer;
  /* Center content inside */
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  animation: sizeGuideFade 0.25s ease;
}
button#openSizeGuide {
    align-content: end !important;
    justify-content: end !important;
    position: absolute !important;
    right: 105px !important;
    color: #132555;
    font-weight: 700;
    border-radius: 6px;
    padding: 5px;
    cursor: pointer;
}

/* Mobile View */
@media (max-width: 768px) {
    button#openSizeGuide {
 
    color: #132555;
    font-weight: 700;
    cursor: pointer;
    border-radius: 6px;
    padding: 5px;
        right: 10px !important;
        position: absolute !important;
        align-content: end !important;
        justify-content: end !important;
    }
}
/* Image */
#sizeGuideDynamicImage {
  width: 100%;
  max-width: 500px;
  height: auto;
  display: block;
  object-fit: contain;
}

/* Close Button */
.size-guide-close {
  position: absolute;
  top: 12px;
  right: 16px;
  background: none;
  border: none;
  font-size: 24px;
  cursor: pointer;
  line-height: 1;
}

/* Animation */
@keyframes sizeGuideFade {
  from {
    opacity: 0;
    transform: scale(0.95);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

/* Responsive */
@media (max-width: 480px) {
  .size-guide-box {
    padding: 20px;
    border-radius: 12px;
  }
}
</style>