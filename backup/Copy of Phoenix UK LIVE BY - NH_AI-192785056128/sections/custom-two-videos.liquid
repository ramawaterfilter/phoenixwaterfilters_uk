{% style %}
.section-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.section-{{ section.id }} .heading {
  text-align: center;
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size_desktop }}px;
  margin-bottom: 30px;
}

.video-wrapper {
  display: flex;
  justify-content: center;
  gap: {{ section.settings.video_gap }}px;
}

.video-item {
  width: {{ section.settings.video_width_desktop }}%;
}

.video-item video {
  width: 100%;
  height: auto;
  border-radius: {{ section.settings.video_radius }}px;
}

/* Mobile */
@media(max-width: 768px) {
  .section-{{ section.id }} .heading {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }
/* .video-item video {
  height: auto !important;
} */
  .video-wrapper {
    flex-direction: column;
    gap: {{ section.settings.video_gap_mobile }}px;
  }

  .video-item {
    width: {{ section.settings.video_width_mobile }}%;
    margin: 0 auto;
  }
}
{% endstyle %}

<section class="section-{{ section.id }}">
  {% if section.settings.heading != blank %}
    <h2 class="heading">{{ section.settings.heading }}</h2>
  {% endif %}

  <div class="video-wrapper">
    
    {% if section.settings.video_1 != blank %}
      <div class="video-item 1sty">
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.video_1 }}" type="video/mp4">
        </video>
      </div>
    {% endif %}

    {% if section.settings.video_2 != blank %}
      <div class="video-item 2sty">
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.video_2 }}" type="video/mp4">
        </video>
      </div>
    {% endif %}

  </div>
</section>

{% schema %}
{
  "name": "Two Videos Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "How it compares"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1d1d1d"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Size (Desktop)",
      "min": 20,
      "max": 60,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "min": 16,
      "max": 40,
      "step": 2,
      "default": 28
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60
    },
    {
      "type": "url",
      "id": "video_1",
      "label": "Video 1 URL"
    },
    {
      "type": "url",
      "id": "video_2",
      "label": "Video 2 URL"
    },
    {
      "type": "range",
      "id": "video_width_desktop",
      "label": "Video Width (Desktop %)",
      "min": 30,
      "max": 60,
      "step": 1,
      "default": 45
    },
    {
      "type": "range",
      "id": "video_width_mobile",
      "label": "Video Width (Mobile %)",
      "min": 80,
      "max": 100,
      "step": 5,
      "default": 100
    },
    {
      "type": "range",
      "id": "video_gap",
      "label": "Video Gap (Desktop)",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "video_gap_mobile",
      "label": "Video Gap (Mobile)",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 20
    },
    {
      "type": "range",
      "id": "video_radius",
      "label": "Video Border Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Two Videos Comparison"
    }
  ]
}
{% endschema %}
