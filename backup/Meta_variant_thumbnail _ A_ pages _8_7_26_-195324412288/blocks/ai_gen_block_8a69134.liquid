{% doc %}
  @prompt
    FAQ search box
{% enddoc %}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-search-box-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-search-box-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-search-box-form-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-search-box-input-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.input_padding }}px;
    padding-right: {{ block.settings.input_padding | plus: 50 }}px;
    font-size: {{ block.settings.font_size }}px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    outline: none;
    transition: border-color 0.3s ease;
    text-align: center;
  }

  .ai-search-box-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
    opacity: 0.7;
  }

  .ai-search-box-input-{{ ai_gen_id }}:focus {
    border-color: {{ block.settings.focus_border_color }};
  }

  .ai-search-box-button-{{ ai_gen_id }} {
    position: absolute;
    right: {{ block.settings.input_padding | divided_by: 2 }}px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ block.settings.icon_color }};
    transition: color 0.3s ease;
  }

  .ai-search-box-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-search-box-button-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-search-box-no-result-{{ ai_gen_id }} {
    display: none;
    margin-top: 16px;
    text-align: center;
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-search-box-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-search-box-input-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<search-box-{{ ai_gen_id }} class="ai-search-box-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-search-box-wrapper-{{ ai_gen_id }}">
    <div role="search" class="ai-search-box-form-{{ ai_gen_id }}">
      <input
        type="search"
        class="ai-search-box-input-{{ ai_gen_id }}"
        placeholder="{{ block.settings.placeholder_text }}"
        aria-label="Search FAQs"
        autocomplete="off"
      >

      <button type="button" class="ai-search-box-button-{{ ai_gen_id }}" aria-label="Search FAQs">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
      </button>
    </div>

    <p class="ai-search-box-no-result-{{ ai_gen_id }}">
      No FAQs found.
    </p>
  </div>
</search-box-{{ ai_gen_id }}>

<script>
  (function() {
    class SearchBox{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.input = this.querySelector('.ai-search-box-input-{{ ai_gen_id }}');
        this.button = this.querySelector('.ai-search-box-button-{{ ai_gen_id }}');
        this.noResult = this.querySelector('.ai-search-box-no-result-{{ ai_gen_id }}');

        if (!this.input) return;

        this.input.addEventListener('input', this.filterFaqs.bind(this));

        if (this.button) {
          this.button.addEventListener('click', this.filterFaqs.bind(this));
        }

        this.input.addEventListener('keydown', function(event) {
          if (event.key === 'Enter') {
            event.preventDefault();
          }
        });
      }

      getFaqItems() {
        return Array.from(document.querySelectorAll(
          `
          .faq-search-item,
          .faq-item,
          .faq__item,
          .faq-block,
          .accordion,
          details,
          .collapsible-content__accordion,
          .collapsible-row,
          [class*="faq-item"],
          [class*="accordion"]
          `
        )).filter((item) => {
          return !this.contains(item) && item.innerText.trim().length > 0;
        });
      }

      filterFaqs() {
        const keyword = this.input.value.toLowerCase().trim();
        const words = keyword.split(/\s+/).filter(Boolean);

        const faqItems = this.getFaqItems();
        let visibleCount = 0;

        faqItems.forEach(function(item) {
          const text = item.innerText.toLowerCase();

          const isMatch =
            words.length === 0 ||
            words.every(function(word) {
              return text.includes(word);
            });

          if (isMatch) {
            item.style.display = '';
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (this.noResult) {
          this.noResult.style.display =
            words.length > 0 && visibleCount === 0 ? 'block' : 'none';
        }
      }
    }

    if (!customElements.get('search-box-{{ ai_gen_id }}')) {
      customElements.define('search-box-{{ ai_gen_id }}', SearchBox{{ ai_gen_id }});
    }
  })();
</script>

{% schema %}
{
  "name": "FAQ search box",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "placeholder_text",
      "label": "Placeholder text",
      "default": "Search FAQs..."
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Input style"
    },
    {
      "type": "range",
      "id": "input_padding",
      "label": "Padding",
      "min": 8,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Font size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "border_thickness",
      "label": "Border thickness",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "placeholder_color",
      "label": "Placeholder",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "focus_border_color",
      "label": "Focus border",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "icon_hover_color",
      "label": "Icon hover color",
      "default": "#2f2953"
    }
  ],
  "presets": [
    {
      "name": "FAQ search box"
    }
  ]
}
{% endschema %}