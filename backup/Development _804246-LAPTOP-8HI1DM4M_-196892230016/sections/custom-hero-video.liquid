{% style %}
#video-text-{{ section.id }} {
  background-color: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  margin-top: {{ section.settings.margin_top }}px;
  margin-bottom: {{ section.settings.margin_bottom }}px;
}

#video-text-{{ section.id }} .video-text-wrapper {
  display: flex;
  align-items: center;
  gap: {{ section.settings.gap }}px;
  position: relative;
}

#video-text-{{ section.id }} .text-content,
#video-text-{{ section.id }} .video-content {
  width: 50%;
    text-align: center;
}

#video-text-{{ section.id }} .video-box {
  height: {{ section.settings.video_height_desktop }};
  overflow: hidden;
  position: relative;
}

#video-text-{{ section.id }} video {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

#video-text-{{ section.id }} .video-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

#video-text-{{ section.id }} .btn-custom {
  display: inline-block;
  background: {{ section.settings.button_bg }};
  color: {{ section.settings.button_text1 }};
  text-decoration: none;
  border-radius: {{ section.settings.br1 }}px;
  margin-top: 15px;
padding: 7px 35px !important;
font-size: 18px !important;
}
#video-text-{{ section.id }} .text-content h2 {
    font-weight: 700;
    text-align: center !important;
    margin-bottom: 10px;
    font-family: 'DM Sans';
    color:black;
}

#video-text-{{ section.id }} .text-content p{
    font-family: "DM Sans", sans-serif;
    width: 100% !important;
    color:black;
    text-align: center;
}

@media (min-width: 768px) {
#video-text-{{ section.id }} .text-content h2 {
    font-size: {{ section.settings.w1 }}px !important;
}
#video-text-{{ section.id }} .text-content p{
    font-size: {{ section.settings.w3 }}px !important;
}
}


/* Mobile View: Text above video & overlay works */
@media (max-width: 768px) {
  #video-text-{{ section.id }} .video-text-wrapper {
    flex-direction: column-reverse;
  }
  #video-text-{{ section.id }} .text-content p{
    font-size: {{ section.settings.w4 }}px !important;
    color:white;
}
  #video-text-{{ section.id }} .video-overlay {
  background-color: {{ section.settings.overlay_color }};
  opacity: {{ section.settings.overlay_opacity }};
  pointer-events: none;
  display: flex;
}
#video-text-{{ section.id }} .text-content h2 {
    font-size: {{ section.settings.w2 }}px !important;
}
.text-content h2 {
    color:black;
}
  #video-text-{{ section.id }} .text-content,
  #video-text-{{ section.id }} .video-content {
    width: 100%;
  }
  #video-text-{{ section.id }} .video-box {
    height: {{ section.settings.video_height_mobile }};
  }

  #video-text-{{ section.id }} .text-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 2;
    text-align: center;
    width: 90%;
  }
}
.video-text-wrapper.page-width{max-width:{{section.settings.page_width }}rem;}
{% endstyle %}

<section id="video-text-{{ section.id }}">
  <div class="page-width-video">
    <div class="video-text-wrapper page-width">

      <!-- Left Content -->
      <div class="text-content">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p>{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="btn-custom">{{ section.settings.button_text }}</a>
        {% endif %}
      </div>

      <!-- Right Video -->
      <div class="video-content">
        <div class="video-box">
       {% if section.settings.custom_video_code != blank %}
  {{ section.settings.custom_video_code }}
{% elsif section.settings.video != blank %}
  {{ section.settings.video | video_tag:
    autoplay: true,
    loop: true,
    muted: true,
    playsinline: true,
    controls: false
  }}
{% endif %}

          <div class="video-overlay"></div>
        </div>
      </div>

    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video With Text",
  "settings": [
    {
      "type":"range",
      "id":"page_width",
      "min":100,
      "max":160,
      "label":"Page width",
      "default":120
    },
    {
      "type": "video",
      "id": "video",
      "label": "Right Side Video"
    },
    {
  "type": "liquid",
  "id": "custom_video_code",
  "label": "Custom Video Embed Code (Wistia, YouTube, etc)",
  "info": "If added, uploaded video will be hidden"
},

      {
      "type": "range",
      "id": "w1",
      "label": "Heading font size desktop",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 50
    },
        {
      "type": "range",
      "id": "w2",
      "label": "Heading font size mobile",
      "min": 12,
      "max": 50,
      "step": 1,
      "default": 40
    },
          {
      "type": "range",
      "id": "w3",
      "label": "Sub Heading font size desktop",
      "min": 12,
      "max": 100,
      "step": 1,
      "default": 18
    },
        {
      "type": "range",
      "id": "w4",
      "label": "Sub Heading font size mobile",
      "min": 12,
      "max": 50,
      "step": 1,
      "default": 20
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Heading Here"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sub Heading",
      "default": "Your sub heading text here"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "video_height_desktop",
      "label": "Video Height Desktop",
      "options": [
        { "value": "540px", "label": "540px" },
        { "value": "600px", "label": "600px" },
        { "value": "800px", "label": "800px" },
        { "value": "auto", "label": "Adapt to video" }
      ],
      "default": "600px"
    },
    {
      "type": "select",
      "id": "video_height_mobile",
      "label": "Video Height Mobile",
      "options": [
        { "value": "450px", "label": "450px" },
        { "value": "600px", "label": "600px" },
        { "value": "800px", "label": "800px" },
        { "value": "auto", "label": "Adapt to video" }
      ],
      "default": "450px"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_text1",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Video Overlay Color",
      "default": "#000000"
    },
        {
      "type": "range",
      "id": "br1",
      "label": "Button Radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Video Overlay Opacity (0-1)",
      "min": 0,
      "max": 1,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 60
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap Between Text & Video",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Video With Text + Overlay"
    }
  ]
}
{% endschema %}
