      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_VbzDbq": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Where does Phoenix Gravity ship to?",
            "icon": "none",
            "row_content": "<p>We currently ship to the UK and all of Europe. We’re working on shipping to more locations. Does not ship to USA.</p>",
            "page": ""
          }
        },
        "collapsible_row_M7UKc4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How much does shipping cost in Europe?",
            "icon": "none",
            "row_content": "<p>We offer free standard shipping on all Filter Systems and orders over £99 to the UK. Shipping costs outside of the UK will depend on local delivery requirements.</p>",
            "page": ""
          }
        },
        "collapsible_row_mzXpPn": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does shipping take in Europe?",
            "icon": "none",
            "row_content": "<p>We work with the best couriers to ensure you receive your products in the quickest, safest way.</p>",
            "page": ""
          }
        },
        "collapsible_row_xURY4X": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How long does UK shipping take?",
            "icon": "none",
            "row_content": "<p>We deliver within the UK in 2-4 working days. Expedited delivery is available at the checkout for an additional fee.</p>",
            "page": ""
          }
        },
        "collapsible_row_fM9ADP": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What’s your return and exchange policy?",
            "icon": "none",
            "row_content": "<p>We'll be able to accept returns initiated within 30 days of purchase. You will be responsible for the safe return of the item, which must arrive in a resealable condition in the original packaging. Once we accept the return we’ll refund you via the original payment method within 7 working days. We also offer a 100 Day Money-back Guarantee on our complete Gravity Water Filter Systems - see below for <a href=\"https://phoenixwaterfilters.co.uk/pages/delivery-and-returns\">more info.</a></p>",
            "page": ""
          }
        },
        "collapsible_row_pQK77H": {
          "type": "collapsible_row",
          "settings": {
            "heading": "My item has arrived damaged or incorrect, what can I do?",
            "icon": "none",
            "row_content": "<p>Please send a photograph of your full order including the packaging along with your order number to our support team at <strong>support@phoenixwaterfilters.co.uk</strong>, and we’ll get back to you as a matter of priority within 24 hours.</p>",
            "page": ""
          }
        }
      },
