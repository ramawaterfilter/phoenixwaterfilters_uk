      "default": "Removes Bacteria & Viruses, No Electricity Required, Cost-Effective, Eco-Friendly, Removes Heavy Metals, Improves Taste, Easy Maintenance, Portable, Long Filter Life, Removes Chlorine, Reduces TDS, NSF Certified, BPA Free, Removes Sediments, UV Protection",
      "info": "Enter up to 15 features separated by commas"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "product_image",
          "label": "Product Image"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "Product Name"
        },
        {
          "type": "checkbox",
          "id": "feature_1",
          "label": "Feature 1",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_2",
          "label": "Feature 2",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_3",
          "label": "Feature 3",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_4",
          "label": "Feature 4",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_5",
          "label": "Feature 5",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_6",
          "label": "Feature 6",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_7",
          "label": "Feature 7",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_8",
          "label": "Feature 8",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_9",
          "label": "Feature 9",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "feature_10",
          "label": "Feature 10",
          "default": true
        }
      ]
