{%- comment -%}
  Renders product variant options with icons from product metafields

  Required product metafields:
  custom.first_icon
  custom.second_icon
  custom.third_icon
{%- endcomment -%}

{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
-%}

{%- for value in option.values -%}
  {%- liquid
    assign swatch_focal_point = null

    if value.swatch.image
      assign image_url = value.swatch.image | image_url: width: 50
      assign swatch_value = 'url(' | append: image_url | append: ')'
      assign swatch_focal_point = value.swatch.image.presentation.focal_point
    elsif value.swatch.color
      assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
    else
      assign swatch_value = null
    endif

    assign option_disabled = true
    if value.available
      assign option_disabled = false
    endif

    assign variant_icon_url = ''
    assign show_icon = false
    assign metafield_key = ''

    comment
      Icon mapping for one variant type with 3 options
      Option 1 = first_icon
      Option 2 = second_icon
      Option 3 = third_icon
    endcomment

    if option.position == 1
      case forloop.index0
        when 0
          assign metafield_key = 'first_icon'
        when 1
          assign metafield_key = 'second_icon'
        when 2
          assign metafield_key = 'third_icon'
      endcase
    endif
    if option.position == 2
      case forloop.index0
        when 0
          assign metafield_key = 'second_first_icon'
        when 1
          assign metafield_key = 'second_second_icon'
        when 2
          assign metafield_key = 'second_third_icon'
      endcase
    endif
    if option.position == 3
      case forloop.index0
        when 0
          assign metafield_key = 'third_first_icon'
        when 1
          assign metafield_key = 'third_second_icon'
        when 2
          assign metafield_key = 'third_third_icon'
      endcase
    endif

    if metafield_key != blank and product.metafields.custom[metafield_key] != blank
      assign variant_icon_url = product.metafields.custom[metafield_key] | image_url: width: 120
      assign show_icon = true
    endif
  -%}

  {%- capture input_id -%}
    {{ section.id }}-{{ option.position }}-{{ forloop.index0 }}
  {%- endcapture -%}

  {%- capture input_name -%}
    {{ option.name }}-{{ option.position }}
  {%- endcapture -%}

  {%- capture input_dataset -%}
    data-product-url="{{ value.product_url }}"
    data-option-value-id="{{ value.id }}"
  {%- endcapture -%}

  {%- capture label_unavailable -%}
    <span class="visually-hidden label-unavailable">
      {{- 'products.product.variant_sold_out_or_unavailable' | t -}}
    </span>
  {%- endcapture -%}

  {%- if picker_type == 'swatch' -%}

    {%- capture help_text -%}
      <span class="visually-hidden">{{ value | escape }}</span>
      {{ label_unavailable }}

      {%- if show_icon and variant_icon_url != blank -%}
        <span class="option-icon variant-icon">
          <img
            src="{{ variant_icon_url }}"
            alt="{{ value | escape }} icon"
            width="24"
            height="24"
            loading="lazy"
          >
        </span>
      {%- endif -%}
    {%- endcapture -%}

    {%
      render 'swatch-input',
      id: input_id,
      name: input_name,
      value: value | escape,
      swatch: value.swatch,
      product_form_id: product_form_id,
      checked: value.selected,
      visually_disabled: option_disabled,
      shape: block.settings.swatch_shape,
      help_text: help_text,
      additional_props: input_dataset
    %}

  {%- elsif picker_type == 'button' -%}

    <div class="variant-option-with-icons">
      <input
        type="radio"
        id="{{ input_id | strip }}"
        name="{{ input_name | escape | strip }}"
        value="{{ value | escape }}"
        form="{{ product_form_id }}"
        {% if value.selected %}checked{% endif %}
        {% if option_disabled %}class="disabled"{% endif %}
        {{ input_dataset }}
      >

      <label
        class="custom-varient variant-label-with-icons image-only-label {% unless show_icon %}no-icon{% endunless %}"
        for="{{ input_id | strip }}"
      >
        <div class="variant-wrapper {% unless show_icon and variant_icon_url != blank %} variant-wrapper--text{% endunless %} ">
          {%- liquid
              assign family_icon = blank
              assign family_icon_url = blank
              assign family_sub_text = blank

              case value
                when '6 Litre  1-2 people'
                  assign family_icon = product.metafields.custom.option_1.value

                when '8 Litre  2-4 people'
                  assign family_icon = product.metafields.custom.option_2.value

                when '12 Litre  4-6 people'
                  assign family_icon = product.metafields.custom.option_3.value
              endcase

              if family_icon != blank
                assign family_icon_url = family_icon | image_url: width: 80
              endif
            -%}

          {%- if show_icon and variant_icon_url != blank -%}
            <span class="image-box">
               <span class="variant-checkmark">
                <svg xmlns="http://www.w3.org/2000/svg" width="27" height="26" viewBox="0 0 27 26" fill="none"><circle cx="13.1233" cy="13" r="13" fill="#153A5B"/><path d="M19.4053 6.60938L10.6961 14.689L7.01288 10.7584L4.57642 13.0415L10.5268 19.3916L21.6696 9.06384L19.4053 6.60938Z" fill="white"/></svg>
              </span>

              <img
                src="{{ variant_icon_url }}"
                alt="{{ value | escape }} icon"
                width="60"
                height="60"
                loading="lazy"
              >
            </span>
            
          {% else %}
            <span class="variant-checkmark">
              <svg xmlns="http://www.w3.org/2000/svg" width="27" height="26" viewBox="0 0 27 26" fill="none">
                <circle cx="13.1233" cy="13" r="13" fill="#153A5B"/>
                <path d="M19.4053 6.60938L10.6961 14.689L7.01288 10.7584L4.57642 13.0415L10.5268 19.3916L21.6696 9.06384L19.4053 6.60938Z" fill="white"/>
              </svg>
            </span>

            {%- if family_icon_url != blank -%}
              <span class="image-box family-icon-box">
                <img
                  src="{{ family_icon_url }}"
                  alt="{{ value | escape }} icon"
                  width="40"
                  height="40"
                  loading="lazy"
                >
              </span>
            {%- endif -%}

            <span class="variant-text-content">
              <span class="variant-name">{{ value }}</span>
            </span>
          {%- endif -%}

          
        </div>

        {{ label_unavailable }}
      </label>
    </div>

  {%- elsif picker_type == 'dropdown' or picker_type == 'swatch_dropdown' -%}

    <option
      id="{{ input_id | strip }}"
      value="{{ value | escape }}"
      {% if value.selected %}selected="selected"{% endif %}
      {% if swatch_value and picker_type == 'swatch_dropdown' %}
        data-option-swatch-value="{{ swatch_value }}"
        {% if swatch_focal_point %}
          data-option-swatch-focal-point="{{ swatch_focal_point }}"
        {% endif %}
      {% endif %}
      {{ input_dataset }}
    >
      {% if option_disabled -%}
        {{- 'products.product.value_unavailable' | t: option_value: value -}}
      {%- else -%}
        {{- value -}}
      {%- endif %}
    </option>

  {%- endif -%}

{%- endfor -%}

<style>
  .variant-option-with-icons {
    width:auto;
  } 

  .variant-option-with-icons input[type="radio"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .product-form__input--pill label.image-only-label {
    padding: 0 !important;
    border: none !important;
    background: transparent !important;
    box-shadow: none !important;
    margin: 0 !important;
    cursor: pointer;
  }

  .variant-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid #2f2953;
    border-radius:50%;
    width:100%;
    padding:10px;
  }

  .top-circle {
    width: 14px;
    height: 14px;
    border-radius: 5px;
    background: #d9d9d9;
    transition: background 0.2s ease;
  }

  .image-box {
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .image-box img {
    object-fit: contain;
    display: block;
  }

  .variant-name {
  display: block !important;
  font-size: 13px;
  line-height: 1.3;
  text-align: center;
  width: 100%;
  color: #000;
  }

  input[type="radio"]:checked + label .variant-wrapper {
    background: #eef0ff;
    border:3px solid #2f2953;
  }

  input[type="radio"]:checked + label .variant-wrapper--text{
    background: #2f2953;
  }

  input[type="radio"]:checked + label .variant-wrapper--text .variant-name{color:#153a5b !important;}

  input[type="radio"].disabled + label {
    opacity: 0.45;
    cursor: not-allowed;
  }

.product-form__input--pill label.image-only-label .variant-name {
  display: block !important;
  visibility: visible !important;
  opacity: 1 !important;
  color: #000 !important;
  font-size: 16px;
  line-height: 1.3;
  text-align: left;
  width:100%;
  margin-top: 4px;
  font-weight:500;
}
  .variant-checkmark{
    width: 2.6rem;
    height: 2.6rem;
    position: absolute;
    top: 0;
    right: 0;
    display:none !important;
  }

  input[type="radio"]:checked + label .variant-checkmark{display:flex !important;}

  @media screen and (max-width: 768px) {
    input[type="radio"] + label .variant-wrapper--text{width:auto !important; min-width:0; flex:1; padding:4px;}

    .product-form__input--pill {
      display: flex;
      flex-wrap: nowrap;
      gap: 6px;
    }

    .variant-option-with-icons {
      width: auto;
    }

    .product-form__input--pill label.image-only-label {
      width: 100% !important;
      display: flex !important;
      justify-content: center;
      align-items: center;
    }

    .image-box {
      width: auto;
      height: auto;
    }

    .image-box img {
      width: 70px;
      height: 70px;
    }

  .variant-name {
    display: block !important;
    font-size: 11px;
    line-height: 1.2;
    width: 100%;
    color: #000;
  }
  .product-form__input--pill label.image-only-label .variant-name {font-size:12px;}
  }
  .variant-wrapper--text{border-radius:5px;}

  .variant-option-with-icons input[type="radio"] {
  display: none;
}

.variant-label-with-icons {
  display: block;
  cursor: pointer;
}

.variant-wrapper--text {
  position: relative;
  min-width: 154px;
  min-height: auto;
  padding: 8px 10px;
  border: 2px solid transparent;
  border-radius: 8px;
  background: #f7f6f4;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
}

.family-icon-box {
  display: block;
}

.family-icon-box img {
  width: 36px;
  height: 36px;
  object-fit: contain;
  border-radius:50%;
  background:#f5f3f1;
  padding:7px;
}

.variant-text-content {
  display: flex;
  flex-direction: column;
  line-height: 1.2;
}

.variant-name {
  font-size: 18px;
  font-weight: 700;
  color: #153a5b;
}

.variant-sub-text {
  margin-top: 5px;
  font-size: 16px;
  font-weight: 600;
  color: #153a5b;
  text-align:left;
}

.variant-option-with-icons input[type="radio"]:checked + label .variant-wrapper {
  border-color: #153a5b;
  background: #fff;
}

.variant-option-with-icons input[type="radio"]:checked + label .variant-checkmark {
  display: block;
}

@media screen and (min-width: 768px) {
    fieldset.js.product-form__input.product-form__input--pill label.image-only-label {
        width: auto !important;
    }
    .variant-wrapper--text {padding:10px;}
    .product-form__input--pill label.image-only-label .variant-name{font-size:14px;}
    .variant-checkmark{right:5px; top:5px;}
    .variant-wrapper--text .variant-checkmark{top: -8px;right: -8px;}
}

@media screen and (max-width:767px){
.variant-wrapper--text {
    position: relative;
    min-width: 0;
    min-height: auto;
    flex: 1;
    padding: 8px 6px;
    border: 2px solid transparent;
    border-radius: 8px;
    background: #f7f6f4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
}

.variant-wrapper--text .variant-checkmark{top: -8px;right: -8px;}
}

.default-template .variant-wrapper--text{min-height:auto;}

</style>

