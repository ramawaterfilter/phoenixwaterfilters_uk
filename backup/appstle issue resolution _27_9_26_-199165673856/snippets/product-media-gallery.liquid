        border-radius: var(--media-radius, 0.4rem);
        background: rgb(var(--color-background));
        cursor: pointer;
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} .kokocarb-thumbnail-button:hover {
        border-color: rgba(var(--color-foreground), 0.55);
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} .kokocarb-thumbnail-button.is-active {
        border: 0.2rem solid rgb(var(--color-foreground));
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} .kokocarb-thumbnail-button img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} .kokocarb-thumbnail-arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 3.6rem;
        margin: 0;
        padding: 0;
        border: 0;
        background: transparent;
        color: rgb(var(--color-foreground));
        cursor: pointer;
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} .kokocarb-thumbnail-arrow svg {
        width: 2rem;
        height: 2rem;
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} .kokocarb-thumbnail-arrow:disabled {
        opacity: 0.3;
        cursor: not-allowed;
      }

      #MediaGallery-{{ section.id }} > #GalleryThumbnails-{{ section.id }},
      #MediaGallery-{{ section.id }} > #GalleryThumbnails2x2-{{ section.id }} {
        display: none !important;
      }

      #MediaGallery-{{ section.id }} > .product__xr-button {
        grid-column: 2;
      }
    }

    @media screen and (max-width: 749px) {
      #KokoCarbVerticalThumbnails-{{ section.id }} {
        display: none !important;
      }
    }
  </style>

  <script>
    (() => {
      'use strict';

      const sectionId = {{ section.id | json }};
      const galleryId = `MediaGallery-${sectionId}`;
      const viewerId = `GalleryViewer-${sectionId}`;
      const sliderId = `Slider-Gallery-${sectionId}`;
      const railId = `KokoCarbVerticalThumbnails-${sectionId}`;

      function initialiseKokoCarbGallery() {
        const gallery = document.getElementById(galleryId);
        const viewer = document.getElementById(viewerId);
        const mainSlider = document.getElementById(sliderId);

        if (!gallery || !viewer || !mainSlider || document.getElementById(railId)) return;

        const rail = document.createElement('div');
        rail.id = railId;
        rail.className = 'kokocarb-vertical-thumbnails';
        rail.setAttribute('aria-label', 'Product image thumbnails');
        rail.innerHTML = `
          <button type="button" class="kokocarb-thumbnail-arrow kokocarb-thumbnail-arrow--up" aria-label="Previous image">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 15L12 9L18 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <ul class="kokocarb-thumbnail-list"></ul>
          <button type="button" class="kokocarb-thumbnail-arrow kokocarb-thumbnail-arrow--down" aria-label="Next image">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>`;

        gallery.insertBefore(rail, viewer);

        const list = rail.querySelector('.kokocarb-thumbnail-list');
        const upButton = rail.querySelector('.kokocarb-thumbnail-arrow--up');
        const downButton = rail.querySelector('.kokocarb-thumbnail-arrow--down');
        let slides = [];
        let currentIndex = 0;
        let slideSignature = '';

        function collectSlides() {
          slides = Array.from(mainSlider.querySelectorAll('.product__media-item')).filter((slide) => {
            return Boolean(slide.dataset.mediaId && slide.querySelector('img'));
          });
        }

        function findActiveIndex() {
          const index = slides.findIndex((slide) => slide.classList.contains('is-active'));
          return index >= 0 ? index : currentIndex;
        }

        function renderWindow() {
          const items = Array.from(list.children);
          if (!items.length) return;

          currentIndex = Math.max(0, Math.min(currentIndex, items.length - 1));
          const visibleCount = Math.min(3, items.length);
          const maximumStart = Math.max(0, items.length - visibleCount);
          const startIndex = Math.min(currentIndex, maximumStart);
          const endIndex = startIndex + visibleCount;

          items.forEach((item, index) => {
            item.hidden = index < startIndex || index >= endIndex;
            const button = item.querySelector('.kokocarb-thumbnail-button');
            const active = index === currentIndex;
            button.classList.toggle('is-active', active);
            if (active) button.setAttribute('aria-current', 'true');
            else button.removeAttribute('aria-current');
          });

          const needsArrows = items.length > 1;
          upButton.hidden = !needsArrows;
          downButton.hidden = !needsArrows;
          upButton.disabled = currentIndex === 0;
          downButton.disabled = currentIndex === items.length - 1;
        }

        function showMainImage(index) {
          collectSlides();
          if (index < 0 || index >= slides.length) return;

          currentIndex = index;
          const targetSlide = slides[index];

          if (typeof gallery.setActiveMedia === 'function') {
            gallery.setActiveMedia(targetSlide.dataset.mediaId, false);
          } else {
            slides.forEach((slide, slideIndex) => {
              slide.classList.toggle('is-active', slideIndex === index);
            });
            mainSlider.scrollTo({ left: targetSlide.offsetLeft, behavior: 'smooth' });
          }

          renderWindow();
        }

        function rebuildThumbnails(force = false) {
          collectSlides();
          const nextSignature = slides.map((slide) => slide.dataset.mediaId).join('|');

          if (!force && nextSignature === slideSignature) {
            currentIndex = findActiveIndex();
            renderWindow();
            return;
          }

          slideSignature = nextSignature;
          list.replaceChildren();

          slides.forEach((slide, index) => {
            const sourceImage = slide.querySelector('img');
            const item = document.createElement('li');
            const button = document.createElement('button');
            const image = document.createElement('img');

            item.className = 'kokocarb-thumbnail-item';
            button.type = 'button';
            button.className = 'kokocarb-thumbnail-button';
            button.setAttribute('aria-label', `Show image ${index + 1}`);
            image.src = sourceImage.currentSrc || sourceImage.src;
            image.alt = sourceImage.alt || '';
            image.loading = 'lazy';

            button.appendChild(image);
            item.appendChild(button);
            list.appendChild(item);
            button.addEventListener('click', () => showMainImage(index));
          });

          currentIndex = findActiveIndex();
          renderWindow();
        }

        upButton.addEventListener('click', () => showMainImage(currentIndex - 1));
        downButton.addEventListener('click', () => showMainImage(currentIndex + 1));

        const observer = new MutationObserver((mutations) => {
          const slidesChanged = mutations.some((mutation) => mutation.type === 'childList');
          window.requestAnimationFrame(() => rebuildThumbnails(slidesChanged));
        });

        observer.observe(mainSlider, {
          subtree: true,
          childList: true,
          attributes: true,
          attributeFilter: ['class']
        });

        document.addEventListener('variant:media:updated', () => {
          window.setTimeout(() => rebuildThumbnails(true), 100);
        });
        document.addEventListener('variant:change', () => {
          window.setTimeout(() => rebuildThumbnails(true), 100);
        });

        rebuildThumbnails(true);
      }

      function prepareKokoCarbStickyMedia() {
        if (!window.matchMedia('(min-width: 750px)').matches) return;

        const productRoot = document.getElementById(`MainProduct-${sectionId}`);
        const sectionRoot = document.getElementById(`shopify-section-${sectionId}`);
        const mediaWrapper = productRoot?.querySelector('.product__media-wrapper');

        if (!productRoot || !sectionRoot || !mediaWrapper) return;

        /* Shopify themes often place overflow:hidden/clip on one of these
           containers. That silently disables position:sticky. Clear it only
           along this product section's ancestor path. */
        let ancestor = mediaWrapper.parentElement;

        while (ancestor) {
          ancestor.style.setProperty('overflow', 'visible', 'important');
          ancestor.style.setProperty('overflow-x', 'visible', 'important');
          ancestor.style.setProperty('overflow-y', 'visible', 'important');

          if (ancestor === sectionRoot) break;
          ancestor = ancestor.parentElement;
        }

        const mainContent = sectionRoot.closest('#MainContent');
        if (mainContent) {
          mainContent.style.setProperty('overflow', 'visible', 'important');
          mainContent.style.setProperty('overflow-x', 'visible', 'important');
          mainContent.style.setProperty('overflow-y', 'visible', 'important');
        }

        /* The live KokoCarb page scrolls on HTML, but Klaviyo applies
           overflow:hidden to BODY. BODY must not become the gallery's
           non-scrolling sticky container. */
        document.body.style.setProperty('overflow-x', 'clip', 'important');
        document.body.style.setProperty('overflow-y', 'visible', 'important');

        mediaWrapper.style.setProperty('position', 'sticky', 'important');
        mediaWrapper.style.setProperty('top', '8rem', 'important');
        mediaWrapper.style.setProperty('align-self', 'flex-start', 'important');
        mediaWrapper.style.setProperty('height', 'max-content', 'important');
        mediaWrapper.style.setProperty('transform', 'none', 'important');
      }

      function start() {
        prepareKokoCarbStickyMedia();
        initialiseKokoCarbGallery();
        window.setTimeout(prepareKokoCarbStickyMedia, 300);
        window.setTimeout(initialiseKokoCarbGallery, 300);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', start, { once: true });
      } else {
        start();
      }

      document.addEventListener('shopify:section:load', start);
    })();
  </script>
