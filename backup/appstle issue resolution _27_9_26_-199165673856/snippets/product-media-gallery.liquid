{% if uses_variant_media %}
  <style>
    [data-variant-media-gallery]:not([data-variant-ready]) .product__media-list,
    [data-variant-media-gallery]:not([data-variant-ready]) .thumbnail-grid-2x2 {
      visibility: hidden;
    }
  </style>
  <script>
  (() => {
    const sectionId = {{ section.id | json }};
    const gallery = document.getElementById('MediaGallery-' + sectionId);
    const slider = document.getElementById('Slider-Gallery-' + sectionId);
    const thumbnailList = document.getElementById('Slider-Thumbnails-' + sectionId);
    const grid = document.getElementById('GalleryThumbnails2x2-' + sectionId);
    const data = JSON.parse(document.getElementById('VariantMediaData-' + sectionId).textContent);
    if (!gallery || !slider) return;
    let currentVariantId = '';

    function selectedVariantId() {
      const form = document.querySelector('#ProductInfo-' + sectionId);
      const variantInput = form?.querySelector('select[name="id"], input[name="id"]');
      return variantInput?.value || new URLSearchParams(location.search).get('variant') || gallery.dataset.selectedVariant;
    }

    function renderVariant(variantId) {
      variantId = String(variantId || selectedVariantId());
      if (!Object.prototype.hasOwnProperty.call(data, variantId) || currentVariantId === variantId) return;
      const media = data[variantId];
      const slides = document.createDocumentFragment();
      const thumbs = document.createDocumentFragment();

      media.forEach((file, index) => {
        const id = `${sectionId}-variant-${variantId}-${index}`;
        const slide = document.createElement('li');
        slide.id = `Slide-${id}`;
        slide.className = `product__media-item grid__item slider__slide${index === 0 ? ' is-active' : ''}`;
        slide.dataset.mediaId = id;
        const frame = document.createElement('div');
        frame.className = 'product__media media global-media-settings';
        frame.style.cssText = 'padding-top:0;aspect-ratio:1;display:flex;align-items:center;justify-content:center';
        if (file.kind === 'video') {
          const video = document.createElement('video');
          video.src = file.src;
          video.poster = file.thumb;
          video.controls = true;
          video.playsInline = true;
          video.style.cssText = 'max-width:100%;max-height:100%;object-fit:contain';
          frame.appendChild(video);
        } else {
          const image = document.createElement('img');
          image.src = file.src;
          image.alt = file.alt || '';
          image.loading = index === 0 ? 'eager' : 'lazy';
          image.style.cssText = 'width:100%;height:100%;object-fit:contain';
          frame.appendChild(image);
        }
        slide.appendChild(frame);
        slides.appendChild(slide);

        const item = document.createElement('li');
        item.id = `Slide-Thumbnails-${id}`;
        item.className = 'thumbnail-list__item slider__slide';
        item.dataset.target = id;
        item.dataset.mediaPosition = index + 1;
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'thumbnail global-media-settings global-media-settings--no-shadow';
        button.setAttribute('aria-label', `Show ${file.kind} ${index + 1}`);
        button.setAttribute('aria-controls', `GalleryViewer-${sectionId}`);
        if (index === 0) button.setAttribute('aria-current', 'true');
        const preview = document.createElement('img');
        preview.src = file.thumb || file.src;
        preview.alt = file.alt || '';
        preview.loading = 'lazy';
        button.appendChild(preview);
        item.appendChild(button);
        thumbs.appendChild(item);
        button.addEventListener('click', () => {
          const target = slider.querySelector(`[data-media-id="${id}"]`);
          slider.querySelectorAll('.product__media-item').forEach(el => el.classList.toggle('is-active', el === target));
          target?.scrollIntoView({behavior: 'smooth', block: 'nearest', inline: 'center'});
          thumbnailList?.querySelectorAll('.thumbnail').forEach(el => el.removeAttribute('aria-current'));
          button.setAttribute('aria-current', 'true');
          slider.closest('slider-component')?.dispatchEvent(new CustomEvent('slideChanged', {detail: {currentElement: target}}));
        });
      });

      slider.replaceChildren(slides);
      thumbnailList?.replaceChildren(thumbs);
      grid?.replaceChildren();
      gallery.querySelector('.slider-counter--total')?.replaceChildren(document.createTextNode(String(media.length)));
      currentVariantId = variantId;
      gallery.dataset.variantReady = 'true';
    }

    renderVariant(gallery.dataset.selectedVariant);
    document.addEventListener('variant:change', event => setTimeout(() => renderVariant(event.detail?.variant?.id), 100));
    document.addEventListener('shopify:variant:change', event => setTimeout(() => renderVariant(event.detail?.variant?.id), 100));
    document.addEventListener('variant:media:updated', event => setTimeout(() => renderVariant(event.detail?.variant?.id || event.detail?.variantId), 100));
    document.querySelectorAll('select[name="id"], input[name="id"], input[type="radio"]').forEach(input => {
      input.addEventListener('change', () => setTimeout(() => renderVariant(selectedVariantId()), 150));
    });
  })();
  </script>
{% endif %}

<script>
(function() {
  'use strict';

  function initGallery(sectionId) {
    const gallery = document.getElementById('MediaGallery-' + sectionId);
    if (!gallery) return;

    const prevBtn = document.getElementById('galleryPrev-' + sectionId);
    const nextBtn = document.getElementById('galleryNext-' + sectionId);
    const slider = document.getElementById('Slider-Gallery-' + sectionId);
    const grid = document.getElementById('GalleryThumbnails2x2-' + sectionId);
    const dotsContainer = gallery.querySelector(
      '[data-gallery-dots]'
    );

    if (!slider) return;

    let currentIndex = 0;
    let allMedia = [];
    let dots = [];

    const MAX_VISIBLE_DOTS = 7;

    /* First media shown inside the 4-thumbnail window */
    let thumbnailStartIndex = 0;

    /* Number of thumbnails visible */
    const thumbnailVisibleCount = 4;

    function refreshMediaData() {
      allMedia = [];
      const slides = slider.querySelectorAll('.product__media-item');
      slides.forEach((slide, index) => {
        const img = slide.querySelector('img');
        const video = slide.querySelector('video');
        if (!img && !video) return;
        allMedia.push({
          element: slide,
          mediaId: slide.dataset.mediaId,
          alt: img?.alt || video?.getAttribute('aria-label') || '',
          src: img?.src || video?.poster || '',
          index
        });
      });
    }

    function groupByAlt(mediaArray) {
      const groups = {};
      mediaArray.forEach(item => {
        if (!groups[item.alt]) groups[item.alt] = [];
        groups[item.alt].push(item);
      });
      return groups;
    }

    function reorderByAlt(targetAlt) {
      if (gallery.hasAttribute('data-variant-media-gallery')) return;
      if (!targetAlt) return;
      const groups = groupByAlt(allMedia);
      const targetGroup = groups[targetAlt] || [];
      const others = allMedia.filter(m => m.alt !== targetAlt);
      const newOrder = [...targetGroup, ...others];
      const fragment = document.createDocumentFragment();
      newOrder.forEach(item => fragment.appendChild(item.element));
      slider.innerHTML = '';
      slider.appendChild(fragment);
      allMedia = newOrder;
    }

    function getActiveIndex() {
      for (let i = 0; i < allMedia.length; i++) {
        if (allMedia[i].element.classList.contains('is-active')) return i;
      }
      return 0;
    }

    function setActiveSlide(index) {
      if (index < 0 || index >= allMedia.length) return;
      allMedia.forEach(item => item.element.classList.remove('is-active'));
      allMedia[index].element.classList.add('is-active');
      currentIndex = index;
      slider.scrollTo({ left: allMedia[index].element.offsetLeft, behavior: 'smooth' });
      updateArrows();
      updateCounter();
      updateGrid();
    }

    function goToSlide(index) {
      setActiveSlide(index);
    }

    /* =========================================================
   MOBILE DOT PAGINATION
========================================================= */

function createDots() {
  if (!dotsContainer) return;

  dotsContainer.innerHTML = '';

  if (allMedia.length <= 1) {
    dotsContainer.hidden = true;
    dots = [];
    return;
  }

  dotsContainer.hidden = false;

  allMedia.forEach((item, index) => {

    const dot = document.createElement('button');

    dot.type = 'button';
    dot.className = 'product-media-mobile-dot';

    dot.dataset.galleryDot = index;

    dot.setAttribute(
      'aria-label',
      'Go to image ' + (index + 1)
    );

    dot.addEventListener('click', function(event) {

      event.preventDefault();
      event.stopPropagation();

      goToSlide(index);

    });

    dotsContainer.appendChild(dot);

  });

  dots = Array.from(
    dotsContainer.querySelectorAll(
      '.product-media-mobile-dot'
    )
  );

  updateDots();
}


function updateDots() {
  if (!dots.length) return;

  /*
   * Show maximum 7 dots.
   *
   * Example:
   *
   * 1 2 3 4 5 6 7
   *
   * then:
   *
   * 2 3 4 5 6 7 8
   */

  let start = Math.max(
    0,
    currentIndex - Math.floor(MAX_VISIBLE_DOTS / 2)
  );

  let end = Math.min(
    dots.length,
    start + MAX_VISIBLE_DOTS
  );

  /*
   * Keep 7 visible when reaching
   * the end of the gallery.
   */
  if (
    end - start <
    MAX_VISIBLE_DOTS
  ) {

    start = Math.max(
      0,
      end - MAX_VISIBLE_DOTS
    );

  }

  dots.forEach((dot, index) => {

    const isActive =
      index === currentIndex;

    const isVisible =
      index >= start &&
      index < end;

    dot.classList.toggle(
      'is-active',
      isActive
    );

    dot.classList.toggle(
      'is-hidden-dot',
      !isVisible
    );

    if (isActive) {

      dot.setAttribute(
        'aria-current',
        'true'
      );

    } else {

      dot.removeAttribute(
        'aria-current'
      );

    }

  });
}

    function updateArrows() {
      if (!prevBtn || !nextBtn) return;
      prevBtn.disabled = currentIndex === 0;
      nextBtn.disabled = currentIndex === allMedia.length - 1;
    }

    function updateCounter() {
      const counter = gallery.querySelector('.slider-counter--current');
      if (counter) counter.textContent = currentIndex + 1;
    }

    function updateGrid() {
        if (!grid || !allMedia.length) return;

        if (currentIndex < thumbnailStartIndex) {
          thumbnailStartIndex = currentIndex;
        }

        if (
          currentIndex >=
          thumbnailStartIndex + thumbnailVisibleCount
        ) {
          thumbnailStartIndex =
            currentIndex - thumbnailVisibleCount + 1;
        }

        /*
        * Prevent empty space when reaching
        * the end of the gallery.
        */
        const maxStart = Math.max(
          0,
          allMedia.length - thumbnailVisibleCount
        );

        thumbnailStartIndex = Math.min(
          thumbnailStartIndex,
          maxStart
        );

        thumbnailStartIndex = Math.max(
          0,
          thumbnailStartIndex
        );

        const display = allMedia.slice(
          thumbnailStartIndex,
          thumbnailStartIndex + thumbnailVisibleCount
        );

        grid.innerHTML = '';

        display.forEach(item => {

          const btn = document.createElement('button');

          btn.type = 'button';
          btn.className = 'thumbnail-2x2-item';

          if (
            item.mediaId ===
            allMedia[currentIndex]?.mediaId
          ) {
            btn.classList.add('is-active');
          }

          const img = document.createElement('img');

          img.src = item.src;
          img.alt = item.alt;
          img.loading = 'lazy';

          btn.appendChild(img);
          grid.appendChild(btn);

          btn.onclick = () => {

            const idx = allMedia.findIndex(
              media => media.mediaId === item.mediaId
            );

            if (idx !== -1) {
              goToSlide(idx);
            }

          };

        });
      }

    function handleVariantChange() {
      setTimeout(() => {
        refreshMediaData();
         thumbnailStartIndex = 0;
        const activeIndex = getActiveIndex();
        const alt = allMedia[activeIndex]?.alt || '';
        if (alt) {
          reorderByAlt(alt);
          const newIndex = getActiveIndex();
          currentIndex = newIndex !== -1 ? newIndex : 0;
        }
        createDots();
        updateArrows();
        updateCounter();
        updateDots();
        updateGrid();
      }, 400);
    }

    function setupVariantListeners() {
      document.addEventListener('variant:change', () => setTimeout(handleVariantChange, 200));
      document.addEventListener('shopify:variant:change', () => setTimeout(handleVariantChange, 200));
      document.querySelectorAll('select[name="id"]').forEach(el => {
        el.addEventListener('change', () => setTimeout(handleVariantChange, 200));
      });
      document.querySelectorAll('input[type="radio"]').forEach(el => {
        el.addEventListener('change', () => setTimeout(handleVariantChange, 200));
      });
      const observer = new MutationObserver(() => setTimeout(handleVariantChange, 300));
      observer.observe(slider, { childList: true, subtree: true });
    }

    function setupTouchSwipe() {
      let touchStartX = 0;
      let touchStartY = 0;
      let isDragging = false;

      slider.addEventListener('touchstart', function(e) {
        touchStartX = e.changedTouches[0].clientX;
        touchStartY = e.changedTouches[0].clientY;
        isDragging = false;
      }, { passive: true });

      slider.addEventListener('touchmove', function(e) {
        const deltaX = Math.abs(e.changedTouches[0].clientX - touchStartX);
        const deltaY = Math.abs(e.changedTouches[0].clientY - touchStartY);
        if (deltaX > deltaY && deltaX > 10) {
          isDragging = true;
          e.preventDefault();
        }
      }, { passive: false });

      slider.addEventListener('touchend', function(e) {
        if (!isDragging) return;
        const diff = touchStartX - e.changedTouches[0].clientX;
        if (diff > 50) goToSlide(currentIndex + 1);
        else if (diff < -50) goToSlide(currentIndex - 1);
        isDragging = false;
      }, { passive: true });
    }

    if (prevBtn) prevBtn.onclick = () => goToSlide(currentIndex - 1);
    if (nextBtn) nextBtn.onclick = () => goToSlide(currentIndex + 1);

    function init() {
      refreshMediaData();

      const active = getActiveIndex();

      const alt = allMedia[active]?.alt || '';

      if (alt) {
        reorderByAlt(alt);
      }

      currentIndex = getActiveIndex();

      /* Create mobile pagination */
      createDots();

      updateArrows();
      updateCounter();
      updateDots();
      updateGrid();
      setupVariantListeners();
      setupTouchSwipe();
    }

    init();
  }

  function initAll() {
    document.querySelectorAll('[id^="MediaGallery-"]').forEach(g => {
      const id = g.id.replace('MediaGallery-', '');
      initGallery(id);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

})();


// ============================================================
// MODAL FULLSCREEN — Arrows + Close Button + Keyboard + Swipe
// ============================================================
(function() {
  'use strict';

  function injectModalControls(modal) {
    if (modal.dataset.customControlsInjected) return;
    modal.dataset.customControlsInjected = 'true';

    const closeBtn = document.createElement('button');
    closeBtn.className = 'modal-custom-close';
    closeBtn.setAttribute('aria-label', 'Close');
    closeBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>`;
    closeBtn.onclick = () => closeModal(modal);
    modal.appendChild(closeBtn);

    const prevBtn = document.createElement('button');
    prevBtn.className = 'modal-custom-arrow modal-custom-arrow--prev';
    prevBtn.setAttribute('aria-label', 'Previous');
    prevBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    prevBtn.onclick = () => navigateModal(modal, -1);
    modal.appendChild(prevBtn);

    const nextBtn = document.createElement('button');
    nextBtn.className = 'modal-custom-arrow modal-custom-arrow--next';
    nextBtn.setAttribute('aria-label', 'Next');
    nextBtn.innerHTML = `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
    nextBtn.onclick = () => navigateModal(modal, 1);
    modal.appendChild(nextBtn);

    setupModalSwipe(modal);
  }

  function closeModal(modal) {
    const closeNative = modal.querySelector('[data-close-modal], .modal__close-button, button[aria-label="Close dialog"]');
    if (closeNative) { closeNative.click(); return; }
    modal.removeAttribute('open');
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }

  function getModalSlides(modal) {
    return Array.from(modal.querySelectorAll(
      '.product-media-modal__content > *, .modal__content .product__media-item, [data-media-id], .slider__slide'
    )).filter(el => el.offsetHeight > 0);
  }

  function getModalActiveIndex(slides) {
    for (let i = 0; i < slides.length; i++) {
      if (slides[i].classList.contains('is-active') ||
          slides[i].getAttribute('aria-hidden') === 'false' ||
          slides[i].hasAttribute('active')) return i;
    }
    return 0;
  }

  function navigateModal(modal, direction) {
    const slides = getModalSlides(modal);
    if (!slides.length) return;

    if (direction === 1) {
      const nativeNext = modal.querySelector('.slider-button--next, [name="next"]');
      if (nativeNext) { nativeNext.click(); return; }
    } else {
      const nativePrev = modal.querySelector('.slider-button--prev, [name="previous"]');
      if (nativePrev) { nativePrev.click(); return; }
    }

    let current = getModalActiveIndex(slides);
    let next = current + direction;
    if (next < 0) next = slides.length - 1;
    if (next >= slides.length) next = 0;
    slides.forEach(s => s.classList.remove('is-active'));
    slides[next].classList.add('is-active');
    slides[next].scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
  }

  function setupModalSwipe(modal) {
    let startX = 0, startY = 0, dragging = false;
    modal.addEventListener('touchstart', function(e) {
      startX = e.changedTouches[0].clientX;
      startY = e.changedTouches[0].clientY;
      dragging = false;
    }, { passive: true });
    modal.addEventListener('touchmove', function(e) {
      const dx = Math.abs(e.changedTouches[0].clientX - startX);
      const dy = Math.abs(e.changedTouches[0].clientY - startY);
      if (dx > dy && dx > 10) { dragging = true; e.preventDefault(); }
    }, { passive: false });
    modal.addEventListener('touchend', function(e) {
      if (!dragging) return;
      const diff = startX - e.changedTouches[0].clientX;
      if (diff > 50) navigateModal(modal, 1);
      else if (diff < -50) navigateModal(modal, -1);
      dragging = false;
    }, { passive: true });
  }

  document.addEventListener('keydown', function(e) {
    const modal = document.querySelector(
      'product-media-modal[open], .product-media-modal[open], dialog[open].product-media-modal, #ProductModal:not([hidden])'
    );
    if (!modal) return;
    if (e.key === 'ArrowRight') navigateModal(modal, 1);
    else if (e.key === 'ArrowLeft') navigateModal(modal, -1);
    else if (e.key === 'Escape') closeModal(modal);
  });

  const bodyObserver = new MutationObserver(() => {
    const modals = document.querySelectorAll(
      'product-media-modal, .product-media-modal, #ProductModal, [id*="ProductModal"], [id*="MediaModal"]'
    );
    modals.forEach(modal => {
      const isOpen =
        modal.hasAttribute('open') ||
        modal.getAttribute('aria-hidden') === 'false' ||
        (!modal.hidden && modal.offsetHeight > 0 && getComputedStyle(modal).display !== 'none');
      if (isOpen) injectModalControls(modal);
    });
  });

  bodyObserver.observe(document.body, {
    attributes: true,
    subtree: true,
    attributeFilter: ['open', 'aria-hidden', 'hidden', 'style', 'class']
  });

})();


// ============================================================
// CUSTOM VIDEO FULLSCREEN MODAL
// Native browser fullscreen ke bajay apna modal use karta hai
// Jisme cross button + prev/next arrows dikh sakte hain
// ============================================================
(function() {
  'use strict';

  const modal    = document.getElementById('custom-video-modal');
  const cvmVideo = document.getElementById('cvm-video');
  const cvmClose = document.getElementById('cvm-close');
  const cvmPrev  = document.getElementById('cvm-prev');
  const cvmNext  = document.getElementById('cvm-next');
  const cvmCounter = document.getElementById('cvm-counter');

  if (!modal || !cvmVideo) return;

  // All gallery slides (collected fresh each time)
  function getAllSlides() {
    return Array.from(document.querySelectorAll('.product__media-item'));
  }

  function getCurrentIndex() {
    const slides = getAllSlides();
    return slides.findIndex(s => s.classList.contains('is-active'));
  }

  // ── Open modal with a given video source ──
  function openModal(videoSrc, currentIdx, total) {
    cvmVideo.src = videoSrc;
    cvmVideo.load();
    cvmVideo.play().catch(() => {});

    modal.classList.add('open');
    document.body.style.overflow = 'hidden';

    updateModalUI(currentIdx, total);

    // Trap focus
    setTimeout(() => cvmClose.focus(), 100);
  }

  // ── Close modal ──
  function closeModal() {
    cvmVideo.pause();
    cvmVideo.src = '';
    modal.classList.remove('open');
    document.body.style.overflow = '';
  }

  // ── Update counter + arrow visibility ──
  function updateModalUI(idx, total) {
    if (cvmCounter) {
      cvmCounter.textContent = total > 1 ? (idx + 1) + ' / ' + total : '';
    }
    cvmPrev.classList.toggle('hidden', total <= 1);
    cvmNext.classList.toggle('hidden', total <= 1);
  }

  // ── Navigate slides from modal ──
  function navigateSlide(direction) {
    const slides = getAllSlides();
    const currentIdx = getCurrentIndex();
    const nextIdx = currentIdx + direction;

    if (nextIdx < 0 || nextIdx >= slides.length) return;

    // Check if next slide has a video
    const nextSlide = slides[nextIdx];
    const nextVideo = nextSlide.querySelector('video');
    const nextSrc = nextVideo ? (nextVideo.currentSrc || nextVideo.src || nextVideo.querySelector('source')?.src) : null;

    // Update active slide in gallery
    slides.forEach(s => s.classList.remove('is-active'));
    nextSlide.classList.add('is-active');
    nextSlide.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });

    // Update gallery counters
    document.querySelectorAll('.slider-counter--current').forEach(el => {
      el.textContent = nextIdx + 1;
    });

    // Update gallery prev/next arrow states
    document.querySelectorAll('[id^="galleryPrev-"]').forEach(btn => btn.disabled = nextIdx === 0);
    document.querySelectorAll('[id^="galleryNext-"]').forEach(btn => btn.disabled = nextIdx === slides.length - 1);

    if (nextSrc) {
      // Next slide is also a video — stay in modal
      cvmVideo.src = nextSrc;
      cvmVideo.load();
      cvmVideo.play().catch(() => {});
      updateModalUI(nextIdx, slides.length);
    } else {
      // Next slide is an image — close modal
      closeModal();
    }
  }

  // ── Button events ──
  cvmClose.onclick = closeModal;
  cvmPrev.onclick  = () => navigateSlide(-1);
  cvmNext.onclick  = () => navigateSlide(1);

  // ── Keyboard ──
  document.addEventListener('keydown', function(e) {
    if (!modal.classList.contains('open')) return;
    if (e.key === 'Escape')      { closeModal(); }
    else if (e.key === 'ArrowRight') { navigateSlide(1); }
    else if (e.key === 'ArrowLeft')  { navigateSlide(-1); }
  });

  // ── Touch swipe inside modal ──
  let touchStartX = 0, isDragging = false;
  modal.addEventListener('touchstart', e => {
    touchStartX = e.changedTouches[0].clientX;
    isDragging = false;
  }, { passive: true });
  modal.addEventListener('touchmove', e => {
    if (Math.abs(e.changedTouches[0].clientX - touchStartX) > 10) isDragging = true;
  }, { passive: true });
  modal.addEventListener('touchend', e => {
    if (!isDragging) return;
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (diff > 50) navigateSlide(1);
    else if (diff < -50) navigateSlide(-1);
    isDragging = false;
  }, { passive: true });

  // ── Intercept fullscreen button clicks on videos ──
  // We intercept the native fullscreen expand icon (⛶) click
  // by listening to fullscreenchange and immediately exiting + opening our modal
  function interceptVideoFullscreen(videoEl) {
    if (videoEl.dataset.cvmIntercepted) return;
    videoEl.dataset.cvmIntercepted = 'true';

    // Method 1: Listen for fullscreenchange — exit immediately and open our modal
    const handleFullscreen = function() {
      const fsEl = document.fullscreenElement || document.webkitFullscreenElement;
      if (fsEl && (fsEl === videoEl || fsEl.contains(videoEl))) {
        // Exit native fullscreen immediately
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();

        // Open our custom modal
        const src = videoEl.currentSrc || videoEl.src || videoEl.querySelector('source')?.src || '';
        if (src) {
          const slides = getAllSlides();
          const slide = videoEl.closest('.product__media-item');
          const idx = slide ? slides.indexOf(slide) : getCurrentIndex();
          openModal(src, idx >= 0 ? idx : 0, slides.length);
        }
      }
    };

    document.addEventListener('fullscreenchange', handleFullscreen);
    document.addEventListener('webkitfullscreenchange', handleFullscreen);

    // Method 2: Also intercept double-click (some browsers go fullscreen on dblclick)
    videoEl.addEventListener('dblclick', function(e) {
      e.preventDefault();
      e.stopPropagation();
      const src = videoEl.currentSrc || videoEl.src || videoEl.querySelector('source')?.src || '';
      if (src) {
        const slides = getAllSlides();
        const slide = videoEl.closest('.product__media-item');
        const idx = slide ? slides.indexOf(slide) : getCurrentIndex();
        openModal(src, idx >= 0 ? idx : 0, slides.length);
      }
    });
  }

  // ── Add a custom "expand" button next to each video ──
  function addExpandButton(videoEl) {
    const container = videoEl.closest('.product__media-item, .deferred-media, [class*="media"]');
    if (!container) return;
    if (container.querySelector('.cvm-expand-btn')) return; // already added

    const expandBtn = document.createElement('button');
    expandBtn.className = 'cvm-expand-btn';
    expandBtn.setAttribute('aria-label', 'Open fullscreen');
    expandBtn.setAttribute('type', 'button');
    expandBtn.innerHTML = `
      <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>`;

    expandBtn.onclick = function(e) {
      e.stopPropagation();
      const src = videoEl.currentSrc || videoEl.src || videoEl.querySelector('source')?.src || '';
      if (src) {
        const slides = getAllSlides();
        const slide = videoEl.closest('.product__media-item');
        const idx = slide ? slides.indexOf(slide) : getCurrentIndex();
        openModal(src, idx >= 0 ? idx : 0, slides.length);
      }
    };

    // Position container relatively if not already
    const pos = getComputedStyle(container).position;
    if (pos === 'static') container.style.position = 'relative';

    container.appendChild(expandBtn);
  }

  // ── Scan for videos and set up interception ──
  function setupVideos() {
    document.querySelectorAll('.product__media-list video, .product__media-item video').forEach(video => {
      interceptVideoFullscreen(video);
      addExpandButton(video);
    });
  }

  // ── Init + watch for dynamically loaded videos ──
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupVideos);
  } else {
    setupVideos();
  }

  // Watch for deferred media loading
  const videoObserver = new MutationObserver(() => {
    setupVideos();
  });
  videoObserver.observe(document.body, { childList: true, subtree: true });

})();
</script>

<script>
(function() {
  'use strict';


  /* =========================================================
     INITIALIZE PRODUCT GALLERY
  ========================================================= */

  function initGallery(sectionId) {

    const gallery =
      document.getElementById(
        'MediaGallery-' + sectionId
      );

    if (!gallery) return;


    const prevBtn =
      document.getElementById(
        'galleryPrev-' + sectionId
      );


    const nextBtn =
      document.getElementById(
        'galleryNext-' + sectionId
      );


    const slider =
      document.getElementById(
        'Slider-Gallery-' + sectionId
      );


    const grid =
      document.getElementById(
        'GalleryThumbnails2x2-' + sectionId
      );


    const dotsContainer =
      gallery.querySelector(
        '[data-gallery-dots]'
      );


    if (!slider) return;



    /* =========================================================
       VARIABLES
    ========================================================= */

    let currentIndex = 0;

    let allMedia = [];


    /* 4 thumbnail moving window */
    let thumbnailStartIndex = 0;

    const thumbnailVisibleCount = 4;


    /* Mobile dots */
    const MAX_VISIBLE_DOTS = 7;



    /* =========================================================
       REFRESH MEDIA DATA
    ========================================================= */

    function refreshMediaData() {

      allMedia = [];


      const slides =
        slider.querySelectorAll(
          '.product__media-item'
        );


      slides.forEach(
        (slide, index) => {

          const img =
            slide.querySelector('img');


          /*
           * Videos might not have a normal image
           * directly available.
           */
          const video =
            slide.querySelector('video');


          const preview =
            img || video;


          if (!preview) return;


          allMedia.push({

            element: slide,

            mediaId:
              slide.dataset.mediaId,

            alt:
              img?.alt || '',

            src:
              img?.src || video?.poster || '',

            index: index

          });

        }
      );

    }



    /* =========================================================
       GROUP MEDIA BY ALT
    ========================================================= */

    function groupByAlt(mediaArray) {

      const groups = {};


      mediaArray.forEach(item => {

        const key =
          item.alt || '';


        if (!groups[key]) {

          groups[key] = [];

        }


        groups[key].push(item);

      });


      return groups;

    }



    /* =========================================================
       REORDER MEDIA BASED ON ACTIVE ALT
    ========================================================= */

    function reorderByAlt(targetAlt) {
      if (gallery.hasAttribute('data-variant-media-gallery')) return;

      if (!targetAlt) return;


      const groups =
        groupByAlt(allMedia);


      const targetGroup =
        groups[targetAlt] || [];


      const others =
        allMedia.filter(
          media =>
            media.alt !== targetAlt
        );


      const newOrder = [
        ...targetGroup,
        ...others
      ];


      const fragment =
        document.createDocumentFragment();


      newOrder.forEach(item => {

        fragment.appendChild(
          item.element
        );

      });


      slider.innerHTML = '';

      slider.appendChild(
        fragment
      );


      allMedia = newOrder;

    }



    /* =========================================================
       GET ACTIVE IMAGE INDEX
    ========================================================= */

    function getActiveIndex() {

      for (
        let i = 0;
        i < allMedia.length;
        i++
      ) {

        if (
          allMedia[i]
            .element
            .classList
            .contains('is-active')
        ) {

          return i;

        }

      }


      return 0;

    }



    /* =========================================================
       UPDATE PREVIOUS / NEXT ARROWS
    ========================================================= */

    function updateArrows() {

      if (!prevBtn || !nextBtn) {
        return;
      }


      prevBtn.disabled =
        currentIndex <= 0;


      nextBtn.disabled =
        currentIndex >=
        allMedia.length - 1;

    }



    /* =========================================================
       UPDATE NUMBER COUNTER
    ========================================================= */

    function updateCounter() {

      const currentCounter =
        gallery.querySelector(
          '.slider-counter--current'
        );


      const totalCounter =
        gallery.querySelector(
          '.slider-counter--total'
        );


      if (currentCounter) {

        currentCounter.textContent =
          currentIndex + 1;

      }


      if (totalCounter) {

        totalCounter.textContent =
          allMedia.length;

      }

    }



    /* =========================================================
       MOBILE DOT PAGINATION
       MAXIMUM 7 DOTS
    ========================================================= */

    function updateDots() {

      if (!dotsContainer) return;


      /*
       * No pagination required
       * for one image.
       */
      if (allMedia.length <= 1) {

        dotsContainer.hidden = true;

        dotsContainer.innerHTML = '';

        return;

      }


      dotsContainer.hidden = false;



      /*
       * Determine which group of 7
       * should currently be displayed.
       *
       * 1-7
       *
       * When image 8 is active:
       * 2-8
       *
       * Image 9:
       * 3-9
       */

      let startIndex = 0;


      if (
        allMedia.length >
        MAX_VISIBLE_DOTS
      ) {

        startIndex =
          currentIndex -
          MAX_VISIBLE_DOTS +
          1;


        if (startIndex < 0) {

          startIndex = 0;

        }


        const maxStart =
          allMedia.length -
          MAX_VISIBLE_DOTS;


        if (
          startIndex >
          maxStart
        ) {

          startIndex =
            maxStart;

        }

      }



      const endIndex =
        Math.min(

          startIndex +
          MAX_VISIBLE_DOTS,

          allMedia.length

        );



      /*
       * Rebuild the visible dots.
       *
       * Only maximum 7 actual buttons
       * exist at any time.
       */

      dotsContainer.innerHTML = '';



      for (
        let mediaIndex = startIndex;
        mediaIndex < endIndex;
        mediaIndex++
      ) {

        const dot =
          document.createElement(
            'button'
          );


        dot.type = 'button';


        dot.className =
          'product-media-mobile-dot';


        /*
         * IMPORTANT:
         *
         * This is the real gallery index.
         *
         * Example:
         * Image 8 = index 7
         * Image 9 = index 8
         */

        dot.dataset.galleryDot =
          mediaIndex;


        dot.setAttribute(
          'aria-label',
          'Go to media ' +
          (mediaIndex + 1)
        );



        /* Active dot */
        if (
          mediaIndex ===
          currentIndex
        ) {

          dot.classList.add(
            'is-active'
          );


          dot.setAttribute(
            'aria-current',
            'true'
          );

        }



        /* =============================================
           CLICK DOT
        ============================================= */

        dot.addEventListener(
          'click',
          function(event) {

            event.preventDefault();

            event.stopPropagation();


            const targetIndex =
              parseInt(
                this.dataset.galleryDot,
                10
              );


            if (
              Number.isNaN(
                targetIndex
              )
            ) {

              return;

            }


            goToSlide(
              targetIndex
            );

          }
        );


        dotsContainer.appendChild(
          dot
        );

      }

    }



    /* =========================================================
       UPDATE 4 THUMBNAILS
    ========================================================= */

    function updateGrid() {

      if (
        !grid ||
        !allMedia.length
      ) {

        return;

      }



      /*
       * Keep active image inside
       * the visible 4 thumbnails.
       */

      if (
        currentIndex <
        thumbnailStartIndex
      ) {

        thumbnailStartIndex =
          currentIndex;

      }



      if (
        currentIndex >=
        thumbnailStartIndex +
        thumbnailVisibleCount
      ) {

        thumbnailStartIndex =
          currentIndex -
          thumbnailVisibleCount +
          1;

      }



      const maxStart =
        Math.max(

          0,

          allMedia.length -
          thumbnailVisibleCount

        );



      thumbnailStartIndex =
        Math.min(
          thumbnailStartIndex,
          maxStart
        );


      thumbnailStartIndex =
        Math.max(
          thumbnailStartIndex,
          0
        );



      const display =
        allMedia.slice(

          thumbnailStartIndex,

          thumbnailStartIndex +
          thumbnailVisibleCount

        );



      grid.innerHTML = '';



      display.forEach(item => {

        const btn =
          document.createElement(
            'button'
          );


        btn.type = 'button';


        btn.className =
          'thumbnail-2x2-item';



        if (
          item.mediaId ===
          allMedia[currentIndex]
            ?.mediaId
        ) {

          btn.classList.add(
            'is-active'
          );

        }



        /*
         * Only add image when
         * preview image exists.
         */

        if (item.src) {

          const img =
            document.createElement(
              'img'
            );


          img.src =
            item.src;


          img.alt =
            item.alt || '';


          img.loading =
            'lazy';


          btn.appendChild(
            img
          );

        }



        grid.appendChild(
          btn
        );



        btn.addEventListener(
          'click',
          function() {

            const index =
              allMedia.findIndex(
                media =>
                  media.mediaId ===
                  item.mediaId
              );


            if (index !== -1) {

              goToSlide(index);

            }

          }
        );

      });

    }



    /* =========================================================
       SET ACTIVE SLIDE
    ========================================================= */

    function setActiveSlide(index) {

      if (
        index < 0 ||
        index >= allMedia.length
      ) {

        return;

      }



      allMedia.forEach(item => {

        item.element
          .classList
          .remove('is-active');

      });



      const activeItem =
        allMedia[index];


      activeItem
        .element
        .classList
        .add('is-active');



      currentIndex =
        index;



      /*
       * Scroll main gallery
       */

      slider.scrollTo({

        left:
          activeItem
            .element
            .offsetLeft,

        behavior:
          'smooth'

      });



      /* Update everything */

      updateArrows();

      updateCounter();

      updateDots();

      updateGrid();

    }



    /* =========================================================
       GO TO SLIDE
    ========================================================= */

    function goToSlide(index) {

      setActiveSlide(index);

    }



    /* =========================================================
       VARIANT CHANGE
    ========================================================= */

    function handleVariantChange() {

      setTimeout(
        function() {


          refreshMediaData();


          if (!allMedia.length) {
            return;
          }



          /*
           * Reset thumbnail window
           * after variant changes.
           */

          thumbnailStartIndex = 0;



          const activeIndex =
            getActiveIndex();



          const activeAlt =
            allMedia[
              activeIndex
            ]?.alt || '';



          if (activeAlt) {

            reorderByAlt(
              activeAlt
            );

          }



          /*
           * Recalculate active index
           * after media reorder.
           */

          const newIndex =
            getActiveIndex();



          currentIndex =
            newIndex >= 0
              ? newIndex
              : 0;



          updateArrows();

          updateCounter();

          updateDots();

          updateGrid();


        },
        400
      );

    }



    /* =========================================================
       VARIANT EVENT LISTENERS
    ========================================================= */

    function setupVariantListeners() {


      document.addEventListener(
        'variant:change',
        function() {

          setTimeout(
            handleVariantChange,
            200
          );

        }
      );



      document.addEventListener(
        'shopify:variant:change',
        function() {

          setTimeout(
            handleVariantChange,
            200
          );

        }
      );



      document
        .querySelectorAll(
          'select[name="id"]'
        )
        .forEach(select => {

          select.addEventListener(
            'change',
            function() {

              setTimeout(
                handleVariantChange,
                200
              );

            }
          );

        });



      document
        .querySelectorAll(
          'input[type="radio"]'
        )
        .forEach(radio => {

          radio.addEventListener(
            'change',
            function() {

              setTimeout(
                handleVariantChange,
                200
              );

            }
          );

        });

    }



    /* =========================================================
       MOBILE TOUCH / SWIPE
    ========================================================= */

    function setupTouchSwipe() {

      let touchStartX = 0;

      let touchStartY = 0;

      let isDragging = false;



      slider.addEventListener(
        'touchstart',
        function(event) {

          touchStartX =
            event
              .changedTouches[0]
              .clientX;


          touchStartY =
            event
              .changedTouches[0]
              .clientY;


          isDragging = false;

        },
        {
          passive: true
        }
      );



      slider.addEventListener(
        'touchmove',
        function(event) {

          const currentX =
            event
              .changedTouches[0]
              .clientX;


          const currentY =
            event
              .changedTouches[0]
              .clientY;


          const deltaX =
            Math.abs(
              currentX -
              touchStartX
            );


          const deltaY =
            Math.abs(
              currentY -
              touchStartY
            );


          if (
            deltaX > deltaY &&
            deltaX > 10
          ) {

            isDragging = true;

            event.preventDefault();

          }

        },
        {
          passive: false
        }
      );



      slider.addEventListener(
        'touchend',
        function(event) {

          if (!isDragging) {

            return;

          }


          const endX =
            event
              .changedTouches[0]
              .clientX;


          const difference =
            touchStartX -
            endX;



          /*
           * Swipe left
           */
          if (
            difference > 50
          ) {

            goToSlide(
              currentIndex + 1
            );

          }



          /*
           * Swipe right
           */
          else if (
            difference < -50
          ) {

            goToSlide(
              currentIndex - 1
            );

          }



          isDragging = false;

        },
        {
          passive: true
        }
      );

    }



    /* =========================================================
       ARROW EVENTS
    ========================================================= */

    if (prevBtn) {

      prevBtn.addEventListener(
        'click',
        function() {

          goToSlide(
            currentIndex - 1
          );

        }
      );

    }



    if (nextBtn) {

      nextBtn.addEventListener(
        'click',
        function() {

          goToSlide(
            currentIndex + 1
          );

        }
      );

    }



    /* =========================================================
       INITIALIZE
    ========================================================= */

    function init() {


      refreshMediaData();


      if (!allMedia.length) {

        return;

      }



      const active =
        getActiveIndex();



      const alt =
        allMedia[
          active
        ]?.alt || '';



      if (alt) {

        reorderByAlt(
          alt
        );

      }



      currentIndex =
        getActiveIndex();



      thumbnailStartIndex =
        0;



      updateArrows();

      updateCounter();

      updateDots();

      updateGrid();


      setupVariantListeners();

      setupTouchSwipe();

    }



    init();

  }



  /* =========================================================
     INITIALIZE ALL PRODUCT GALLERIES
  ========================================================= */

  function initAll() {

    document
      .querySelectorAll(
        '[id^="MediaGallery-"]'
      )
      .forEach(gallery => {


        const sectionId =
          gallery.id.replace(
            'MediaGallery-',
            ''
          );


        initGallery(
          sectionId
        );

      });

  }



  if (
    document.readyState ===
    'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      initAll
    );

  } else {

    initAll();

  }


})();
</script>


{%- comment -%}
  KokoCarb vertical thumbnail gallery — standalone version
  Remove the earlier KokoCarb add-on, then paste this complete block at the
  very bottom of product-media-gallery.liquid.
