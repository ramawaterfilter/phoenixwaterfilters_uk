{% comment %} {% if template.suffix == 'kokocarb' %}
  <style>
    @media screen and (min-width: 750px) {
      /* Klaviyo leaves overflow:hidden on the body while HTML remains the
         real scrolling element. That body overflow prevents every child
         position:sticky element from sticking. "clip" prevents horizontal
         spill without creating a competing scroll container. */
      body.template-kokocarb {
        overflow-x: clip !important;
        overflow-y: visible !important;
      }

      /* Sticky fails whenever a non-scrolling ancestor uses hidden, auto,
         scroll or clip overflow. Keep the complete product path visible. */
      #MainContent,
      #shopify-section-{{ section.id }},
      #MainProduct-{{ section.id }} {
        overflow: visible !important;
        overflow-x: visible !important;
        overflow-y: visible !important;
      }

      #MainProduct-{{ section.id }} .product {
        align-items: flex-start !important;
        overflow: visible !important;
      }

      #MainProduct-{{ section.id }} .product__media-wrapper {
        position: sticky !important;
        top: 2rem !important;
        align-self: flex-start !important;
        height: max-content !important;
        transform: none !important;
        z-index: 2;
      }

      #MainProduct-{{ section.id }} .product__info-container.product__column-sticky {
        position: static !important;
        top: auto !important;
      }

      #MediaGallery-{{ section.id }} {
        display: grid !important;
        position: static !important;
        top: auto !important;
        grid-template-columns: 12rem minmax(0, 1fr);
        grid-template-rows: auto;
        column-gap: 1.6rem;
        align-items: start;
      }

      #MediaGallery-{{ section.id }} > #GalleryViewer-{{ section.id }} {
        grid-column: 2;
        grid-row: 1;
        width: 100%;
        min-width: 0;
        margin: 0 !important;
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} {
        grid-column: 1;
        grid-row: 1;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        width: 100%;
        min-width: 0;
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} .kokocarb-thumbnail-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      #KokoCarbVerticalThumbnails-{{ section.id }} .kokocarb-thumbnail-item[hidden] {
