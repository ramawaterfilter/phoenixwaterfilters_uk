<script>
document.addEventListener('DOMContentLoaded', function () {
  const productSection = document.querySelector('.product');

  if (!productSection) return;

  function keepAddToCartText() {
    const addButton = document.querySelector(
      'product-form button[type="submit"], form[action*="/cart/add"] button[type="submit"]'
    );

    if (!addButton) return;

    const buttonText = addButton.querySelector('span') || addButton;

    if (buttonText.textContent.trim().toLowerCase().includes('unavailable')) {
      buttonText.textContent = 'Add to cart';
      addButton.removeAttribute('disabled');
      addButton.classList.remove('disabled');
    }
  }

  productSection.addEventListener('change', function (event) {
    if (
      event.target.matches('input[type="radio"]') ||
      event.target.matches('select')
    ) {
      keepAddToCartText();

      setTimeout(keepAddToCartText, 50);
      setTimeout(keepAddToCartText, 150);
      setTimeout(keepAddToCartText, 300);
    }
  });
});
</script>

{% comment %}   {% if request.page_type == 'product' %}
    <style>
      img.jdgm-rev__pic-img {
        aspect-ratio: 1 / 1;
        object-fit: cover;
      }
    </style>

    <script>
      (() => {
        const selector = 'img.jdgm-rev__pic-img';
        const imageWidth = 100;
        const imageHeight = 100;

        function setImageDimensions(container = document) {
          const images = [];

          if (
            container.nodeType === 1 &&
            container.matches(selector)
          ) {
            images.push(container);
          }

          if (container.querySelectorAll) {
            images.push(...container.querySelectorAll(selector));
          }

          images.forEach((image) => {
            if (!image.hasAttribute('width')) {
              image.setAttribute('width', imageWidth);
            }

            if (!image.hasAttribute('height')) {
              image.setAttribute('height', imageHeight);
            }
          });
        }

        setImageDimensions();

        const observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            mutation.addedNodes.forEach((node) => {
              if (node.nodeType === 1) {
                setImageDimensions(node);
              }
            });
          });
        });

        observer.observe(document.documentElement, {
          childList: true,
          subtree: true
        });
      })();
    </script>
  {% endif %} {% endcomment %}

