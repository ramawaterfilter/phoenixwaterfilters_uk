{% liquid
  assign sid = section.id
%}

<section
  id="dynamic-mineral-{{ sid }}"
  class="dynamic-mineral-section"
  style="
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  "
>
  <div class="dm-container">
    
    <!-- LEFT CONTENT -->
    <div class="dm-left">
      <h1
        class="dm-heading"
        style="color: {{ section.settings.heading_color }};"
      >
        {{ section.settings.heading_before }}
        <span style="color: {{ section.settings.highlight_color }};">
          {{ section.settings.highlight_word }}
        </span>
        {{ section.settings.heading_after }}
      </h1>

      <div class="dm-icons">
        {% for block in section.blocks %}
          <div class="dm-icon-item">
            {% if block.settings.icon != blank %}
              <img
                src="{{ block.settings.icon | img_url: 'master' }}"
                alt="icon"
                style="width: {{ section.settings.icon_width }}px;"
              >
            {% endif %}
            <p style="color: {{ section.settings.icon_text_color }};">
              {{ block.settings.text }}
            </p>
          </div>
        {% endfor %}
      </div>
    </div>

    <!-- RIGHT IMAGE -->
    <div class="dm-right">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | img_url: 'master' }}"
          alt="image"
          style="width: {{ section.settings.image_width }}px;"
        >
      {% endif %}
    </div>

  </div>
</section>

<style>
  #dynamic-mineral-{{ sid }} .dm-container {
    max-width: 100%;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding: 0 20px;
  }

  #dynamic-mineral-{{ sid }} .dm-left {
    flex: 1;
    text-align: center;
  }

  #dynamic-mineral-{{ sid }} .dm-heading {
    font-weight: 900;
    margin-bottom: 30px;
    font-size: {{ section.settings.heading_size_desktop }}px;
  }

  #dynamic-mineral-{{ sid }} .dm-icons {
    display: flex;
    gap: 30px;
    justify-content: space-evenly;
    flex-wrap: wrap;
  }

  #dynamic-mineral-{{ sid }} .dm-icon-item {
    max-width: 100%;
    text-align: center;
  }

  #dynamic-mineral-{{ sid }} .dm-icon-item p {
    margin-top: 12px;
    line-height: 1.5;
    font-size: {{ section.settings.icon_text_size_desktop }}px;
  }

  #dynamic-mineral-{{ sid }} .dm-right img {
    display: block;
    margin-left: auto;
  }

  /* Mobile */
  @media(max-width: 768px) {
    #dynamic-mineral-{{ sid }} .dm-container {
      flex-direction: column;
      text-align: center;
    }

    #dynamic-mineral-{{ sid }} .dm-heading {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    #dynamic-mineral-{{ sid }} .dm-icon-item p {
      font-size: {{ section.settings.icon_text_size_mobile }}px;
    }

    #dynamic-mineral-{{ sid }} .dm-right img {
      margin: auto;
    }
  }
</style>


{% schema %}
{
  "name": "Dynamic Mineral Section",
  "settings": [
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading (Before Highlight)",
      "default": "While"
    },
    {
      "type": "text",
      "id": "highlight_word",
      "label": "Highlighted Word",
      "default": "protecting"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading (After Highlight)",
      "default": "important minerals"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1f1f4a"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight Word Color",
      "default": "#4aa3df"
    },
    {
      "type": "color",
      "id": "icon_text_color",
      "label": "Icon Text Color",
      "default": "#1f1f4a"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon Width (px)",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 50
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Right Side Image"
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Image Width (px)",
      "min": 150,
      "max": 500,
      "step": 10,
      "default": 300
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
  "type": "range",
  "id": "heading_size_desktop",
  "label": "Heading Size (Desktop)",
  "min": 24,
  "max": 80,
  "step": 2,
  "default": 42
},
{
  "type": "range",
  "id": "heading_size_mobile",
  "label": "Heading Size (Mobile)",
  "min": 18,
  "max": 50,
  "step": 2,
  "default": 28
},
{
  "type": "range",
  "id": "icon_text_size_desktop",
  "label": "Icon Text Size (Desktop)",
  "min": 12,
  "max": 28,
  "step": 1,
  "default": 16
},
{
  "type": "range",
  "id": "icon_text_size_mobile",
  "label": "Icon Text Size (Mobile)",
  "min": 12,
  "max": 24,
  "step": 1,
  "default": 14
},

    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20,
      "max": 150,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20,
      "max": 150,
      "step": 5,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon + Text",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Icon description here"
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    {
      "name": "Dynamic Mineral Section"
    }
  ]
}
{% endschema %}
