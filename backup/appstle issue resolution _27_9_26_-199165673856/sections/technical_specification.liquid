<section
  class="main-tech-spec main-tech-spec--{{ section.id }}"
  style="
    --section-background: {{ section.settings.background_color }};
    --heading-color: {{ section.settings.heading_color }};
    --text-color: {{ section.settings.text_color }};
    --label-color: {{ section.settings.label_color }};
    --border-color: {{ section.settings.border_color }};
    --desktop-heading-size: {{ section.settings.desktop_heading_size }}px;
    --mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
  "
>
  <div class="sub-tech-spec page-width">
    <div class="tech-spec-media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            class: 'tech-spec-media__image',
            loading: 'lazy',
            widths: '360, 540, 720, 900, 1100, 1400',
            sizes: '(min-width: 990px) 45vw, 100vw',
            alt: section.settings.image.alt
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'tech-spec-media__placeholder placeholder-svg' }}
      {% endif %}
    </div>

    <div class="tech-spec-content">
      {% if section.settings.sub_heading != blank %}
        <div class="tech-spec-content-sub-heading">
          {{ section.settings.sub_heading }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="tech-spec-content-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <dl class="tech-spec-list">
          {% for block in section.blocks %}
            {% if block.type == 'specification' %}
              <div
                class="tech-spec-content-row"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.left_block != blank %}
                  <dt class="tech-spec-left-block">
                    {{ block.settings.left_block }}
                  </dt>
                {% endif %}

                {% if block.settings.right_block != blank %}
                  <dd class="tech-spec-right-block">
                    {{ block.settings.right_block }}
                  </dd>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </dl>
      {% endif %}
    </div>
  </div>
</section>

{% style %}
  .main-tech-spec--{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: var(--section-background);
  }

  .main-tech-spec--{{ section.id }} .sub-tech-spec {
    display: grid;
    grid-template-columns:
      minmax(0, {{ section.settings.image_column_width }}%)
      minmax(0, 1fr);
    align-items: {{ section.settings.vertical_alignment }};
    gap: {{ section.settings.column_gap }}px;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-media {
    position: relative;
    width: 100%;
    min-width: 0;
    overflow: hidden;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-media__image,
  .main-tech-spec--{{ section.id }} .tech-spec-media__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-media__image {
    object-fit: contain;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-content {
    width: 100%;
    min-width: 0;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-content-sub-heading {
    margin: 0 0 10px;
    color: var(--label-color);
    font-size: {{ section.settings.sub_heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-content-heading {
    margin: 0 0 26px;
    color: var(--heading-color);
    font-family: var(--font-heading-family);
    font-size: var(--desktop-heading-size);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    line-height: 1.15;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-list {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-content-row {
    display: grid;
    grid-template-columns:
      minmax(140px, {{ section.settings.label_column_width }}%)
      minmax(0, 1fr);
    column-gap: {{ section.settings.row_column_gap }}px;
    align-items: start;
    width: 100%;
    margin: 0;
    padding: {{ section.settings.row_padding }}px 0;
    border-top: 1px solid var(--border-color);
  }

  .main-tech-spec--{{ section.id }} .tech-spec-content-row:last-child {
    border-bottom: 1px solid var(--border-color);
  }

  .main-tech-spec--{{ section.id }} .tech-spec-left-block {
    margin: 0;
    color: var(--label-color);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.label_text_size }}px;
    font-style: var(--font-body-style);
    font-weight: 700;
    line-height: 1.4;
  }

  .main-tech-spec--{{ section.id }} .tech-spec-right-block {
    margin: 0;
    color: var(--text-color);
    font-family: var(--font-body-family);
    font-size: {{ section.settings.value_text_size }}px;
    font-style: var(--font-body-style);
    font-weight: var(--font-body-weight);
    line-height: 1.45;
  }

  @media screen and (max-width: 989px) {
    .main-tech-spec--{{ section.id }} .sub-tech-spec {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .main-tech-spec--{{ section.id }} .tech-spec-media {
      max-width: {{ section.settings.tablet_image_width }}px;
      margin: 0 auto;
    }
  }

  @media screen and (max-width: 749px) {
    .main-tech-spec--{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .main-tech-spec--{{ section.id }} .sub-tech-spec {
      gap: 28px;
    }

    .main-tech-spec--{{ section.id }} .tech-spec-content-sub-heading {
      margin-bottom: 8px;
      font-size: {{ section.settings.mobile_sub_heading_size }}px;
    }

    .main-tech-spec--{{ section.id }} .tech-spec-content-heading {
      margin-bottom: 20px;
      font-size: var(--mobile-heading-size);
    }

    .main-tech-spec--{{ section.id }} .tech-spec-content-row {
      grid-template-columns: 1fr;
      row-gap: 8px;
      padding: {{ section.settings.mobile_row_padding }}px 0;
    }

    .main-tech-spec--{{ section.id }} .tech-spec-left-block {
      font-size: {{ section.settings.mobile_label_text_size }}px;
    }

    .main-tech-spec--{{ section.id }} .tech-spec-right-block {
      font-size: {{ section.settings.mobile_value_text_size }}px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Technical specifications",
  "max_blocks": 12,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Product specification image"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Subheading",
      "default": "Product details"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Technical Specifications"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label colour",
      "default": "#003866"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description colour",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider colour",
      "default": "#d9dfe4"
    },
    {
      "type": "header",
      "content": "Desktop typography"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 38
    },
    {
      "type": "range",
      "id": "sub_heading_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 13
    },
    {
      "type": "range",
      "id": "label_text_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Label size",
      "default": 18
    },
    {
      "type": "range",
      "id": "value_text_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "image_column_width",
      "min": 30,
      "max": 55,
      "step": 1,
      "unit": "%",
      "label": "Image column width",
      "default": 40
    },
    {
      "type": "range",
      "id": "label_column_width",
      "min": 25,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Label column width",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Image and content gap",
      "default": 68
    },
    {
      "type": "range",
      "id": "row_column_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Label and description gap",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Specification row spacing",
      "default": 18
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "tablet_image_width",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Tablet image width",
      "default": 600
    },
    {
      "type": "header",
      "content": "Mobile typography"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 22,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "Mobile heading size",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_sub_heading_size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile subheading size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_label_text_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Mobile label size",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_value_text_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Mobile description size",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_row_padding",
      "min": 10,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Mobile row spacing",
      "default": 16
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "specification",
      "name": "Specification",
      "settings": [
        {
          "type": "text",
          "id": "left_block",
          "label": "Specification label",
          "default": "Material"
        },
        {
          "type": "textarea",
          "id": "right_block",
          "label": "Specification description",
          "default": "AISI 304 stainless steel — rust-resistant and non-leaching"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Technical specifications",
      "blocks": [
        {
          "type": "specification",
          "settings": {
            "left_block": "Material",
            "right_block": "AISI 304 stainless steel — rust-resistant and non-leaching"
          }
        },
        {
          "type": "specification",
          "settings": {
            "left_block": "Capacity",
            "right_block": "Up to 1,060 gallons per pair"
          }
        },
        {
          "type": "specification",
          "settings": {
            "left_block": "Compatibility",
            "right_block": "Phoenix Gravity Carbon Filter Elements & Black Berkey® Elements"
          }
        },
        {
          "type": "specification",
          "settings": {
            "left_block": "Composition",
            "right_block": "Fluorid — activated carbon blend + proprietary fluoride-reduction media"
          }
        },
        {
          "type": "specification",
          "settings": {
            "left_block": "Warranty",
            "right_block": "10-year coverage on defects in materials or performance"
          }
        }
      ]
    }
  ]
}
{% endschema %}