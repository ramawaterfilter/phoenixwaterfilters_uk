<script>
/* Phoenix contaminants carousel - safe init (waits for element) */
(function () {
 function initPhoenixCarousel() {
 const container = document.querySelector('.pg-carousel-container');
 if (!container) return false;

 const slides = Array.from(container.querySelectorAll('.pg-carousel-slide'));
 const prevBtn = container.querySelector('#pg-prev');
 const nextBtn = container.querySelector('#pg-next');
 const dots = Array.from(container.querySelectorAll('.pg-indicator-dot'));
 let current = 0;

 function setSlide(index) {
 if (!slides.length) return;
 current = (index + slides.length) % slides.length;

 slides.forEach((s, i) => {
 const active = i === current;
 s.classList.toggle('pg-active', active);
 s.setAttribute('aria-hidden', (!active).toString());
 });

 dots.forEach((d, i) => d.classList.toggle('pg-active', i === current));
 }

 if (prevBtn) prevBtn.addEventListener('click', () => setSlide(current - 1));
 if (nextBtn) nextBtn.addEventListener('click', () => setSlide(current + 1));

 dots.forEach(dot => {
 dot.addEventListener('click', () => {
 const idx = parseInt(dot.getAttribute('data-index'), 10);
 if (!isNaN(idx)) setSlide(idx);
 });
 });

 // Keyboard support
 container.setAttribute('tabindex', '0');
 container.addEventListener('keydown', (e) => {
 if (e.key === 'ArrowLeft') setSlide(current - 1);
 if (e.key === 'ArrowRight') setSlide(current + 1);
 });

 // Optional autoplay
 const autoplay = container.getAttribute('data-autoplay') === 'true';
 let autoplayTimer = null;
 if (autoplay && slides.length > 1) {
 const interval = 5000;
 autoplayTimer = setInterval(() => setSlide(current + 1), interval);
 container.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
 container.addEventListener('mouseleave', () => {
 autoplayTimer = setInterval(() => setSlide(current + 1), interval);
 });
 }

 setSlide(0);
 container._phoenixCarousel = { setSlide, getCurrent: () => current };
 return true;
 }

 // Try once now
 if (!initPhoenixCarousel()) {
 // If HTML is injected later (EComposer), retry a few times
 let attempts = 0;
 const maxAttempts = 20;
 const intervalId = setInterval(() => {
 attempts++;
 if (initPhoenixCarousel() || attempts >= maxAttempts) {
 clearInterval(intervalId);
 }
 }, 250);
 }
})();
</script>
