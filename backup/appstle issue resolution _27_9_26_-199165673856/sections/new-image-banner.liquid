    {
      "type": "text",
      "name": "Text",
      "limit": 2,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Give customers details about the banner image or content on the template.",
          "label": "Text"
        },
        {
          "type": "richtext",
          "id": "text1",
