<div class="icon-scroll-section-{{ section.id }} page-width">
  <div class="icon-scroll-wrapper-{{ section.id }}">
    <div class="icon-scroll-track-{{ section.id }}">

      <!-- Group 1 -->
      <div class="icon-scroll-group-{{ section.id }}">
        {% for i in (1..6) %}
          {% for block in section.blocks %}
            {% assign icon_value = block.settings.icon | strip %}
            <div class="icon-scroll-item-{{ section.id }}" {{ block.shopify_attributes }}>
              <div class="icon-scroll-icon-{{ section.id }}">
                {% if icon_value contains '<svg' %}
                  {{ icon_value }}
                {% elsif icon_value contains 'http' %}
                  <img
                    src="{{ icon_value }}"
                    alt="{{ block.settings.text | escape }}"
                    width="{{ section.settings.icon_size }}"
                    height="{{ section.settings.icon_size }}"
                    loading="lazy"
                  >
                {% else %}
                  <span>{{ icon_value }}</span>
                {% endif %}
              </div>

              <div class="icon-scroll-text-{{ section.id }}">
                {{ block.settings.text }}
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      </div>

      <!-- Group 2 duplicate for seamless infinite loop -->
      <div class="icon-scroll-group-{{ section.id }}" aria-hidden="true">
        {% for i in (1..6) %}
          {% for block in section.blocks %}
            {% assign icon_value = block.settings.icon | strip %}
            <div class="icon-scroll-item-{{ section.id }}">
              <div class="icon-scroll-icon-{{ section.id }}">
                {% if icon_value contains '<svg' %}
                  {{ icon_value }}
                {% elsif icon_value contains 'http' %}
                  <img
                    src="{{ icon_value }}"
                    alt="{{ block.settings.text | escape }}"
                    width="{{ section.settings.icon_size }}"
                    height="{{ section.settings.icon_size }}"
                    loading="lazy"
                  >
                {% else %}
                  <span>{{ icon_value }}</span>
                {% endif %}
              </div>

              <div class="icon-scroll-text-{{ section.id }}">
                {{ block.settings.text }}
              </div>
            </div>
          {% endfor %}
        {% endfor %}
      </div>

    </div>
  </div>
</div>

<style>
  .icon-scroll-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
    overflow: hidden;
  }

  .icon-scroll-wrapper-{{ section.id }} {
    width: 100%;
    overflow: hidden;
    border-top: 1px solid {{ section.settings.border_color }};
    border-bottom: 1px solid {{ section.settings.border_color }};
    background-color: {{ section.settings.bar_bg_color }};
  }

  .icon-scroll-track-{{ section.id }} {
    display: flex;
    width: max-content;
    animation: iconScrollLoop-{{ section.id }} {{ section.settings.scroll_speed }}s linear infinite;
    will-change: transform;
  }

  {% if section.settings.pause_on_hover %}
    .icon-scroll-wrapper-{{ section.id }}:hover .icon-scroll-track-{{ section.id }} {
      animation-play-state: paused;
    }
  {% endif %}

  .icon-scroll-group-{{ section.id }} {
    display: flex;
    flex-shrink: 0;
    min-width: max-content;
  }

  .icon-scroll-item-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.icon_text_gap }}px;
    flex: 0 0 auto;
    min-width: {{ section.settings.item_width }}px;
    padding: {{ section.settings.item_padding_vertical }}px {{ section.settings.item_padding_horizontal }}px;
    border-right: 1px solid {{ section.settings.border_color }};
    white-space: nowrap;
  }

  .icon-scroll-icon-{{ section.id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
    line-height: 1;
    flex-shrink: 0;
  }

  .icon-scroll-icon-{{ section.id }} svg {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    display: block;
    color: {{ section.settings.icon_color }};
  }

  .icon-scroll-icon-{{ section.id }} img {
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    object-fit: contain;
    display: block;
  }

  .icon-scroll-icon-{{ section.id }} span {
    font-size: {{ section.settings.icon_size }}px;
    line-height: 1;
    display: block;
  }

  .icon-scroll-icon-{{ section.id }} svg path,
  .icon-scroll-icon-{{ section.id }} svg circle,
  .icon-scroll-icon-{{ section.id }} svg rect,
  .icon-scroll-icon-{{ section.id }} svg line,
  .icon-scroll-icon-{{ section.id }} svg polyline,
  .icon-scroll-icon-{{ section.id }} svg polygon {
    stroke: currentColor;
  }

  .icon-scroll-text-{{ section.id }} {
    font-size: {{ section.settings.text_size }}px;
    color: {{ section.settings.text_color }};
    font-weight: {{ section.settings.text_weight }};
    line-height: 1.2;
  }

  @keyframes iconScrollLoop-{{ section.id }} {
    0% {
      transform: translateX(-50%);
    }

    100% {
      transform: translateX(0);
    }
  }

  @media screen and (max-width: 768px) {
    .icon-scroll-item-{{ section.id }} {
      min-width: {{ section.settings.mobile_item_width }}px;
      padding: {{ section.settings.mobile_item_padding_vertical }}px {{ section.settings.mobile_item_padding_horizontal }}px;
    }

    .icon-scroll-icon-{{ section.id }} svg,
    .icon-scroll-icon-{{ section.id }} img {
      width: {{ section.settings.mobile_icon_size }}px;
      height: {{ section.settings.mobile_icon_size }}px;
    }

    .icon-scroll-icon-{{ section.id }} span {
      font-size: {{ section.settings.mobile_icon_size }}px;
    }

    .icon-scroll-text-{{ section.id }} {
      font-size: {{ section.settings.mobile_text_size }}px;
    }
  }

  .icon-scroll-section-{{ section.id }}.page-width{max-width:{{section.settings.page_width }}rem;}
</style>

{% schema %}
{
  "name": "Scrolling icon",
  "settings": [
    {
      "type":"range",
      "id":"page_width",
      "min":100,
      "max":160,
      "unit":"rem",
      "label":"Page width",
      "default":140
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Section padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Section padding bottom",
      "default": 0
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "bar_bg_color",
      "label": "Bar background",
      "default": "#f8fbff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#d9e1ec"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#10284a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#8d98a8"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Icon size",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_icon_size",
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Mobile icon size",
      "default": 15
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Mobile text size",
      "default": 13
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "icon_text_gap",
      "min": 2,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Icon text gap",
      "default": 7
    },
    {
      "type": "range",
      "id": "item_width",
      "min": 120,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Desktop item width",
      "default": 180
    },
    {
      "type": "range",
      "id": "mobile_item_width",
      "min": 100,
      "max": 240,
      "step": 5,
      "unit": "px",
      "label": "Mobile item width",
      "default": 145
    },
    {
      "type": "range",
      "id": "item_padding_vertical",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Desktop vertical padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_padding_horizontal",
      "min": 4,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Desktop horizontal padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_item_padding_vertical",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Mobile vertical padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "mobile_item_padding_horizontal",
      "min": 4,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Mobile horizontal padding",
      "default": 12
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "min": 5,
      "max": 80,
      "step": 1,
      "unit": "s",
      "label": "Scroll speed",
      "default": 35
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause scrolling on hover",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Icon text item",
      "settings": [
        {
          "type": "textarea",
          "id": "icon",
          "label": "Icon SVG code or CDN image link",
          "default": "https://ramawaterfilter.com/cdn/shop/files/truck-fast.svg?v=1762518111"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling icon",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Free Shipping",
            "icon": "https://ramawaterfilter.com/cdn/shop/files/truck-fast.svg?v=1762518111"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "100-Day Trial",
            "icon": "https://ramawaterfilter.com/cdn/shop/files/heart-circle.svg?v=1762518161"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "10-Yr Warranty",
            "icon": "https://ramawaterfilter.com/cdn/shop/files/like-shapes.svg?v=1762518170"
          }
        }
      ]
    }
  ]
}
{% endschema %}