{% liquid
  assign sid = section.id
%}

{%- style -%}
  .video-features-{{ sid }} {
    width: 100%;
    max-width: {{ section.settings.page_width }}rem;
    margin-inline: auto;
    padding-top: {{ section.settings.padding_desktop }}px;
    padding-bottom: {{ section.settings.padding_desktop }}px;
    background: {{ section.settings.bg_color }};
    box-sizing: border-box;
  }

  .video-features-{{ sid }} *,
  .video-features-{{ sid }} *::before,
  .video-features-{{ sid }} *::after {
    box-sizing: border-box;
  }

  .video-features-{{ sid }} .main-container {
    width: 100%;
    margin-bottom: {{ section.settings.heading_bottom_spacing }}px;
    text-align: {{ section.settings.section_text_alignment }};
  }

  .video-features-{{ sid }} .main-container > *:first-child {
    margin-top: 0;
  }

  .video-features-{{ sid }} .main-container > *:last-child {
    margin-bottom: 0;
  }

  .video-features-{{ sid }} .section-heading {
    margin: 0 0 12px;
    color: {{ section.settings.heading_color }};
  }

  .video-features-{{ sid }} .section-description {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.6;
  }

  .video-features-{{ sid }} .container {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ section.settings.gap }}px;
    margin-inline: auto;
    text-align: {{ section.settings.card_text_alignment }};
  }

  .video-features-{{ sid }} .video-card {
    min-width: 0;
  }

  /*
   * Media
   */
  .video-features-{{ sid }} .video-card__media {
    position: relative;
    width: 100%;
    height: {{ section.settings.media_height_desktop }}px;
    overflow: hidden;
    border-radius: {{ section.settings.media_radius }}px;
    background: {{ section.settings.media_background }};
  }

  .video-features-{{ sid }} .video-card video,
  .video-features-{{ sid }} .video-card img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    border-radius: inherit;
    object-fit: {{ section.settings.media_fit }};
    object-position: {{ section.settings.media_position }};
  }

  .video-features-{{ sid }} .video-card h3 {
    margin: 16px 0 8px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    font-weight: 700;
    line-height: 1.25;
  }

  .video-features-{{ sid }} .video-card p {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.6;
  }

  /*
   * Tablet
   */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .video-features-{{ sid }} .container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .video-features-{{ sid }} .video-card__media {
      height: {{ section.settings.media_height_tablet }}px;
    }
  }

  /*
   * Mobile
   */
  @media screen and (max-width: 749px) {
    .video-features-{{ sid }} {
      padding-top: {{ section.settings.padding_mobile }}px;
      padding-bottom: {{ section.settings.padding_mobile }}px;
    }

    .video-features-{{ sid }} .main-container {
      margin-bottom: {{ section.settings.heading_bottom_spacing_mobile }}px;
    }

    .video-features-{{ sid }} .container {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_gap }}px;
    }

    .video-features-{{ sid }} .video-card__media {
      height: {{ section.settings.media_height_mobile }}px;
    }

    .video-features-{{ sid }} .video-card h3 {
      margin-top: 14px;
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .video-features-{{ sid }} .video-card p,
    .video-features-{{ sid }} .section-description {
      font-size: {{ section.settings.text_size_mobile }}px;
    }
  }
{%- endstyle -%}

<section class="video-features-{{ sid }} page-width">
  {%- if section.settings.heading != blank
    or section.settings.description != blank
  -%}
    <div class="main-container">
      {%- if section.settings.heading != blank -%}
        <div class="section-heading">
          {{ section.settings.heading }}
        </div>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="section-description">
          {{ section.settings.description }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="container">
      {%- for block in section.blocks -%}
        <div
          class="video-card"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.video != blank
            or block.settings.image != blank
          -%}
            <div class="video-card__media">
              {%- if block.settings.video != blank -%}
                <video
                  {% if section.settings.autoplay %}
                    autoplay
                  {% endif %}
                  {% if section.settings.muted %}
                    muted
                  {% endif %}
                  {% if section.settings.loop %}
                    loop
                  {% endif %}
                  playsinline
                  preload="metadata"
                  {% unless section.settings.hide_controls %}
                    controls
                  {% endunless %}
                  {% if block.settings.image != blank %}
                    poster="{{ block.settings.image | image_url: width: 1600 }}"
                  {% endif %}
                >
                  <source
                    src="{{ block.settings.video }}"
                    type="video/mp4"
                  >
                  Your browser does not support the video tag.
                </video>

              {%- elsif block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 900, 1200, 1600',
                    sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw',
                    class: 'video-card__image',
                    alt: block.settings.image.alt
                }}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if block.settings.heading != blank -%}
            <h3>{{ block.settings.heading }}</h3>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Dynamic Video Features",
  "settings": [
    {
      "type": "range",
      "id": "page_width",
      "min": 100,
      "max": 160,
      "step": 5,
      "unit": "rem",
      "label": "Page width",
      "default": 120
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Title"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "select",
      "id": "section_text_alignment",
      "label": "Section heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "card_text_alignment",
      "label": "Card text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing",
      "label": "Heading bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "heading_bottom_spacing_mobile",
      "label": "Mobile heading bottom spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Media dimensions"
    },
    {
      "type": "range",
      "id": "media_height_desktop",
      "label": "Media height desktop",
      "min": 200,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "range",
      "id": "media_height_tablet",
      "label": "Media height tablet",
      "min": 180,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 360
    },
    {
      "type": "range",
      "id": "media_height_mobile",
      "label": "Media height mobile",
      "min": 180,
      "max": 600,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "Video and image fitting",
      "options": [
        {
          "value": "cover",
          "label": "Fill area"
        },
        {
          "value": "contain",
          "label": "Show complete media"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Media position",
      "options": [
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center center",
          "label": "Centre"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        },
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "right center",
          "label": "Right"
        }
      ],
      "default": "center center"
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Video/image radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Media background",
      "default": "#f4f4f4"
    },
    {
      "type": "header",
      "content": "Video playback"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute videos",
      "default": true,
      "info": "Videos normally need to be muted for autoplay to work."
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop videos",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_controls",
      "label": "Hide video controls",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop column gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile row gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Padding desktop",
      "min": 0,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Padding mobile",
      "min": 0,
      "max": 80,
      "step": 10,
      "unit": "px",
      "default": 50
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#2a245e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#4b4b4b"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Card heading size desktop",
      "min": 18,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Card heading size mobile",
      "min": 16,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 22
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text size desktop",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text size mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Video feature",
      "settings": [
        {
          "type": "url",
          "id": "video",
          "label": "MP4 video URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback image/video poster"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "304-grade stainless steel"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Naturally BPA-free and rust-resistant."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Dynamic Video Features",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}