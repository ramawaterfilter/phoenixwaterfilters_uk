<section class="overlay-feature-card section-{{ section.id }}">
  <div class="overlay-feature-card__container">

    <div class="overlay-feature-card__banner">

      {% if section.settings.image != blank %}
        <picture>
          {% if section.settings.mobile_image != blank %}
            <source
              media="(max-width: 767px)"
              srcset="{{ section.settings.mobile_image | image_url: width: 900 }}"
            >
          {% endif %}

          <img
            src="{{ section.settings.image | image_url: width: 2000 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
          >
        </picture>
      {% else %}
        <div class="overlay-feature-card__placeholder">
          Upload image from customizer
        </div>
      {% endif %}

      <div class="overlay-feature-card__content">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.show_line %}
          <div class="overlay-feature-card__line"></div>
        {% endif %}

        <ul>
          {% for block in section.blocks %}
            {% if block.settings.point != blank %}
              <li {{ block.shopify_attributes }}>
                {{ block.settings.point }}
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

    </div>

  </div>
</section>

<style>
.section-{{ section.id }} {
  background: {{ section.settings.section_bg }};
  padding-top: {{ section.settings.desktop_padding_top }}px;
  padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
}

.section-{{ section.id }} .overlay-feature-card__container {
  margin: 0 auto;
}

.section-{{ section.id }} .overlay-feature-card__banner {
  position: relative;
  width: 100%;
  aspect-ratio: {{ section.settings.desktop_ratio_width }} / {{ section.settings.desktop_ratio_height }};
  overflow: hidden;
  border-radius: {{ section.settings.banner_radius }}px;
  background: {{ section.settings.image_bg }};
}

.section-{{ section.id }} .overlay-feature-card__banner picture,
.section-{{ section.id }} .overlay-feature-card__banner img {
  width: 100%;
  height: 100%;
  display: block;
}

.section-{{ section.id }} .overlay-feature-card__banner img {
  object-fit: {{ section.settings.image_fit }};
  object-position: {{ section.settings.image_position }};
}

.section-{{ section.id }} .overlay-feature-card__placeholder {
  width: 100%;
  height: 100%;
  min-height: 350px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #111111;
  font-size: 22px;
}

.section-{{ section.id }} .overlay-feature-card__content {
  position: absolute;
  z-index: 2;
  left: {{ section.settings.desktop_card_left }}%;
  top: 50%;
  transform: translateY(-50%);
  width: {{ section.settings.desktop_card_width }}%;
  background: {{ section.settings.card_bg }};
  border-radius: {{ section.settings.card_radius }}px;
  padding: {{ section.settings.desktop_card_padding }}px;
  color: {{ section.settings.text_color }};
  box-shadow: {% if section.settings.card_shadow %}0 8px 30px rgba(0,0,0,0.24){% else %}none{% endif %};
}

.section-{{ section.id }} .overlay-feature-card__content h2 {
  margin: 0;
  color: {{ section.settings.heading_color }};
  font-size:50px;
  line-height: 1.12;
  font-weight: 900;
  letter-spacing: -0.5px;
  text-transform: {% if section.settings.uppercase_heading %}uppercase{% else %}none{% endif %};
}

.section-{{ section.id }} .overlay-feature-card__line {
  width: {{ section.settings.line_width }}%;
  height: {{ section.settings.line_height }}px;
  background: {{ section.settings.line_color }};
  margin-top: {{ section.settings.line_margin_top }}px;
  margin-bottom: {{ section.settings.line_margin_bottom }}px;
}

.section-{{ section.id }} .overlay-feature-card__content ul {
  margin: 0;
  padding-left: {{ section.settings.desktop_bullet_indent }}px;
}

.section-{{ section.id }} .overlay-feature-card__content li {
  color: {{ section.settings.text_color }};
  font-size:28px ;
  line-height: 1.38;
  margin-bottom: {{ section.settings.desktop_bullet_gap }}px;
}

.section-{{ section.id }} .overlay-feature-card__content li:last-child {
  margin-bottom: 0;
}

.section-{{ section.id }} .overlay-feature-card__content li::marker {
  color: {{ section.settings.bullet_color }};
  font-size: 0.8em;
}

/* Mobile - same replica layout */
@media screen and (max-width: 767px) {
  .section-{{ section.id }} {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
  }

  .section-{{ section.id }} .overlay-feature-card__container {
    padding-left: {{ section.settings.mobile_side_padding }}px;
    padding-right: {{ section.settings.mobile_side_padding }}px;
  }

  .section-{{ section.id }} .overlay-feature-card__banner {
    aspect-ratio: {{ section.settings.mobile_ratio_width }} / {{ section.settings.mobile_ratio_height }};
    border-radius: {{ section.settings.mobile_banner_radius }}px;
  }

  .section-{{ section.id }} .overlay-feature-card__banner img {
    object-fit: {{ section.settings.mobile_image_fit }};
    object-position: {{ section.settings.mobile_image_position }};
  }

  .section-{{ section.id }} .overlay-feature-card__content {
    left: {{ section.settings.mobile_card_left }}%;
    top: 50%;
    transform: translateY(-50%);
    width: {{ section.settings.mobile_card_width }}%;
    padding: {{ section.settings.mobile_card_padding }}px;
    border-radius: {{ section.settings.mobile_card_radius }}px;
  }

  .section-{{ section.id }} .overlay-feature-card__content h2 {
    font-size: 22px;
    line-height: 1.12;
  }

  .section-{{ section.id }} .overlay-feature-card__line {
    width: {{ section.settings.mobile_line_width }}%;
    height: 1px;
    margin-top: {{ section.settings.mobile_line_margin_top }}px;
    margin-bottom: {{ section.settings.mobile_line_margin_bottom }}px;
  }

  .section-{{ section.id }} .overlay-feature-card__content ul {
    padding-left: {{ section.settings.mobile_bullet_indent }}px;
  }

  .section-{{ section.id }} .overlay-feature-card__content li {
    font-size: 14px;
    line-height: 1.35;
    margin-bottom: {{ section.settings.mobile_bullet_gap }}px;
  }
}
</style>

