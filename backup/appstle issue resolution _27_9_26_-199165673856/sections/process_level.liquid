{%- liquid
  assign image_column_width = section.settings.image_column_width
  assign content_column_width = 100 | minus: image_column_width
-%}

{% style %}
  .process-level--{{ section.id }} {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .process-level--{{ section.id }} .process-level-main {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ section.settings.block_gap }}px;
  }

  .process-level--{{ section.id }} .process-level-div {
    display: flex;
    flex-direction:column;
    align-items: {{ section.settings.vertical_alignment }};
    column-gap: {{ section.settings.column_gap }}px;
    padding-bottom: {{ section.settings.row_padding }}px;
  }

  .process-level--{{ section.id }} .process-level-div:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .process-level--{{ section.id }} .process-level-div--no-image {
    grid-template-columns: minmax(0, 1fr);
  }

  .process-level--{{ section.id }} .process-level-media {
    width: 100%;
    position: relative;
    z-index: 1;
    display: grid;
    width: 14.4rem;
    height: 14.4rem;
    margin: 0 auto 3.7rem;
    place-items: center;
    border: .2rem solid #dfe5ef;
    border-radius: 50%;
    background: white;
  }

  .process-level--{{ section.id }} .process-level-media__image {
    display: block;
    width: 50%;
    height: auto;
    object-fit: contain;
    margin:auto;
    display: grid;
    width: 10.8rem;
    height: 10.8rem;
    place-items: center;
    overflow: hidden;
    border: .2rem solid #163b5d;
    border-radius: 50%;
    background: #163b5d;
  }

  .process-level--{{ section.id }} .process-level-content-wrapper {
    width: 100%;
    text-align:center;
  }

  .process-level--{{ section.id }} .process-level-sub-heading {
    margin: 0 0 10px;
    color: {{ section.settings.label_color }};
    font-size: {{ section.settings.sub_heading_size }}px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .process-level--{{ section.id }} .process-level-main-heading {
    margin: 0 0 16px;
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.desktop_heading_size }}px;
    font-weight: 600;
    line-height: 1.15;
  }

  .process-level--{{ section.id }} .process-level-content {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.value_text_size }}px;
    line-height: 1.6;
  }

  .process-level--{{ section.id }} .process-level-content > * {
    margin-top: 0;
  }

  .process-level--{{ section.id }} .process-level-content > *:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 989px) {
    .process-level--{{ section.id }} .process-level-div {
      grid-template-columns: minmax(0, 1fr);
      row-gap: {{ section.settings.row_column_gap }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .process-level--{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    .process-level--{{ section.id }} .process-level-main {
      gap: {{ section.settings.mobile_block_gap }}px;
    }

    .process-level--{{ section.id }} .process-level-div {
      row-gap: 20px;
      padding-bottom: {{ section.settings.mobile_row_padding }}px;
    }

    .process-level--{{ section.id }} .process-level-sub-heading {
      margin-bottom: 8px;
      font-size: {{ section.settings.mobile_sub_heading_size }}px;
    }

    .process-level--{{ section.id }} .process-level-main-heading {
      margin-bottom: 12px;
      font-size: {{ section.settings.mobile_heading_size }}px;
    }

    .process-level--{{ section.id }} .process-level-content {
      font-size: {{ section.settings.mobile_value_text_size }}px;
    }
    .process-level--{{ section.id }} .process-level-main {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
  }
  }

  @media (min-width: 750px) {
    .process-level-main > .process-level-div:not(:last-of-type)
    .process-level-media::after {
    content: "";
    position: absolute;
    z-index: 0;
    top: 6.5rem;
    left: calc(50% + 7.2rem);
    width: 100%;
    height: 1.4rem;
    background: linear-gradient(45deg, transparent 40%, var(--certificate-line) 42% 58%, transparent 60%) right .1rem top .1rem / .9rem .8rem no-repeat, linear-gradient(135deg, transparent 40%, var(--certificate-line) 42% 58%, transparent 60%) right .1rem bottom .1rem / .9rem .8rem no-repeat, repeating-linear-gradient(to right, var(--certificate-line) 0 .35rem, transparent .35rem .85rem) left center / calc(100% - .7rem) .3rem no-repeat;
    pointer-events: none;
    }

    .process-level-main > .process-level-div:last-of-type
    .process-level-media::after {
    content: none !important;
    display: none !important;
    }
    
}
@media screen and (max-width:576px){
    .process-level--{{ section.id }} .process-level-main {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
  }
}

{% endstyle %}

<section class="process-level process-level--{{ section.id }}"
    style="--certificate-line: {{ section.settings.label_color }};">
  <div class="process-level-main page-width">
    {% for block in section.blocks %}
      {%- liquid
        assign process_image = block.settings.image

        if process_image == blank
          assign process_image = section.settings.image
        endif

        assign image_alt = process_image.alt

        if image_alt == blank
          assign image_alt = block.settings.heading
        endif
      -%}

      <article
        class="process-level-div{% if process_image == blank %} process-level-div--no-image{% endif %}"
        {{ block.shopify_attributes }}
      >
        {% if process_image != blank %}
          <div class="process-level-media">
            {{
              process_image
              | image_url: width: 1400
              | image_tag:
                class: 'process-level-media__image',
                loading: 'lazy',
                decoding: 'async',
                widths: '360, 540, 720, 900, 1100, 1400',
                sizes: '(min-width: 990px) 45vw, (min-width: 750px) 80vw, 100vw',
                alt: image_alt
            }}
          </div>
        {% endif %}

        <div class="process-level-content-wrapper">
          {% if block.settings.sub_heading != blank %}
            <div class="process-level-sub-heading">
              {{ block.settings.sub_heading | escape }}
            </div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="process-level-main-heading">
              {{ block.settings.heading | escape }}
            </h2>
          {% endif %}

          {% if block.settings.content != blank %}
            <div class="process-level-content rte">
              {{ block.settings.content }}
            </div>
          {% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Process level section",
  "tag": "section",
  "class": "section",
  "max_blocks": 10,
  "settings": [
    {
      "type": "header",
      "content": "Default image"
    },
    {
      "type": "paragraph",
      "content": "This image is used when a process block does not have its own image."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading colour",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Subheading colour",
      "default": "#003866"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description colour",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider colour",
      "default": "#d9dfe4"
    },
    {
      "type": "header",
      "content": "Desktop typography"
    },
    {
      "type": "range",
      "id": "desktop_heading_size",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 38
    },
    {
      "type": "range",
      "id": "sub_heading_size",
      "min": 10,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 13
    },
    {
      "type": "range",
      "id": "value_text_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "image_column_width",
      "min": 30,
      "max": 55,
      "step": 1,
      "unit": "%",
      "label": "Image column width",
      "default": 40
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Image and content gap",
      "default": 68
    },
    {
      "type": "range",
      "id": "block_gap",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space between process blocks",
      "default": 40
    },
    {
      "type": "range",
      "id": "row_column_gap",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Tablet image and content gap",
      "default": 28
    },
    {
      "type": "range",
      "id": "row_padding",
      "min": 10,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Block bottom spacing",
      "default": 32
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "tablet_image_width",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Tablet image width",
      "default": 600
    },
    {
      "type": "header",
      "content": "Mobile typography"
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "min": 22,
      "max": 44,
      "step": 2,
      "unit": "px",
      "label": "Mobile heading size",
      "default": 30
    },
    {
      "type": "range",
      "id": "mobile_sub_heading_size",
      "min": 9,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Mobile subheading size",
      "default": 11
    },
    {
      "type": "range",
      "id": "mobile_value_text_size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "label": "Mobile description size",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_block_gap",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Mobile block gap",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_row_padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Mobile block bottom spacing",
      "default": 24
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop top padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Desktop bottom padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Mobile bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "process_block",
      "name": "Process block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Block image"
        },
        {
          "type": "text",
          "id": "sub_heading",
          "label": "Subheading",
          "default": "Step 1"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Process heading"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add the description for this process step.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Process level section",
      "blocks": [
        {
          "type": "process_block"
        },
        {
          "type": "process_block"
        },
        {
          "type": "process_block"
        }
      ]
    }
  ]
}
{% endschema %}