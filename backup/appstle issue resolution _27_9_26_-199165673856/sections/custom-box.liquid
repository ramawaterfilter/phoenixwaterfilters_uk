
    <link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css">
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.AOS) {
      AOS.init({
        once: true,
        duration: 800,
        easing: 'ease-out-cubic'
      });
    }
  });

  document.addEventListener('shopify:section:load', function () {
    if (window.AOS) {
      AOS.refreshHard();
    }
  });
</script>


<section
  id="hover-card-{{ section.id }}"
  class="hover-card-section hover-card-{{ section.id }}"
  style="
    background: {{ section.settings.section_bg }};
    padding: {{ section.settings.p1 }}px {{ section.settings.p2 }}px {{ section.settings.p3 }}px;
    overflow: hidden;
  "
>

   {% if section.settings.h3 != blank %}
  <h1 class="heading-box">{{ section.settings.h3 }}</h1>
       {% endif %}

     {% if section.settings.h1 != blank %}
  <h2 class="heading-box">{{ section.settings.h1 }}</h2>
       {% endif %}
            {% if section.settings.h2 != blank %}
  <div class="sub-heading-box">{{ section.settings.h2 }}</div>
       {% endif %}
  <div class="hover-grid">
    {% for block in section.blocks %}


<div
  class="hover-card"
  {{ block.shopify_attributes }}
  style="background: {{ block.settings.card_bg }};"
  data-aos="{{ block.settings.aos_animation }}"
  data-aos-delay="{{ block.settings.aos_delay }}"
  data-aos-duration="{{ block.settings.aos_duration }}"
>
 <a href="{{ block.settings.b2 }}">
        <!-- NORMAL STATE -->
        <div class="card-front hhi">

            <div class="card-hover-text">
                      {% if block.settings.heading != blank %}
          <h3 style="color: {{ block.settings.text_color }};">{{ block.settings.heading }}</h3>
                 {% endif %}

                      {% if block.settings.h10 != blank %}
           <h3 class="box-sub-heading" style="color: {{ block.settings.text_color }};">{{ block.settings.h10 }}</h3>
                  {% endif %}
        </div>

{% assign border_color = block.settings.r1 | default: 'rgba(0,0,0,0)' %}
    <a href="{{ block.settings.b2 }}">
{% if block.settings.icon != blank %}

  <img 
    src="{{ block.settings.icon | img_url: 'master' }}" 
    alt="icon" 
    class="icon"
    style="border: 4px solid {{ border_color }};">
 
{% endif %}
       </a>
        </div>
  
        <!-- HOVER STATE -->
        <div class="card-hover">
          <h3 style="color: {{ block.settings.hover_heading_color }};">{{ block.settings.hover_heading }}</h3>
          <p style="color: {{ block.settings.sub_text_color }};">{{ block.settings.sub_heading }}</p>
          {% if block.settings.button_text != blank %}
            <a href="{{ block.settings.button_link }}" class="btn"
               style="
                 background: {{ block.settings.button_bg }};
                 color: {{ block.settings.button_text_color }};
                 border-radius: {{ block.settings.button_radius }}px;">
              {{ block.settings.button_text }}
            </a>
          {% endif %}
        </div>


      </a>
      </div>
    {% endfor %}
  </div>
            {% if section.settings.b1 != blank %}
   <div class="button-link-box"><button>{{ section.settings.b1 }}</button></div>
          {% endif %}
</section>

<style>


  [data-aos] {
  pointer-events: auto;
}
.card-front.hhi a {
    text-decoration: none;
}
.hover-card-{{ section.id }} .button-link-box button p {
    background: {{ section.settings.bc1 }};
    color: {{ section.settings.bc2 }};
    text-decoration: none;
    border: none;
    border-radius: 11px;
    font-size: 16px;
    padding: 15px 36px;
    font-weight: bold;
    letter-spacing: 1px;
}
.hover-card-{{ section.id }} .button-link-box button p:hover{
background: #b8bbff;
    transition-duration: .4s;
}
.button-link-box {
    text-align: center;
    margin-top: 30px;
}
.hover-card-{{ section.id }} .button-link-box button p a{
    text-decoration: none;
    color: {{ section.settings.bc2 }};
}
.hover-card-{{ section.id }} .button-link-box button {
    border: none;
}
.hover-card-{{ section.id }} .hover-grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.desktop_columns }}, 1fr);
  gap: {{ section.settings.gap }}px;
}

.hover-card-{{ section.id }} .hover-card {
  position: relative;
  padding: {{ section.settings.card_padding }}px;
  border-radius: {{ section.settings.radius }}px;
  overflow: hidden;
  text-align: center;
  cursor: pointer;
  /* Dynamic height for desktop */
  min-height: {{ section.settings.desktop_height }}px;
}

.hover-card-{{ section.id }} .card-front,
.hover-card-{{ section.id }} .card-hover {
  transition: all 0.35s ease;
}

.hover-card-{{ section.id }} .icon {
  width: {{ section.settings.icon_size }}px;
  margin-bottom: 12px;
}

.hover-card-{{ section.id }} .card-hover {
  position: absolute;
  inset: 0;
  opacity: 0;
  transform: translateY(15px);
}

{% if section.settings.enable_hover_effect %}
.hover-card-{{ section.id }} .hover-card:hover .card-front {
  opacity: 0;
  transform: translateY(-10px);
}

.hover-card-{{ section.id }} .hover-card:hover .card-hover {
  opacity: 1;
  transform: translateY(0);
}
{% else %}
.hover-card-{{ section.id }} .card-front,
.hover-card-{{ section.id }} .card-hover {
  opacity: 1 !important;
  transform: none !important;
}
{% endif %}


.card-front h3{
    font-size: 32px;
    font-family: 'DM Sans';
    letter-spacing: 1px;
    line-height: 100%;
}

.card-hover p {
    font-size: 20px;
    line-height: 120%;
    letter-spacing: 1px;
    font-family: 'DM Sans';
    padding-bottom: 25px;
}

.card-hover h3 {
    font-size: 32px;
    font-family: 'DM Sans';
    letter-spacing: 1px;
    line-height: 100%;
    margin: 0 !important;
}

/* Desktop styles */
@media(min-width: 768px){
  .hover-card-{{ section.id }} .hover-grid {
    padding: {{ section.settings.padding_top }}px {{ section.settings.padding_lr }}px {{ section.settings.padding_bottom }}px;
  }
  
  .card-hover a {
    padding: 10px 21px;
    text-decoration: none;
    font-family: 'DM Sans';
    letter-spacing: 1px;
    border-radius: 8px;
    font-size: 20px;
  }
  
  .hover-card-{{ section.id }} .heading-box {
    font-weight: 900;
    font-size: {{ section.settings.hd1 }}px;
    text-align: center;
    line-height: 1.25em;
    letter-spacing: 0px;
    font-family: DM Sans,sans-serif;
  }
    .hover-card-{{ section.id }} .sub-heading-box {
    font-weight: 900;
    font-size: {{ section.settings.hd3 }}px;
    text-align: center;
    line-height: 1.25em;
    letter-spacing: 0px;
    font-family: DM Sans,sans-serif;
  }
  
  .hover-card-{{ section.id }} .card-hover {
    padding: {{ section.settings.card_padding }}px;
  }
  
  .hover-card-{{ section.id }} .card-front,
  .hover-card-{{ section.id }} .card-hover {
    padding: {{ section.settings.card_padding }}px;
  }
  .hover-card-{{ section.id }} .sub-heading-box {
    width: 50%;
    margin: 0 auto;
}
h3.box-sub-heading {
    font-size: 16px;
    line-height: 22px;
    text-align: left;
    font-family: system-ui;
    font-weight: 400;
}
}

/* Mobile styles */
@media(max-width: 768px){
  .hover-card-{{ section.id }} .hover-grid{
    grid-template-columns: repeat({{ section.settings.mobile_columns }}, 1fr);
    padding: 15px;
  }
  
  .hover-card-{{ section.id }} .hover-card {
    /* Dynamic height for mobile */
    min-height: {{ section.settings.mobile_height }}px;
  }
  
  .hover-card-{{ section.id }} .heading-box {
    font-weight: 900;
    font-size: {{ section.settings.hd2 }}px;
    text-align: center;
    line-height: 1.25em;
    letter-spacing: 0px;
    font-family: DM Sans,sans-serif;
  }
    .hover-card-{{ section.id }} .sub-heading-box {
    font-weight: 900;
    font-size: {{ section.settings.hd4 }}px;
    text-align: center;
    line-height: 1.25em;
    letter-spacing: 0px;
    font-family: DM Sans,sans-serif;
  }
  
  .card-hover a {
    padding: 10px 21px;
    text-decoration: none;
    font-family: 'DM Sans';
    letter-spacing: 1px;
    border-radius: 8px;
    font-size: 14px;
  }
  
  .card-front h3 {
    font-size: 24px;
    font-family: 'DM Sans';
    letter-spacing: 1px;
    line-height: 100%;
    margin: 0 !important;
  }
  
  .card-hover h3 {
    font-size: 24px;
    font-family: 'DM Sans';
    letter-spacing: 1px;
    line-height: 100%;
    margin: 0 !important;
  }
  
  .card-hover p {
    font-size: 16px;
    line-height: 120%;
    letter-spacing: 1px;
    font-family: 'DM Sans';
    padding-bottom: 2px;
  }
}

.hover-card-{{ section.id }} .card-front,
.hover-card-{{ section.id }} .card-hover {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    height: 100%;
    transition: all 0.35s ease;
}

/* Disable hover on mobile if not enabled */
@media (max-width: 768px) {
  {% unless section.settings.enable_mobile_hover %}
  .hover-card-{{ section.id }} .card-front {
    display: none;
  }
  h3.box-sub-heading {
    font-size: 16px;
    line-height: 22px;
    text-align: left;
    font-family: system-ui;
    font-weight: 400;
}
  .hover-card-{{ section.id }} .card-hover {
    position: relative;
    opacity: 1;
    transform: none;
  }
  .hover-card-{{ section.id }} .hover-card:hover .card-front,
  .hover-card-{{ section.id }} .hover-card:hover .card-hover {
    opacity: 1;
    transform: none;
  }
  {% endunless %}
}
</style>
