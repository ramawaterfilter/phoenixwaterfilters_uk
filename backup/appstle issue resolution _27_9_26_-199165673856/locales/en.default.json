    "ecom-the-phoenix-gravity-6-8-12-product": {
      "textcontent_b9jouuxh7i9_html": "Advanced and sustainable gravity filtration removes <strong>99.99% of contaminants including microplastics</strong> while retaining the nutrients your body needs.",
