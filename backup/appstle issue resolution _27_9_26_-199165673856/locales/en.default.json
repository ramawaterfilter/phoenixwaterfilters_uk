      "added_cart_message_q0w89xz74i_html": "Added to cart",
      "item_title_0_bpk84cf9n7w_html": "What’s in the box?",
      "item_title_1_bpk84cf9n7w_html": "Key Features",
      "item_title_2_bpk84cf9n7w_html": "Shipping and Returns",
      "textcontent_5vofoqaxgw4_html": "<ul><li>1 x 304-grade Stainless Steel housing unit\n</li><li>1 x 304-grade Stainless Steel tap\n</li><li>2 x Smart Carbon cartridges</li></ul>",
      "headingtext_a6trs2n2jv_html": "Optional extras:",
