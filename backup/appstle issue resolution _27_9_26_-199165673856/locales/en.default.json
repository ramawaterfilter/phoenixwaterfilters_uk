    "ecom-black-friday-template-product": {
      "textcontent_b5qzw27d80q_html": "<p>Advanced and sustainable gravity water filter. Removes up to 99.9% of contaminants including microplastics, bacteria, heavy metals &amp; PFAS. Retains 100% of minerals.</p>",
