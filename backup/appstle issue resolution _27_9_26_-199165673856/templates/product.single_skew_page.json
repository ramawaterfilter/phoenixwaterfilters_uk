            "product_metafield_key": "",
            "image_metafield_key": "",
            "c1": "<div class=\"labreport-accordion\">\n  <div class=\"labreport-grid\">\n\n    <!-- PFOA / PFOS REPORT -->\n    <div class=\"labreport-item\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0735/1821/9557/files/9419215_2.avif?v=1770698721\"\n        alt=\"PFOA and PFOS filtration laboratory test report\"\n        width=\"60\"\n        height=\"60\"\n        loading=\"lazy\"\n      >\n\n      <h4>PFOA &amp; PFOS LABORATORY TEST REPORT</h4>\n\n      <a\n        href=\"https://cdn.shopify.com/s/files/1/0735/1821/9557/files/Phoenix_Gravity__Filtration_Performance__Contaminants_Lab_Reports_August_2024.pdf\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n        aria-label=\"View the PFOA and PFOS laboratory test report\"\n      >\n        See report &gt;\n      </a>\n    </div>\n\n    <!-- NSF CERTIFICATION -->\n    <div class=\"labreport-item\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0735/1821/9557/files/nsf-01.png?v=1770698720\"\n        alt=\"\"\n        width=\"60\"\n        height=\"60\"\n        loading=\"lazy\"\n      >\n\n      <h4>NSF/ANSI 42 & 372</h4>\n\n      <a\n        href=\"https://info.nsf.org/Certified/DWTU/Listings.asp?CompanyName=rama\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n        aria-label=\"View RAMA Pure Water's official NSF ANSI 42 product listing\"\n      >\n        See report &gt;\n      </a>\n    </div>\n\n    <!-- HEAVY METALS REPORT -->\n    <div class=\"labreport-item\">\n      <img\n        src=\"https://cdn.shopify.com/s/files/1/0735/1821/9557/files/9402263_3.avif?v=1770698720\"\n        alt=\"Heavy metals filtration laboratory test report\"\n        width=\"60\"\n        height=\"60\"\n        loading=\"lazy\"\n      >\n\n      <h4>HEAVY METALS LABORATORY TEST REPORT</h4>\n\n      <a\n        href=\"https://cdn.shopify.com/s/files/1/2644/2852/files/Phoenix_gravity_contaminants_lab_report_USA_Aug2024_2.pdf\"\n        target=\"_blank\"\n        rel=\"noopener noreferrer\"\n        aria-label=\"View the heavy metals laboratory test report\"\n      >\n        See report &gt;\n      </a>\n    </div>\n\n  </div>\n</div>\n\n<style>\n  .labreport-grid {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 40px;\n    text-align: center;\n  }\n\n  .labreport-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n  }\n\n  .labreport-item img {\n    display: block;\n    width: 60px;\n    height: 60px;\n    margin-bottom: 12px;\n    object-fit: contain;\n  }\n\n  .labreport-item h4 {\n    margin: 0;\n    font-size: 15px;\n    line-height: 1.4;\n    letter-spacing: 0.5px;\n  }\n\n  .labreport-description {\n    max-width: 280px;\n    margin: 8px auto 0;\n    font-size: 13px;\n    line-height: 1.5;\n  }\n\n  .labreport-item a {\n    display: inline-block;\n    margin-top: 8px;\n    color: #00a0ff;\n    font-weight: 600;\n    text-decoration: none;\n  }\n\n  .labreport-item a:hover,\n  .labreport-item a:focus-visible {\n    color: #00a0ff;\n    text-decoration: underline;\n  }\n\n  @media screen and (max-width: 749px) {\n    .labreport-grid {\n      grid-template-columns: 1fr;\n      gap: 30px;\n    }\n  }\n</style>",
            "page": ""
