
{% assign ai_gen_id = section.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-marquee-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: {{ section.settings.desktop_padding }}px 0;
    background-color: {{ section.settings.background_color }};
  }

  {
    background-color: {{ section.settings.background_color }}
  }

  .ai-feature-marquee__header-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ section.settings.desktop_header_margin }}px;
  }

  .ai-feature-marquee__heading-{{ ai_gen_id }} {
    margin: 0;
    font-size: {{ section.settings.desktop_heading_size }}px;
    font-weight: 700;
    color: {{ section.settings.heading_color }};
    display: inline-block;
    position: relative;
    padding-bottom: {{ section.settings.desktop_line_spacing }}px;
  }

  {% if section.settings.show_line %}
    .ai-feature-marquee__heading-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: {{ section.settings.desktop_line_width }}px;
      height: {{ section.settings.line_height }}px;
      background-color: {{ section.settings.line_color }};
      border-radius: 2px;
    }
  {% endif %}

  .ai-feature-marquee__track-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-feature-marquee__track-wrapper-{{ ai_gen_id }}::before,
  .ai-feature-marquee__track-wrapper-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .ai-feature-marquee__track-wrapper-{{ ai_gen_id }}::before {
    left: 0;
    background: linear-gradient(to right, {{ section.settings.background_color }}, transparent);
  }

  .ai-feature-marquee__track-wrapper-{{ ai_gen_id }}::after {
    right: 0;
    background: linear-gradient(to left, {{ section.settings.background_color }}, transparent);
  }

  .ai-feature-marquee__track-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    gap: 0;
    width: max-content;
    will-change: transform;
  }

  .ai-feature-marquee__content-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: nowrap;
    flex: 0 0 auto;
    gap: 0;
  }

  .ai-feature-marquee__item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: {{ section.settings.desktop_item_padding }}px {{ section.settings.desktop_item_horizontal_padding }}px;
    gap: {{ section.settings.desktop_item_gap }}px;
    white-space: nowrap;
  }

  .ai-feature-marquee__icon-container-{{ ai_gen_id }} {
    width: {{ section.settings.desktop_icon_size }}px;
    height: {{ section.settings.desktop_icon_size }}px;
    border-radius: 50%;
    background-color: {{ section.settings.icon_background }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: {{ section.settings.desktop_icon_padding }}px;
  }

  .ai-feature-marquee__icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-marquee__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.icon_background }};
    border-radius: 50%;
  }

  .ai-feature-marquee__icon-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-feature-marquee__title-{{ ai_gen_id }} {
    font-size: {{ section.settings.desktop_title_size }}px;
    font-weight: 700;
    color: {{ section.settings.title_color }};
    margin: 0;
    white-space: nowrap;
  }

  .ai-feature-marquee__percentage-{{ ai_gen_id }} {
    font-size: {{ section.settings.desktop_percentage_size }}px;
    font-weight: 400;
    color: {{ section.settings.percentage_color }};
    margin: 0;
    white-space: nowrap;
  }

  @media screen and (max-width: 749px) {
    .ai-feature-marquee-{{ ai_gen_id }} {
      padding: {{ section.settings.mobile_padding }}px 0;
    }

    .ai-feature-marquee__header-{{ ai_gen_id }} {
      margin: 0 0 {{ section.settings.mobile_header_margin }}px;
    }

    .ai-feature-marquee__heading-{{ ai_gen_id }} {
      font-size: {{ section.settings.mobile_heading_size }}px;
      padding-bottom: {{ section.settings.mobile_line_spacing }}px;
    }

    {% if section.settings.show_line %}
      .ai-feature-marquee__heading-{{ ai_gen_id }}::after {
        width: {{ section.settings.mobile_line_width }}px;
        height: {{ section.settings.line_height }}px;
      }
    {% endif %}

    .ai-feature-marquee__item-{{ ai_gen_id }} {
      padding: {{ section.settings.mobile_item_padding }}px {{ section.settings.mobile_item_horizontal_padding }}px;
      gap: {{ section.settings.mobile_item_gap }}px;
    }

    .ai-feature-marquee__icon-container-{{ ai_gen_id }} {
      width: {{ section.settings.mobile_icon_size }}px;
      height: {{ section.settings.mobile_icon_size }}px;
      padding: {{ section.settings.mobile_icon_padding }}px;
    }

    .ai-feature-marquee__title-{{ ai_gen_id }} {
      font-size: {{ section.settings.mobile_title_size }}px;
    }

    .ai-feature-marquee__percentage-{{ ai_gen_id }} {
      font-size: {{ section.settings.mobile_percentage_size }}px;
    }

    .ai-feature-marquee__track-wrapper-{{ ai_gen_id }}::before,
    .ai-feature-marquee__track-wrapper-{{ ai_gen_id }}::after {
      width: 50px;
    }
  }
{% endstyle %}

<feature-marquee-{{ ai_gen_id }} class="ai-feature-marquee-{{ ai_gen_id }}">
  <div class="ai-feature-marquee__header-{{ ai_gen_id }}">
    {% if section.settings.heading != blank %}
      <h2 class="ai-feature-marquee__heading-{{ ai_gen_id }}">{{ section.settings.heading }}</h2>
    {% endif %}
  </div>

  <div class="ai-feature-marquee__track-wrapper-{{ ai_gen_id }}">
    <div class="ai-feature-marquee__track-{{ ai_gen_id }}" data-speed="{{ section.settings.scroll_speed }}">
      <div class="ai-feature-marquee__content-{{ ai_gen_id }}">
        {% for block in section.blocks %}
          {% liquid
            assign icon = block.settings.icon
            assign title = block.settings.title
            assign percentage = block.settings.percentage
            assign link = block.settings.link
            assign icon_class = 'ai-feature-marquee__icon-' | append: ai_gen_id
          %}

          {% if title != blank or percentage != blank or icon != blank %}
            <div
              class="ai-feature-marquee__item-{{ ai_gen_id }}"
              {% if link != blank %}data-link="{{ link }}"{% endif %}
              {{ block.shopify_attributes }}
            >
              <div class="ai-feature-marquee__icon-container-{{ ai_gen_id }}">
                {% if icon != blank %}
                  {{
                    icon
                    | image_url: width: 400
                    | image_tag:
                      class: icon_class,
                      alt: title,
                      loading: 'lazy',
                      widths: '100, 200, 300, 400'
                  }}
                {% endif %}
              </div>

              {% if title != blank %}
                <h3 class="ai-feature-marquee__title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}

              {% if percentage != blank %}
                <p class="ai-feature-marquee__percentage-{{ ai_gen_id }}">{{ percentage }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</feature-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    const elementName = 'feature-marquee-{{ ai_gen_id }}';

    if (customElements.get(elementName)) return;

    class FeatureMarquee extends HTMLElement {
      constructor() {
        super();
        this.wrapper = this.querySelector('.ai-feature-marquee__track-wrapper-{{ ai_gen_id }}');
        this.track = this.querySelector('.ai-feature-marquee__track-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-feature-marquee__content-{{ ai_gen_id }}');
        this.speed = parseFloat(this.track?.dataset.speed) || 50;
        this.animationId = null;
        this.position = 0;
        this.contentWidth = 0;
        this.lastTimestamp = null;
        this.resizeObserver = new ResizeObserver(() => this.setupMarquee());
        this.resizeHandler = () => this.handleResize();
        this.clickHandler = (event) => this.handleClick(event);
        this.mouseEnterHandler = () => this.pauseAnimation();
        this.mouseLeaveHandler = () => this.startAnimation();
      }

      connectedCallback() {
        if (!this.wrapper || !this.track || !this.content) return;

        this.addEventListener('click', this.clickHandler);

        if ({{ section.settings.pause_on_hover | json }}) {
          this.addEventListener('mouseenter', this.mouseEnterHandler);
          this.addEventListener('mouseleave', this.mouseLeaveHandler);
        }

        window.addEventListener('resize', this.resizeHandler);
        this.resizeObserver.observe(this.wrapper);
        this.resizeObserver.observe(this.content);

        requestAnimationFrame(() => {
          this.setupMarquee();
          this.startAnimation();
        });

        if (document.fonts?.ready) {
          document.fonts.ready.then(() => this.setupMarquee());
        }
      }

      handleClick(event) {
        const item = event.target.closest('.ai-feature-marquee__item-{{ ai_gen_id }}');
        if (!item || event.target.closest('a')) return;

        const link = item.dataset.link;
        if (link) window.location.href = link;
      }

      setupMarquee() {
        this.track.querySelectorAll('[data-marquee-clone]').forEach((clone) => clone.remove());
        this.contentWidth = this.content.getBoundingClientRect().width;

        if (this.contentWidth <= 0) return;

        const requiredWidth = this.wrapper.clientWidth + this.contentWidth;

        do {
          const clone = this.content.cloneNode(true);
          clone.dataset.marqueeClone = '';
          clone.setAttribute('aria-hidden', 'true');
          clone.querySelectorAll('[data-shopify-editor-block]').forEach((element) => {
            element.removeAttribute('data-shopify-editor-block');
          });
          this.track.appendChild(clone);
        } while (this.track.scrollWidth < requiredWidth);

        this.position %= this.contentWidth;
        this.track.style.transform = `translate3d(${this.position}px, 0, 0)`;
      }

      handleResize() {
        this.setupMarquee();
      }

      startAnimation() {
        if (this.animationId || this.contentWidth <= 0) return;

        this.lastTimestamp = null;

        const animate = (timestamp) => {
          if (this.lastTimestamp !== null) {
            const elapsedSeconds = Math.min((timestamp - this.lastTimestamp) / 1000, 0.1);
            this.position -= this.speed * elapsedSeconds;

            if (Math.abs(this.position) >= this.contentWidth) {
              this.position += this.contentWidth;
            }

            this.track.style.transform = `translate3d(${this.position}px, 0, 0)`;
          }

          this.lastTimestamp = timestamp;
          this.animationId = requestAnimationFrame(animate);
        };

        this.animationId = requestAnimationFrame(animate);
      }

      pauseAnimation() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
          this.animationId = null;
          this.lastTimestamp = null;
        }
      }

      disconnectedCallback() {
        this.pauseAnimation();
        this.removeEventListener('click', this.clickHandler);
        this.removeEventListener('mouseenter', this.mouseEnterHandler);
        this.removeEventListener('mouseleave', this.mouseLeaveHandler);
        window.removeEventListener('resize', this.resizeHandler);
        this.resizeObserver.disconnect();
      }
    }

    customElements.define(elementName, FeatureMarquee);
  })();
</script>

