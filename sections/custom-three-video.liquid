{% liquid
  assign sid = section.id
%}

<style>
  .video-features-{{ sid }} {
    background: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_desktop }}px 0;
  }

  .video-features-{{ sid }} .container {
    max-width: {{ section.settings.container_width }}px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.gap }}px;
    text-align: center;
  }

  .video-card video,
  .video-card img {
    width: 100%;
    border-radius: {{ section.settings.media_radius }}px;
  }

  .video-card h3 {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_size_desktop }}px;
    margin: 16px 0 8px;
    font-weight: 700;
  }

  .video-card p {
    color: {{ section.settings.text_color }};
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.6;
  }

  @media (max-width: 768px) {
    .video-features-{{ sid }} {
      padding: {{ section.settings.padding_mobile }}px 0;
    }

    .video-features-{{ sid }} .container {
      grid-template-columns: 1fr;
    }

    .video-card h3 {
      font-size: {{ section.settings.heading_size_mobile }}px;
    }

    .video-card p {
      font-size: {{ section.settings.text_size_mobile }}px;
    }
  }
</style>

<section class="video-features-{{ sid }}">
  <div class="container">
    {% for block in section.blocks %}
      <div class="video-card" {{ block.shopify_attributes }}>
        
        {% if block.settings.video != blank %}
          <video autoplay muted loop playsinline>
            <source src="{{ block.settings.video }}" type="video/mp4">
          </video>
        {% elsif block.settings.image != blank %}
          <img src="{{ block.settings.image | img_url: 'master' }}" alt="">
        {% endif %}

        <h3>{{ block.settings.heading }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Dynamic Video Features",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container Width",
      "min": 900,
      "max": 1600,
      "step": 50,
      "default": 1200
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column Gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "media_radius",
      "label": "Video/Image Radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_desktop",
      "label": "Padding Desktop",
      "min": 20,
      "max": 120,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_mobile",
      "label": "Padding Mobile",
      "min": 20,
      "max": 80,
      "step": 10,
      "default": 50
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#2a245e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#4b4b4b"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Size Desktop",
      "min": 18,
      "max": 40,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size Mobile",
      "min": 16,
      "max": 32,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Text Size Desktop",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Text Size Mobile",
      "min": 12,
      "max": 20,
      "step": 1,
      "default": 15
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Video Feature",
      "settings": [
        {
          "type": "url",
          "id": "video",
          "label": "MP4 Video URL"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "304-grade stainless steel"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Naturally BPA-free and rust-resistant."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Dynamic Video Features",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
