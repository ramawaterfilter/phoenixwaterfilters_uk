  <script>
    (() => {
      const section = document.querySelector('#help-center-rebuild-{{ section.id }}');
      if (!section) return;

      const searchForm = section.querySelector('.hc-search');

      if (searchForm) {
        searchForm.addEventListener('submit', function(event) {
          const input = searchForm.querySelector('input[name="q"]');
          const value = input ? input.value.trim() : '';

          if (!value) {
            event.preventDefault();
            if (input) input.focus();
            return;
          }

          input.value = value;
        });
      }
    })();
  </script>
