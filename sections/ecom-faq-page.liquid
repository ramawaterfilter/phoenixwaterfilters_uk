<script>
function toggleAccordion(button) {
 const content = button.nextElementSibling;
 const icon = button.querySelector('.accordion-icon');
 const isOpen = content.style.display === 'block';

 // Close all accordions
 const allContents = document.querySelectorAll('.accordion-content');
 const allIcons = document.querySelectorAll('.accordion-icon');
 allContents.forEach(c => c.style.display = 'none');
 allIcons.forEach(i => i.innerText = '+');

 // Toggle clicked accordion based on previous state
 if (!isOpen) {
 content.style.display = 'block';
 icon.innerText = '-';
 }
}


 function searchFAQs() {
 const query = document.getElementById('faq-search-bar').value.toLowerCase();
 const categories = document.querySelectorAll('.faq-category');
 let matchesFound = false;

 categories.forEach((category) => {
 const items = category.querySelectorAll('.accordion-item');
 let categoryHasMatches = false;

 items.forEach((item) => {
 const header = item.querySelector('.accordion-header').innerText.toLowerCase();
 const content = item.querySelector('.accordion-content').innerText.toLowerCase();

 if (header.includes(query) || content.includes(query)) {
 item.style.display = 'block';
 categoryHasMatches = true;
 } else {
 item.style.display = 'none';
 }
 });

 if (categoryHasMatches) {
 category.style.display = 'block';
 matchesFound = true;
 } else {
 category.style.display = 'none';
 }
 });

 const noResultsElement = document.querySelector('.no-results');
 if (!matchesFound && query !== '') {
 if (!noResultsElement) {
 const noResultsMessage = document.createElement('p');
 noResultsMessage.className = 'no-results';
 noResultsMessage.innerText = 'No matching results found.';
 document.getElementById('faq-categories').appendChild(noResultsMessage);
 }
 } else {
 if (noResultsElement) {
 noResultsElement.remove();
 }
 }
 }
</script>


